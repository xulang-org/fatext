[Unit]
Description=fatext-server daily log health report

[Service]
Type=oneshot
User=fatext
Group=fatext
EnvironmentFile=-/etc/fatext/fatext.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fatext/logs
ExecStart=/bin/bash -c 'set -euo pipefail; LOG_DIR="${FATEXT_LOG_DIR:-/var/lib/fatext/logs}"; Y=$(date -u -d yesterday +%%Y-%%m-%%d); TMP="${LOG_DIR}/.report-${Y}.txt.tmp"; python3 /opt/fatext/scripts/analyze_logs.py --log-dir "$LOG_DIR" --date "$Y" > "$TMP" && mv -f "$TMP" "${LOG_DIR}/report-${Y}.txt"'
