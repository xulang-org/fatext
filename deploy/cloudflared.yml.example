# Local HTTP backend example. Requires FATEXT_TLS_REQUIRED=0 on a loopback-only
# Fatext process. Set FATEXT_TRUST_PROXY=1 and FATEXT_PROXY_HEADER=cf on fatext-server
# so rate limiting and logs use CF-Connecting-IP instead of 127.0.0.1.
# Production tunnels should verify the Fatext origin over HTTPS.

tunnel: fatext-tunnel
credentials-file: /etc/cloudflared/fatext-tunnel.json

ingress:
  - hostname: fatext.com
    path: ^/internal/
    service: http_status:403
  - hostname: fatext.com
    service: http://127.0.0.1:8080
    originRequest:
      noHappyEyeballs: true
  - service: http_status:404
