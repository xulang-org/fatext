[Unit]
Description=fatext.com server (native TLS 1.3 + HTTP/SSR/SSE)
After=network-online.target
Wants=network-online.target fatext-webhook-signer.socket
After=fatext-webhook-signer.socket
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=fatext
Group=fatext
UMask=0027
Environment=FATEXT_TLS_REQUIRED=1
Environment=FATEXT_PUBLIC_POSTING=invite
Environment=FATEXT_AI_MODERATION_REQUIRED=1
Environment=FATEXT_WEBHOOK_SIGNER_SOCKET=/run/fatext-webhook-signer.sock
EnvironmentFile=/etc/fatext/fatext.env
WorkingDirectory=/opt/fatext
ExecStart=/usr/local/bin/fatext-server
ExecStop=/opt/fatext/deploy/graceful_stop.sh
TimeoutStopSec=15
KillMode=process
Restart=always
RestartSec=3
MemoryMax=2G
TasksMax=8192
OOMPolicy=stop
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fatext
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
