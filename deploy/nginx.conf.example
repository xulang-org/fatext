# Optional Nginx reverse proxy example if you choose not to use fatext-server
# native TLS directly (e.g. sharing port 443 with other services).

upstream fatext_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name fatext.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name fatext.com;

    ssl_certificate /etc/letsencrypt/live/fatext.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fatext.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    location /v1/stream {
        proxy_pass http://fatext_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://fatext_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
