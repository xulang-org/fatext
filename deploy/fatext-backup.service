[Unit]
Description=fatext-server daily backup
After=fatext.service

[Service]
Type=oneshot
User=fatext-backup
Group=fatext-backup
SupplementaryGroups=fatext
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/fatext
InaccessiblePaths=-/var/lib/fatext/acme
Environment=FATEXT_BACKUP_SKIP_ACME=1
ExecStart=/opt/fatext/deploy/backup.sh /var/lib/fatext /var/backups/fatext
