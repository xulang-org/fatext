@main

#os
#net
#strconv
#strings
#time
#encoding/json

pub struct LogEntry {
    pub stream string
    pub line string
}

pub struct LogConfig {
    pub log_dir string
    pub retain_days int
    pub slow_ms int
    pub metrics_interval_sec int
    pub stdout_mirror bool
    pub trust_proxy bool
}

pub struct MetricsState {
    pub started_at int
    pub window_start int
    pub peak_sse int

    pub req_total int
    pub req_2xx int
    pub req_4xx int
    pub req_5xx int
    pub req_429 int
    pub bytes_in int
    pub bytes_out int

    pub tls_ok int
    pub tls_fail int
    pub sse_opened int
    pub sse_closed int
    pub sse_events_pushed int
    pub sse_dropped_full int

    pub dm_sse int
    pub dm_webhook int
    pub dm_dropped int
    pub room_events int
    pub mail_ingested int
    pub mail_gc_deleted int

    pub slow_requests int
    pub b_le5 int
    pub b_le20 int
    pub b_le100 int
    pub b_le500 int
    pub b_gt500 int
    pub max_total_ms int
    pub max_queue_ms int
    pub max_handle_ms int
}

pub fn new_metrics_state(now int) MetricsState {
    << MetricsState{
        started_at: now, window_start: now, peak_sse: 0,
        req_total: 0, req_2xx: 0, req_4xx: 0, req_5xx: 0, req_429: 0,
        bytes_in: 0, bytes_out: 0,
        tls_ok: 0, tls_fail: 0, sse_opened: 0, sse_closed: 0,
        sse_events_pushed: 0, sse_dropped_full: 0,
        dm_sse: 0, dm_webhook: 0, dm_dropped: 0,
        room_events: 0, mail_ingested: 0, mail_gc_deleted: 0,
        slow_requests: 0, b_le5: 0, b_le20: 0, b_le100: 0, b_le500: 0, b_gt500: 0,
        max_total_ms: 0, max_queue_ms: 0, max_handle_ms: 0
    }
}

pub fn metrics_record_http(m $&MetricsState, status int, req_bytes int, resp_bytes int, queue_ms int, handle_ms int, total_ms int, slow_ms int) {
    m.req_total += 1
    if status >= 200 && status < 300 { m.req_2xx += 1 }
    else if status >= 400 && status < 500 {
        m.req_4xx += 1
        if status == 429 { m.req_429 += 1 }
    } else if status >= 500 {
        m.req_5xx += 1
    }
    m.bytes_in += req_bytes
    m.bytes_out += resp_bytes

    if total_ms <= 5 { m.b_le5 += 1 }
    else if total_ms <= 20 { m.b_le20 += 1 }
    else if total_ms <= 100 { m.b_le100 += 1 }
    else if total_ms <= 500 { m.b_le500 += 1 }
    else { m.b_gt500 += 1 }

    if slow_ms > 0 && total_ms >= slow_ms { m.slow_requests += 1 }
    if total_ms > m.max_total_ms { m.max_total_ms = total_ms }
    if queue_ms > m.max_queue_ms { m.max_queue_ms = queue_ms }
    if handle_ms > m.max_handle_ms { m.max_handle_ms = handle_ms }
}

pub fn log_emit(ch chan string, stream string, line string) {
    tagged := stream + "\t" + line
    select {
        ch <- tagged {}
        else {}
    }
}

pub fn log_event_json(ch chan string, now int, kind string, fields_json string) {
    t_iso := utc_iso_from_unix(now)
    $s := "{\"ts\":" + strconv.itoa(now) + ",\"time\":" + json.quote(&t_iso) + ",\"kind\":" + json.quote(&kind)
    if fields_json.len > 0 {
        s = s + "," + fields_json
    }
    s = s + "}"
    log_emit(ch, "events", s)
}

pub fn metrics_add_into(dst $&MetricsState, src &MetricsState) {
    if src.peak_sse > dst.peak_sse { dst.peak_sse = src.peak_sse }
    dst.req_total += src.req_total
    dst.req_2xx += src.req_2xx
    dst.req_4xx += src.req_4xx
    dst.req_5xx += src.req_5xx
    dst.req_429 += src.req_429
    dst.bytes_in += src.bytes_in
    dst.bytes_out += src.bytes_out
    dst.tls_ok += src.tls_ok
    dst.tls_fail += src.tls_fail
    dst.sse_opened += src.sse_opened
    dst.sse_closed += src.sse_closed
    dst.sse_events_pushed += src.sse_events_pushed
    dst.sse_dropped_full += src.sse_dropped_full
    dst.dm_sse += src.dm_sse
    dst.dm_webhook += src.dm_webhook
    dst.dm_dropped += src.dm_dropped
    dst.room_events += src.room_events
    dst.mail_ingested += src.mail_ingested
    dst.mail_gc_deleted += src.mail_gc_deleted
    dst.slow_requests += src.slow_requests
    dst.b_le5 += src.b_le5
    dst.b_le20 += src.b_le20
    dst.b_le100 += src.b_le100
    dst.b_le500 += src.b_le500
    dst.b_gt500 += src.b_gt500
    if src.max_total_ms > dst.max_total_ms { dst.max_total_ms = src.max_total_ms }
    if src.max_queue_ms > dst.max_queue_ms { dst.max_queue_ms = src.max_queue_ms }
    if src.max_handle_ms > dst.max_handle_ms { dst.max_handle_ms = src.max_handle_ms }
}

pub fn metrics_combined(cum &MetricsState, cur &MetricsState, active_sse int) MetricsState {
    $out := MetricsState{
        started_at: cum.started_at, window_start: cur.window_start, peak_sse: cum.peak_sse,
        req_total: cum.req_total, req_2xx: cum.req_2xx, req_4xx: cum.req_4xx, req_5xx: cum.req_5xx, req_429: cum.req_429,
        bytes_in: cum.bytes_in, bytes_out: cum.bytes_out,
        tls_ok: cum.tls_ok, tls_fail: cum.tls_fail, sse_opened: cum.sse_opened, sse_closed: cum.sse_closed,
        sse_events_pushed: cum.sse_events_pushed, sse_dropped_full: cum.sse_dropped_full,
        dm_sse: cum.dm_sse, dm_webhook: cum.dm_webhook, dm_dropped: cum.dm_dropped,
        room_events: cum.room_events, mail_ingested: cum.mail_ingested, mail_gc_deleted: cum.mail_gc_deleted,
        slow_requests: cum.slow_requests, b_le5: cum.b_le5, b_le20: cum.b_le20, b_le100: cum.b_le100, b_le500: cum.b_le500, b_gt500: cum.b_gt500,
        max_total_ms: cum.max_total_ms, max_queue_ms: cum.max_queue_ms, max_handle_ms: cum.max_handle_ms
    }
    metrics_add_into($&out, cur)
    if active_sse > out.peak_sse { out.peak_sse = active_sse }
    << out
}

pub fn metrics_flush_and_reset(m $&MetricsState, active_sse int, now int, ch chan string) MetricsState {
    $snap := MetricsState{
        started_at: m.started_at, window_start: m.window_start, peak_sse: m.peak_sse,
        req_total: m.req_total, req_2xx: m.req_2xx, req_4xx: m.req_4xx, req_5xx: m.req_5xx, req_429: m.req_429,
        bytes_in: m.bytes_in, bytes_out: m.bytes_out,
        tls_ok: m.tls_ok, tls_fail: m.tls_fail, sse_opened: m.sse_opened, sse_closed: m.sse_closed,
        sse_events_pushed: m.sse_events_pushed, sse_dropped_full: m.sse_dropped_full,
        dm_sse: m.dm_sse, dm_webhook: m.dm_webhook, dm_dropped: m.dm_dropped,
        room_events: m.room_events, mail_ingested: m.mail_ingested, mail_gc_deleted: m.mail_gc_deleted,
        slow_requests: m.slow_requests, b_le5: m.b_le5, b_le20: m.b_le20, b_le100: m.b_le100, b_le500: m.b_le500, b_gt500: m.b_gt500,
        max_total_ms: m.max_total_ms, max_queue_ms: m.max_queue_ms, max_handle_ms: m.max_handle_ms
    }
    if active_sse > snap.peak_sse { snap.peak_sse = active_sse }
    t_iso := utc_iso_from_unix(now)
    win_sec := now - m.window_start
    uptime := now - m.started_at
    line := "{\"ts\":" + strconv.itoa(now) +
        ",\"time\":" + json.quote(&t_iso) +
        ",\"window_sec\":" + strconv.itoa(win_sec) +
        ",\"uptime_sec\":" + strconv.itoa(uptime) +
        ",\"req_total\":" + strconv.itoa(m.req_total) +
        ",\"req_2xx\":" + strconv.itoa(m.req_2xx) +
        ",\"req_4xx\":" + strconv.itoa(m.req_4xx) +
        ",\"req_5xx\":" + strconv.itoa(m.req_5xx) +
        ",\"req_429\":" + strconv.itoa(m.req_429) +
        ",\"bytes_in\":" + strconv.itoa(m.bytes_in) +
        ",\"bytes_out\":" + strconv.itoa(m.bytes_out) +
        ",\"tls_ok\":" + strconv.itoa(m.tls_ok) +
        ",\"tls_fail\":" + strconv.itoa(m.tls_fail) +
        ",\"active_sse\":" + strconv.itoa(active_sse) +
        ",\"peak_sse\":" + strconv.itoa(m.peak_sse) +
        ",\"sse_opened\":" + strconv.itoa(m.sse_opened) +
        ",\"sse_closed\":" + strconv.itoa(m.sse_closed) +
        ",\"sse_events_pushed\":" + strconv.itoa(m.sse_events_pushed) +
        ",\"sse_dropped_full\":" + strconv.itoa(m.sse_dropped_full) +
        ",\"dm_sse\":" + strconv.itoa(m.dm_sse) +
        ",\"dm_webhook\":" + strconv.itoa(m.dm_webhook) +
        ",\"dm_dropped\":" + strconv.itoa(m.dm_dropped) +
        ",\"room_events\":" + strconv.itoa(m.room_events) +
        ",\"mail_ingested\":" + strconv.itoa(m.mail_ingested) +
        ",\"mail_gc_deleted\":" + strconv.itoa(m.mail_gc_deleted) +
        ",\"slow_requests\":" + strconv.itoa(m.slow_requests) +
        ",\"latency_buckets\":{\"le_5ms\":" + strconv.itoa(m.b_le5) +
        ",\"le_20ms\":" + strconv.itoa(m.b_le20) +
        ",\"le_100ms\":" + strconv.itoa(m.b_le100) +
        ",\"le_500ms\":" + strconv.itoa(m.b_le500) +
        ",\"gt_500ms\":" + strconv.itoa(m.b_gt500) + "}" +
        ",\"max_total_ms\":" + strconv.itoa(m.max_total_ms) +
        ",\"max_queue_ms\":" + strconv.itoa(m.max_queue_ms) +
        ",\"max_handle_ms\":" + strconv.itoa(m.max_handle_ms) + "}"
    log_emit(ch, "metrics", line)

    m.window_start = now
    m.peak_sse = active_sse
    m.req_total = 0
    m.req_2xx = 0
    m.req_4xx = 0
    m.req_5xx = 0
    m.req_429 = 0
    m.bytes_in = 0
    m.bytes_out = 0
    m.tls_ok = 0
    m.tls_fail = 0
    m.sse_opened = 0
    m.sse_closed = 0
    m.sse_events_pushed = 0
    m.sse_dropped_full = 0
    m.dm_sse = 0
    m.dm_webhook = 0
    m.dm_dropped = 0
    m.room_events = 0
    m.mail_ingested = 0
    m.mail_gc_deleted = 0
    m.slow_requests = 0
    m.b_le5 = 0
    m.b_le20 = 0
    m.b_le100 = 0
    m.b_le500 = 0
    m.b_gt500 = 0
    m.max_total_ms = 0
    m.max_queue_ms = 0
    m.max_handle_ms = 0
    << snap
}

fn is_rotated_log_filename(fname string) int {
    // Returns prefix length if matching access|events|metrics-YYYY-MM-DD.jsonl, else -1
    if !strings.has_suffix(&fname, ".jsonl") { << -1 }
    if fname.len == 23 && strings.has_prefix(&fname, "access-") { << 7 }
    if fname.len == 23 && strings.has_prefix(&fname, "events-") { << 7 }
    if fname.len == 24 && strings.has_prefix(&fname, "metrics-") { << 8 }
    << -1
}

fn cleanup_old_logs(log_dir string, today string, retain_days int) {
    if log_dir.len == 0 || retain_days <= 0 { << }
    cutoff := shift_utc_date(today + "", 0 - retain_days)
    raw := os.read_dir(log_dir + "") or (err) { << }
    lines := strings.split(&raw, "\n")
    for i in 0:lines.len {
        fn_s := strings.trim_space(&lines[i])
        pref := is_rotated_log_filename(fn_s + "")
        if pref <= 0 { -> }
        dt_part := fn_s[pref:(pref + 10)]
        if is_valid_date(dt_part + "") && strings.compare(&dt_part, &cutoff) < 0 {
            _ := os.remove(log_dir + "/" + fn_s) or (err) { -> }
        }
    }
}

pub const LOG_CTRL_FLUSH = "__FATEXT_LOG_FLUSH__"

struct DailyLogFiles {
    acc os.File
    ev os.File
    met os.File
}

fn open_daily_log_files(log_dir string, date string) DailyLogFiles {
    $acc := os.open_append(log_dir + "/access-" + date + ".jsonl") or >>
    $ev := os.open_append(log_dir + "/events-" + date + ".jsonl") or (err) {
        close_file_quiet($&acc)
        >> err
    }
    $met := os.open_append(log_dir + "/metrics-" + date + ".jsonl") or (err) {
        close_file_quiet($&acc)
        close_file_quiet($&ev)
        >> err
    }
    << DailyLogFiles{acc: acc, ev: ev, met: met}
}

fn close_daily_log_files(logs $&DailyLogFiles) {
    close_file_quiet($&logs.acc)
    close_file_quiet($&logs.ev)
    close_file_quiet($&logs.met)
}

fn reopen_and_write_log(old $&os.File, path string, line string) os.File {
    close_file_quiet(old)
    $nf := os.open_append(path) or >>
    nf.write(line + "\n") or (err) {
        close_file_quiet($&nf)
        >> err
    }
    << nf
}

fn write_daily_log(logs $&DailyLogFiles, log_dir string, date string, stream string, line string) {
    p := log_dir + "/" + stream + "-" + date + ".jsonl"
    if stream == "access" {
        logs.acc.write(line + "\n") or (err) {
            logs.acc = reopen_and_write_log($&logs.acc, p, line) or (e2) {
                append_jsonl_quiet(p, line)
                <<
            }
            <<
        }
        <<
    }
    if stream == "events" {
        logs.ev.write(line + "\n") or (err) {
            logs.ev = reopen_and_write_log($&logs.ev, p, line) or (e2) {
                append_jsonl_quiet(p, line)
                <<
            }
            <<
        }
        <<
    }
    if stream == "metrics" {
        logs.met.write(line + "\n") or (err) {
            logs.met = reopen_and_write_log($&logs.met, p, line) or (e2) {
                append_jsonl_quiet(p, line)
                <<
            }
            <<
        }
        <<
    }
    append_jsonl_quiet(p, line)
}

fn recv_next_log(log_ch chan string, access_ch chan string) string {
    $out := ""
    $got := false
    select {
        tagged := <-log_ch {
            out = tagged
            got = true
        }
        else {}
    }
    if got { << out }
    select {
        tagged := <-log_ch { out = tagged }
        tagged := <-access_ch { out = tagged }
    }
    << out
}

fn logger_loop_fallback(log_dir string, retain_days int, stdout_mirror bool, log_ch chan string, access_ch chan string, flush_done chan int) {
    $last_date := ""
    while true {
        tagged := recv_next_log(log_ch, access_ch)
        if tagged == LOG_CTRL_FLUSH {
            flush_done <- 1
            ->
        }
        tidx := strings.index_of(&tagged, "\t")
        if tidx <= 0 || tidx + 1 >= tagged.len { -> }
        stream := tagged[0:tidx]
        line := tagged[(tidx + 1):tagged.len]
        if log_dir.len > 0 {
            now := time.now_time().unix()
            today := utc_date_from_unix(now)
            if today != last_date {
                last_date = today + ""
                cleanup_old_logs(log_dir + "", today + "", retain_days)
            }
            fpath := log_dir + "/" + stream + "-" + today + ".jsonl"
            append_jsonl_quiet(fpath, line + "")
        }
        if stdout_mirror {
            println("[" + stream + "] " + line)
        }
    }
}

pub fn logger_loop(log_dir string, retain_days int, stdout_mirror bool, log_ch chan string, access_ch chan string, flush_done chan int) {
    if log_dir.len == 0 {
        logger_loop_fallback("", retain_days, stdout_mirror, log_ch, access_ch, flush_done)
        <<
    }
    mkdir_all_quiet(log_dir + "")
    $last_date := utc_date_from_unix(time.now_time().unix())
    cleanup_old_logs(log_dir + "", last_date + "", retain_days)
    $logs := open_daily_log_files(log_dir + "", last_date + "") or (err) {
        logger_loop_fallback(log_dir + "", retain_days, stdout_mirror, log_ch, access_ch, flush_done)
        <<
    }
    while true {
        tagged := recv_next_log(log_ch, access_ch)
        if tagged == LOG_CTRL_FLUSH {
            $extra_flushes := 0
            $more_hi := true
            while more_hi {
                select {
                    hi := <-log_ch {
                        if hi == LOG_CTRL_FLUSH {
                            extra_flushes += 1
                        } else {
                            hi_idx := strings.index_of(&hi, "\t")
                            if hi_idx > 0 && hi_idx + 1 < hi.len {
                                hs := hi[0:hi_idx]
                                hl := hi[(hi_idx + 1):hi.len]
                                write_daily_log($&logs, log_dir + "", last_date + "", hs + "", hl + "")
                                if stdout_mirror { println("[" + hs + "] " + hl) }
                            }
                        }
                    }
                    else { more_hi = false }
                }
            }
            $more_ac := true
            while more_ac {
                select {
                    ac := <-access_ch {
                        ac_idx := strings.index_of(&ac, "\t")
                        if ac_idx > 0 && ac_idx + 1 < ac.len {
                            as_s := ac[0:ac_idx]
                            al := ac[(ac_idx + 1):ac.len]
                            write_daily_log($&logs, log_dir + "", last_date + "", as_s + "", al + "")
                            if stdout_mirror { println("[" + as_s + "] " + al) }
                        }
                    }
                    else { more_ac = false }
                }
            }
            close_daily_log_files($&logs)
            logs = open_daily_log_files(log_dir + "", last_date + "") or (err) {
                flush_done <- 1
                logger_loop_fallback(log_dir + "", retain_days, stdout_mirror, log_ch, access_ch, flush_done)
                <<
            }
            flush_done <- 1
            for _ in 0:extra_flushes {
                flush_done <- 1
            }
            ->
        }
        tidx := strings.index_of(&tagged, "\t")
        if tidx <= 0 || tidx + 1 >= tagged.len { -> }
        stream := tagged[0:tidx]
        line := tagged[(tidx + 1):tagged.len]
        now := time.now_time().unix()
        today := utc_date_from_unix(now)
        if today != last_date {
            close_daily_log_files($&logs)
            last_date = today + ""
            cleanup_old_logs(log_dir + "", today + "", retain_days)
            logs = open_daily_log_files(log_dir + "", last_date + "") or (err) {
                fpath := log_dir + "/" + stream + "-" + today + ".jsonl"
                append_jsonl_quiet(fpath, line + "")
                if stdout_mirror { println("[" + stream + "] " + line) }
                logger_loop_fallback(log_dir + "", retain_days, stdout_mirror, log_ch, access_ch, flush_done)
                <<
            }
        }
        write_daily_log($&logs, log_dir + "", today + "", stream + "", line + "")
        if stdout_mirror {
            println("[" + stream + "] " + line)
        }
    }
}

pub fn extract_err_code(status int, body &string) string {
    if status < 400 || body.len == 0 { << "" }
    doc := json.parse(body)
    if !doc.ok() || !doc.is_dict(doc.root()) || !doc.has(doc.root(), "error") { << "" }
    en := doc.get(doc.root(), "error")
    if !doc.is_dict(en) || !doc.has(en, "code") { << "" }
    << json_str_or(&doc, doc.get(en, "code"), "")
}

pub fn extract_host_from_sockaddr_str(raw string) string {
    s := strings.trim_space(&raw)
    if s.len == 0 { << "127.0.0.1" }
    if (s[0] & 255) == 91 {
        // [ipv6]:port
        rb := strings.index_of(&s, "]")
        if rb > 1 { << s[1:rb] }
    }
    $last_colon := -1
    for i in 0:s.len {
        if (s[i] & 255) == 58 { last_colon = i }
    }
    if last_colon > 0 { << s[0:last_colon] }
    << s
}

pub fn resolve_peer_ip(fd int) string {
    if fd < 0 { << "127.0.0.1" }
    raw := net.socket_remote_addr(fd)
    << extract_host_from_sockaddr_str(raw)
}

pub fn effective_client_ip(peer_ip string, req &HttpReq, trust_proxy bool, proxy_header string) string {
    if !trust_proxy || !is_trusted_proxy_ip(&peer_ip) { << peer_ip + "" }
    mode := strings.to_lower(&strings.trim_space(&proxy_header))
    if mode == "cf" {
        cf := strings.trim_space(&req.header("CF-Connecting-IP"))
        if is_valid_ip_literal(&cf) { << cf }
        << peer_ip + ""
    }
    if mode == "x-real-ip" {
        xri := strings.trim_space(&req.header("X-Real-IP"))
        if is_valid_ip_literal(&xri) { << xri }
        << peer_ip + ""
    }
    if mode != "xff" {
        cf := strings.trim_space(&req.header("CF-Connecting-IP"))
        if is_valid_ip_literal(&cf) { << cf }
        xri := strings.trim_space(&req.header("X-Real-IP"))
        if is_valid_ip_literal(&xri) { << xri }
    }
    xff := strings.trim_space(&req.header_all("X-Forwarded-For"))
    if xff.len == 0 { << peer_ip + "" }
    parts := strings.split(&xff, ",")
    $last_valid := ""
    $idx := parts.len - 1
    while idx >= 0 {
        cand := strings.trim_space(&parts[idx])
        if cand.len > 0 {
            if !is_valid_ip_literal(&cand) {
                if last_valid.len > 0 { << last_valid }
                << peer_ip + ""
            }
            last_valid = cand + ""
            if !is_trusted_proxy_ip(&cand) {
                << cand
            }
        }
        idx -= 1
    }
    if last_valid.len > 0 { << last_valid }
    << peer_ip + ""
}

pub fn normalize_route(raw_path string) string {
    path := path_only(raw_path + "")
    if path == "/" || path == "/dl" || path == "/dl/" || path == "/help" || path == "/health" || path == "/ready" || path == "/internal/shutdown" || path == "/llms.txt" || path == "/llms-full.txt" ||
       path == "/SKILL.md" || path == "/protocol.md" || path == "/.well-known/fatext.json" ||
       path == "/static/fatext.css" || path == "/static/favicon.svg" || path == "/favicon.ico" ||
       path == "/static/logo.svg" || path == "/internal/mail/ingest" || path == "/internal/metrics" || path == "/v1/stats" ||
       path == "/v1/agents/register" || path == "/v1/agents/profile" || path == "/v1/agents/rotate-key" ||
       path == "/v1/agents/revoke" || path == "/v1/agents/docs" || path == "/v1/ctl/agents" ||
       path == "/v1/friends" || path == "/v1/friends/request" || path == "/v1/friends/accept" ||
       path == "/v1/friends/reject" || path == "/v1/blocks" || path == "/v1/mail" || path == "/v1/stream" ||
       path == "/v1/rooms" || path == "/report" || path == "/v1/reports" || path == "/report/status" || path == "/v1/reports/status" ||
       path == "/v1/moderation/notices" || path == "/v1/moderation/review" {
        << path
    }
    if path == "/internal/admin/public-posting" || path == "/internal/admin/moderation/reports" { << path }
    if strings.has_prefix(&path, "/internal/admin/moderation/messages/") { << "/internal/admin/moderation/messages/{thread_id}/{msg_id}" }
    if strings.has_prefix(&path, "/internal/admin/moderation/reports/") { << "/internal/admin/moderation/reports/{date}/{receipt}" }
    if strings.has_prefix(&path, "/internal/admin/moderation/reviews/") { << "/internal/admin/moderation/reviews/{date}/{receipt}" }
    if strings.has_prefix(&path, "/internal/admin/") {
        rest := path[16:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 1 {
            if parts[0] == "stats" || parts[0] == "agents" || parts[0] == "channels" ||
               parts[0] == "pins" || parts[0] == "banned-emails" || parts[0] == "sse" ||
               parts[0] == "rooms" || parts[0] == "config" || parts[0] == "reload" || parts[0] == "events" {
                << path
            }
        } else if parts.len == 2 {
            if parts[0] == "stats" && parts[1] == "history" { << "/internal/admin/stats/history" }
            if parts[0] == "agents" { << "/internal/admin/agents/{id}" }
            if parts[0] == "channels" { << "/internal/admin/channels/{name}" }
            if parts[0] == "pins" { << "/internal/admin/pins/{id}" }
        } else if parts.len == 3 && parts[0] == "agents" {
            if parts[2] == "ban" || parts[2] == "disconnect" {
                << "/internal/admin/agents/{id}/" + parts[2]
            }
        }
        << "/internal/admin/{other}"
    }
    if strings.has_prefix(&path, "/v1/agents/docs/") { << "/v1/agents/docs/{kind}" }
    if strings.has_prefix(&path, "/dl/") { << "/dl/{file}" }
    if strings.has_prefix(&path, "/v1/friends/") { << "/v1/friends/{id}" }
    if strings.has_prefix(&path, "/v1/blocks/") { << "/v1/blocks/{target}" }
    if strings.has_prefix(&path, "/v1/dm/") { << "/v1/dm/{id}" }
    if strings.has_prefix(&path, "/v1/mail/") { << "/v1/mail/{id}" }
    if path == "/v1/rooms/key-boxes" { << path }
    if strings.has_prefix(&path, "/v1/rooms/") {
        rest := path[10:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 1 { << "/v1/rooms/{id}" }
        if parts.len == 2 { << "/v1/rooms/{id}/" + parts[1] }
        if parts.len == 3 && parts[1] == "members" { << "/v1/rooms/{id}/members/{aid}" }
        if parts.len == 3 && parts[1] == "bans" { << "/v1/rooms/{id}/bans/{aid}" }
        if parts.len == 4 && parts[1] == "members" { << "/v1/rooms/{id}/members/{aid}/" + parts[3] }
        << "/v1/rooms/{other}"
    }
    if strings.has_prefix(&path, "/v1/ctl/agents/") {
        rest := path[15:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 {
            << "/v1/ctl/agents/{id}/" + parts[1]
        }
        if parts.len == 3 && parts[1] == "docs" {
            << "/v1/ctl/agents/{id}/docs/{kind}"
        }
        << "/v1/ctl/agents/{other}"
    }
    if strings.has_prefix(&path, "/v1/channels/") {
        if strings.has_suffix(&path, "/pins") { << "/v1/channels/{ch}/pins" }
        if strings.has_suffix(&path, "/posts") { << "/v1/channels/{ch}/posts" }
        << "/v1/channels/{other}"
    }
    if strings.has_prefix(&path, "/v1/threads/") && strings.has_suffix(&path, "/replies") {
        << "/v1/threads/{id}/replies"
    }
    if strings.has_prefix(&path, "/k/") {
        rest := path[3:path.len]
        if strings.contains(&rest, "/") {
            if strings.has_suffix(&rest, "/docs.json") { << "/k/{id}/docs.json" }
            if strings.has_suffix(&rest, "/soul.json") { << "/k/{id}/soul.json" }
            if strings.has_suffix(&rest, "/soul.md") { << "/k/{id}/soul.md" }
            if strings.has_suffix(&rest, "/rules.json") { << "/k/{id}/rules.json" }
            if strings.has_suffix(&rest, "/rules.md") { << "/k/{id}/rules.md" }
        }
        if strings.has_suffix(&path, ".json") { << "/k/{id}.json" }
        if strings.has_suffix(&path, ".pem") { << "/k/{id}.pem" }
    }
    if strings.has_prefix(&path, "/c/") {
        rest := path[3:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 1 { << "/c/{ch}" }
        if parts.len == 2 {
            if strings.has_suffix(&parts[1], ".jsonl") { << "/c/{ch}/{date}.jsonl" }
            if strings.has_suffix(&parts[1], ".sha256") { << "/c/{ch}/{date}.sha256" }
            << "/c/{ch}/{date}"
        }
    }
    if strings.has_prefix(&path, "/t/") {
        if strings.has_suffix(&path, ".jsonl") { << "/t/{id}.jsonl" }
        << "/t/{id}"
    }
    if strings.has_prefix(&path, "/a/") { << "/a/{id}" }
    << "/other"
}

pub fn log_access_json(
    ch chan string,
    slow_ms int,
    now int,
    req_id string,
    method string,
    route string,
    status int,
    err_code string,
    tls_on bool,
    ip string,
    actor_type string,
    actor_id string,
    req_bytes int,
    resp_bytes int,
    tls_ms int,
    read_ms int,
    queue_ms int,
    handle_ms int,
    write_ms int,
    total_ms int,
    total_us int
) {
    t_iso := utc_iso_from_unix(now)
    $tls_s := "false"
    if tls_on { tls_s = "true" }
    $slow_s := "false"
    if slow_ms > 0 && total_ms >= slow_ms { slow_s = "true" }

    line := "{\"ts\":" + strconv.itoa(now) +
        ",\"time\":" + json.quote(&t_iso) +
        ",\"req_id\":" + json.quote(&req_id) +
        ",\"method\":" + json.quote(&method) +
        ",\"route\":" + json.quote(&route) +
        ",\"status\":" + strconv.itoa(status) +
        ",\"err_code\":" + json.quote(&err_code) +
        ",\"tls\":" + tls_s +
        ",\"ip\":" + json.quote(&ip) +
        ",\"actor_type\":" + json.quote(&actor_type) +
        ",\"actor_id\":" + json.quote(&actor_id) +
        ",\"req_bytes\":" + strconv.itoa(req_bytes) +
        ",\"resp_bytes\":" + strconv.itoa(resp_bytes) +
        ",\"tls_ms\":" + strconv.itoa(tls_ms) +
        ",\"read_ms\":" + strconv.itoa(read_ms) +
        ",\"queue_ms\":" + strconv.itoa(queue_ms) +
        ",\"handle_ms\":" + strconv.itoa(handle_ms) +
        ",\"write_ms\":" + strconv.itoa(write_ms) +
        ",\"total_ms\":" + strconv.itoa(total_ms) +
        ",\"total_us\":" + strconv.itoa(total_us) +
        ",\"slow\":" + slow_s + "}"
    log_emit(ch, "access", line)
}
