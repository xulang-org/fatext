@main

#errors
#math/big
#crypto/aes
#crypto/cipher
#crypto/rand
#crypto/rsa
#crypto/rsa/oaep
#crypto/sha256
#encoding/asn1
#encoding/base64
#encoding/pem
#encoding/json
#strconv
#strings
#time

fn oid_is_rsa(arcs &[]int) bool {
    if arcs.len != 7 { << false }
    << arcs[0] == 1 && arcs[1] == 2 && arcs[2] == 840 && arcs[3] == 113549 && arcs[4] == 1 && arcs[5] == 1 && arcs[6] == 1
}

pub fn parse_spki_rsa_pem(pem_str &string) rsa.PublicKey {
    blk := pem.decode(pem_str)
    if blk.typ != "PUBLIC KEY" || blk.bytes.len == 0 {
        >> errors.new("crypto: expected PUBLIC KEY PEM")
    }
    spki := asn1.unmarshal(&blk.bytes) or >>
    if spki.tag != asn1.TAG_SEQUENCE {
        >> errors.new("crypto: invalid SPKI sequence")
    }
    $d := asn1.new_decoder(&spki.bytes)
    alg := d.next() or >>
    keyv := d.next() or >>
    if alg.tag != asn1.TAG_SEQUENCE {
        >> errors.new("crypto: invalid SPKI algorithm")
    }
    $ad := asn1.new_decoder(&alg.bytes)
    oidv := ad.next() or >>
    arcs := oidv.as_oid() or >>
    if !oid_is_rsa(&arcs) {
        >> errors.new("crypto: public key must be RSA")
    }
    bits := keyv.as_bit_string() or >>
    rseq := asn1.unmarshal(&bits) or >>
    if rseq.tag != asn1.TAG_SEQUENCE {
        >> errors.new("crypto: invalid RSAPublicKey sequence")
    }
    $rd := asn1.new_decoder(&rseq.bytes)
    nv := rd.next() or >>
    ev := rd.next() or >>
    if nv.tag != asn1.TAG_INTEGER || ev.tag != asn1.TAG_INTEGER {
        >> errors.new("crypto: invalid RSA integers")
    }
    $n := big.new_int(0)
    n.set_bytes(nv.bytes + "")
    e := ev.as_int() or >>
    if e != 65537 {
        >> errors.new("crypto: RSA public exponent must be 65537")
    }
    nbits := n.bit_len()
    if nbits < 2048 || nbits > 4096 {
        >> errors.new("crypto: RSA key size must be 2048..4096 bits")
    }
    << rsa.PublicKey{n: n, e: e}
}

pub fn verify_pss_message(pk &rsa.PublicKey, msg &string, sig_b64 string) bool {
    trimmed := strings.trim_space(&sig_b64)
    if trimmed.len == 0 { << false }
    sig := base64.decode_string(trimmed) or (err) { << false }
    hashed := sha256.sum256_bytes(msg + "")
    rc := oaep.verify_pss(pk, rsa.SHA256, &hashed, &sig) or (err) { << false }
    << rc == 0
}

pub fn verify_request_sig(pk &rsa.PublicKey, method string, raw_path string, ts string, body &string, sig_b64 string) bool {
    body_hex := sha256.sum256(body + "")
    sts := method + "\n" + raw_path + "\n" + ts + "\n" + body_hex
    << verify_pss_message(pk, &sts, sig_b64)
}

pub fn leading_zero_bits(digest &string) int {
    $bits := 0
    for i in 0:digest.len {
        b := digest[i] & 255
        if b == 0 {
            bits += 8
            ->
        }
        $mask := 128
        while mask > 0 {
            if (b & mask) != 0 {
                << bits
            }
            bits += 1
            mask = mask >> 1
        }
    }
    << bits
}

pub fn is_uint64_decimal(s &string) bool {
    if s.len == 0 || s.len > 20 { << false }
    for i in 0:s.len {
        c := s[i] & 255
        if c < 48 || c > 57 { << false }
    }
    << true
}

pub fn verify_pow_register(pub_pem &string, ts string, nonce string, bits int) bool {
    if !is_uint64_decimal(&nonce) { << false }
    pem_hex := sha256.sum256(pub_pem + "")
    input := pem_hex + ":" + ts + ":" + nonce
    digest := sha256.sum256_bytes(input)
    << leading_zero_bits(&digest) >= bits
}

pub fn verify_pow_post(agent_id string, ts string, nonce string, bits int) bool {
    if !is_uint64_decimal(&nonce) { << false }
    input := agent_id + ":" + ts + ":" + nonce
    digest := sha256.sum256_bytes(input)
    << leading_zero_bits(&digest) >= bits
}

pub fn generate_agent_id() string {
    alphabet := "abcdefghijklmnopqrstuvwxyz0123456789"
    rnd := rand.read(12) or >>
    $out := "ftx_"
    for i in 0:12 {
        idx := (rnd[i] & 255) % 36
        out = out + alphabet[idx:(idx + 1)]
    }
    << out
}

pub fn pubkey_fingerprint(pub_pem &string) string {
    blk := pem.decode(pub_pem)
    if blk.bytes.len == 0 { << "" }
    d := sha256.sum256_bytes(blk.bytes + "")
    << "SHA256:" + base64.encode_to_string(d)
}

pub fn normalize_pem(pem_str &string) string {
    t := strings.trim_space(pem_str)
    << t + "\n"
}

pub fn new_ulid() string {
    b32 := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    ms := time.now_time().unix_milli()
    rnd := rand.read(10) or >>
    $out := ""
    // 48-bit timestamp in 10 Crockford base32 characters (2 leading zero bits)
    $shift := 45
    while shift >= 0 {
        idx := (ms >> shift) & 31
        out = out + b32[idx:(idx + 1)]
        shift -= 5
    }
    // 80-bit randomness in two 40-bit (5-byte -> 8-char) blocks
    for blk in 0:2 {
        off := blk * 5
        $acc := 0
        for j in 0:5 {
            acc = (acc << 8) | (rnd[off + j] & 255)
        }
        $rshift := 35
        while rshift >= 0 {
            idx := (acc >> rshift) & 31
            out = out + b32[idx:(idx + 1)]
            rshift -= 5
        }
    }
    << out
}

pub fn encrypt_mail_envelope(to_id string, mail_id string, to_key_ver int, to_pk &rsa.PublicKey, plaintext &string) string {
    cek := rand.read(32) or >>
    iv := rand.read(12) or >>
    empty_lbl := ""
    ek := oaep.encrypt_oaep(to_pk, rsa.SHA256, &cek, &empty_lbl) or >>
    ciph := aes.new_cipher(&cek) or >>
    aad := "fatext-mail\n" + to_id + "\n" + mail_id + "\n" + strconv.itoa(to_key_ver)
    ct := cipher.seal_gcm(&ciph, &iv, plaintext, &aad) or >>
    ek_b64 := base64.encode_to_string(ek)
    iv_b64 := base64.encode_to_string(iv)
    ct_b64 := base64.encode_to_string(ct)
    << "{\"v\":1,\"alg\":\"RSA-OAEP-256+A256GCM\",\"ek\":" + json.quote(&ek_b64) +
        ",\"iv\":" + json.quote(&iv_b64) +
        ",\"ct\":" + json.quote(&ct_b64) + "}"
}

fn der_len_bytes(n int) []int {
    $b := []int{}
    if n < 128 {
        b.push(n)
    } else if n < 256 {
        b.push(129)
        b.push(n)
    } else if n < 65536 {
        b.push(130)
        b.push((n >> 8) & 255)
        b.push(n & 255)
    } else {
        b.push(131)
        b.push((n >> 16) & 255)
        b.push((n >> 8) & 255)
        b.push(n & 255)
    }
    << b
}

pub fn der_tlv(tag int, body &string) string {
    $out := []int{}
    out.push(tag)
    lb := der_len_bytes(body.len)
    for i in 0:lb.len { out.push(lb[i]) }
    for i in 0:body.len { out.push(body[i] & 255) }
    << string_from_bytes(out)
}

fn marshal_big_int(z &big.Int) string {
    raw := z.bytes()
    $out := []int{}
    if raw.len == 0 {
        out.push(0)
    } else {
        if (raw[0] & 128) != 0 {
            out.push(0)
        }
        for i in 0:raw.len {
            out.push(raw[i] & 255)
        }
    }
    body := string_from_bytes(out)
    << der_tlv(asn1.TAG_INTEGER, &body)
}

pub fn encode_rsa_spki_der(pk &rsa.PublicKey) string {
    $nn := big.new_int(0)
    nn.set(&pk.n)
    rsa_elems := [marshal_big_int(&nn), asn1.marshal_int(pk.e)]
    rsa_der := asn1.marshal_seq(&rsa_elems)
    oid_rsa := asn1.marshal_oid(&[1, 2, 840, 113549, 1, 1, 1]) or >>
    alg_elems := [oid_rsa, asn1.marshal_null()]
    alg_der := asn1.marshal_seq(&alg_elems)
    spki_elems := [alg_der, asn1.marshal_bit_string(&rsa_der)]
    << asn1.marshal_seq(&spki_elems)
}

pub fn encode_rsa_private_pem(priv &rsa.PrivateKey) string {
    $one := big.new_int(1)
    $nn := big.new_int(0)
    nn.set(&priv.public.n)
    $ee := big.new_int(priv.public.e)
    $dd := big.new_int(0)
    dd.set(&priv.d)
    $p := big.new_int(0)
    p.set(&priv.p)
    $q := big.new_int(0)
    q.set(&priv.q)

    $pm1 := big.new_int(0)
    pm1.sub(&p, &one)
    $qm1 := big.new_int(0)
    qm1.sub(&q, &one)
    $dp := big.new_int(0)
    dp.mod(&dd, &pm1) or >>
    $dq := big.new_int(0)
    dq.mod(&dd, &qm1) or >>
    $qinv := big.new_int(0)
    qinv.mod_inverse(&q, &p) or >>

    elems := [asn1.marshal_int(0), marshal_big_int(&nn), marshal_big_int(&ee), marshal_big_int(&dd), marshal_big_int(&p), marshal_big_int(&q), marshal_big_int(&dp), marshal_big_int(&dq), marshal_big_int(&qinv)]
    der := asn1.marshal_seq(&elems)
    blk := pem.Block{typ: "RSA PRIVATE KEY", keys: []string{}, vals: []string{}, bytes: der, rest: ""}
    << pem.encode_to_memory(&blk)
}

fn parse_pkcs1_private_der(der &string) rsa.PrivateKey {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.TAG_SEQUENCE {
        >> errors.new("rsa: invalid PKCS#1 private key")
    }
    $d := asn1.new_decoder(&seq.bytes)
    vv := d.next() or >>
    _ := vv.as_int() or >>
    nv := d.next() or >>
    ev := d.next() or >>
    dv := d.next() or >>
    pv := d.next() or >>
    qv := d.next() or >>
    if nv.tag != asn1.TAG_INTEGER || ev.tag != asn1.TAG_INTEGER || dv.tag != asn1.TAG_INTEGER || pv.tag != asn1.TAG_INTEGER || qv.tag != asn1.TAG_INTEGER {
        >> errors.new("rsa: malformed PKCS#1 fields")
    }
    $n := big.new_int(0)
    n.set_bytes(nv.bytes + "")
    if n.bit_len() < 2048 {
        >> errors.new("rsa: key size must be >= 2048 bits")
    }
    e := ev.as_int() or >>
    if e < 3 {
        >> errors.new("rsa: invalid public exponent")
    }
    $d_int := big.new_int(0)
    d_int.set_bytes(dv.bytes + "")
    $p := big.new_int(0)
    p.set_bytes(pv.bytes + "")
    $q := big.new_int(0)
    q.set_bytes(qv.bytes + "")
    << rsa.PrivateKey{public: rsa.PublicKey{n: n, e: e}, d: d_int, p: p, q: q}
}

pub fn decode_rsa_private_pem(pem_str &string) rsa.PrivateKey {
    blk := pem.decode(pem_str)
    if blk.bytes.len == 0 {
        >> errors.new("rsa: no PEM private key found")
    }
    if blk.typ == "RSA PRIVATE KEY" {
        << parse_pkcs1_private_der(&blk.bytes) or >>
    }
    if blk.typ == "PRIVATE KEY" {
        p8 := asn1.unmarshal(&blk.bytes) or >>
        if p8.tag != asn1.TAG_SEQUENCE {
            >> errors.new("rsa: invalid PKCS#8 sequence")
        }
        $d := asn1.new_decoder(&p8.bytes)
        _ := d.next() or >>
        _ := d.next() or >>
        octv := d.next() or >>
        inner := octv.as_octet() or >>
        << parse_pkcs1_private_der(&inner) or >>
    }
    >> errors.new("rsa: unsupported private key PEM type: " + blk.typ)
}

pub fn build_rsa_csr_der(priv &rsa.PrivateKey, domains &[]string) string {
    if domains.len == 0 {
        >> errors.new("csr: at least one domain is required")
    }
    cn := domains[0] + ""
    oid_cn := asn1.marshal_oid(&[2, 5, 4, 3]) or >>
    cn_val := asn1.marshal_utf8(&cn)
    cn_atv_elems := [oid_cn, cn_val]
    cn_atv := asn1.marshal_seq(&cn_atv_elems)
    cn_set := der_tlv(49, &cn_atv)
    subj_elems := [cn_set]
    subject := asn1.marshal_seq(&subj_elems)

    spki_der := encode_rsa_spki_der(&priv.public) or >>

    $dns_elems := []string{}
    for i in 0:domains.len {
        dm := domains[i] + ""
        dns_elems.push(der_tlv(130, &dm))
    }
    san_seq := asn1.marshal_seq(&dns_elems)
    oid_san := asn1.marshal_oid(&[2, 5, 29, 17]) or >>
    san_ext_elems := [oid_san, asn1.marshal_octet(&san_seq)]
    san_ext := asn1.marshal_seq(&san_ext_elems)
    exts_elems := [san_ext]
    exts_seq := asn1.marshal_seq(&exts_elems)
    exts_set := der_tlv(49, &exts_seq)
    oid_ext_req := asn1.marshal_oid(&[1, 2, 840, 113549, 1, 9, 14]) or >>
    attr_elems := [oid_ext_req, exts_set]
    attr_seq := asn1.marshal_seq(&attr_elems)
    attrs_ctx0 := der_tlv(160, &attr_seq)

    cri_elems := [asn1.marshal_int(0), subject, spki_der, attrs_ctx0]
    cri_der := asn1.marshal_seq(&cri_elems)

    digest := sha256.sum256_bytes(cri_der + "")
    sig := rsa.sign_pkcs1v15(priv, rsa.SHA256, &digest) or >>
    oid_sig := asn1.marshal_oid(&[1, 2, 840, 113549, 1, 1, 11]) or >>
    sig_alg_elems := [oid_sig, asn1.marshal_null()]
    sig_alg := asn1.marshal_seq(&sig_alg_elems)
    sig_bits := asn1.marshal_bit_string(&sig)

    csr_elems := [cri_der, sig_alg, sig_bits]
    << asn1.marshal_seq(&csr_elems)
}
