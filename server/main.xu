@main

core #runtime/core
#net
#maps
#os
#os/signal
#strconv
#strings
#time
#encoding/json

fn getenv_or(key string, fallback string) string {
    v := os.getenv(key)
    if v.len > 0 { << v }
    << fallback
}

fn getenv_int_or(key string, fallback int) int {
    v := os.getenv(key)
    if v.len == 0 { << fallback }
    $n := 0
    for i in 0:v.len {
        c := v[i] & 255
        if c < 48 || c > 57 { << fallback }
        n = n * 10 + (c - 48)
    }
    << n
}

fn close_raw_fd_quiet(fd int) {
    if fd >= 0 {
        _ := net.conn_close(fd) or (err) { << }
    }
}

fn empty_req() HttpReq {
    << HttpReq{req_method: "", req_path: "", hdr_names: []string{}, hdr_vals: []string{}, req_body: "", remote_ip: "", peer_ip: ""}
}

pub struct ConnGateMsg {
    pub acquire bool
    pub ip string
    pub reply_ch chan bool
}

fn conn_guard_loop(max_conns int, max_per_ip int, ch chan ConnGateMsg) {
    $total := 0
    $by_ip := maps.new_str_int()
    while true {
        msg := <-ch
        if msg.acquire {
            $ok := true
            if max_conns > 0 && total >= max_conns { ok = false }
            cur := map_get_or(&by_ip, msg.ip + "", 0)
            if max_per_ip > 0 && cur >= max_per_ip { ok = false }
            if ok {
                total += 1
                by_ip.set(msg.ip + "", cur + 1)
            }
            msg.reply_ch <- ok
        } else {
            if total > 0 { total -= 1 }
            cur := map_get_or(&by_ip, msg.ip + "", 0)
            if cur <= 1 {
                by_ip.del(msg.ip + "")
            } else {
                by_ip.set(msg.ip + "", cur - 1)
            }
        }
    }
}

fn acquire_conn_slot(ch chan ConnGateMsg, ip string) bool {
    rc := chan bool{cap: 1}
    ch <- ConnGateMsg{acquire: true, ip: ip + "", reply_ch: rc}
    << <-rc
}

fn release_conn_slot(ch chan ConnGateMsg, ip string) {
    ch <- ConnGateMsg{acquire: false, ip: ip + "", reply_ch: chan bool{cap: 1}}
}

fn is_static_or_dl_path(p &string) bool {
    << *p == "/llms.txt" || *p == "/llms-full.txt" || *p == "/SKILL.md" ||
        *p == "/protocol.md" || *p == "/.well-known/fatext.json" ||
        *p == "/static/fatext.css" || *p == "/static/favicon.svg" ||
        *p == "/favicon.ico" || *p == "/static/logo.svg" ||
        (strings.has_prefix(p, "/dl/") && p.len > 4)
}

pub fn const_time_str_eq(a &string, b &string) bool {
    if a.len != b.len { << false }
    $diff := 0
    for i in 0:a.len {
        diff = diff | ((a[i] & 255) ^ (b[i] & 255))
    }
    << diff == 0
}

struct ConnRuntimeCfg {
    tls_on bool
    tls_hs_ns int
    cert_ch chan CertStoreMsg
    slow_ms int
    trust_proxy bool
    shutdown_secret string
}

fn handle_connection_guarded(fd int, req_seq int, peer_ip string, rcfg ConnRuntimeCfg, gate_ch chan ConnGateMsg, static_ch chan StaticJob, jobs chan HubJob, log_ch chan string, sig_ch chan int) {
    handle_connection(fd, req_seq, peer_ip + "", rcfg.tls_on, rcfg.tls_hs_ns, rcfg.cert_ch, static_ch, jobs, log_ch, rcfg.slow_ms, rcfg.trust_proxy, rcfg.shutdown_secret + "", sig_ch)
    release_conn_slot(gate_ch, peer_ip + "")
}

fn handle_connection(fd int, req_seq int, peer_ip string, tls_on bool, tls_hs_ns int, cert_ch chan CertStoreMsg, static_ch chan StaticJob, jobs chan HubJob, log_ch chan string, slow_ms int, trust_proxy bool, shutdown_secret string, sig_ch chan int) {
    cc_disable_sigpipe(fd)
    t0_ns := time.now()
    req_prefix := "r_" + strconv.itoa(req_seq)

    $cc := cc_from_tcp(fd, peer_ip + "")
    $tls_ms := 0
    if tls_on {
        csnap := cert_store_get(cert_ch)
        if !csnap.enabled || csnap.cert_pem.len == 0 || csnap.key_pem.len == 0 {
            jobs <- HubJob{kind: HUB_METRIC_TLS, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 0, reply_ch: chan HubReply{cap: 1}}
            now_err := time.now_time().unix()
            no_msg := "no active TLS certificate"
            log_event_json(log_ch, now_err, "tls_handshake_fail",
                "\"req_id\":" + json.quote(&req_prefix) + ",\"ip\":" + json.quote(&peer_ip) +
                ",\"tls_ms\":0,\"error\":" + json.quote(&no_msg))
            close_raw_fd_quiet(fd)
            <<
        }
        t_tls0 := time.now()
        cc = cc_from_tls(fd, &csnap.cert_pem, &csnap.key_pem, peer_ip + "", tls_hs_ns) or (err) {
            tls_ms = (time.now() - t_tls0) / 1000000
            if tls_ms < 0 { tls_ms = 0 }
            jobs <- HubJob{kind: HUB_METRIC_TLS, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 0, reply_ch: chan HubReply{cap: 1}}
            now_err := time.now_time().unix()
            emsg := err.msg()
            log_event_json(log_ch, now_err, "tls_handshake_fail",
                "\"req_id\":" + json.quote(&req_prefix) + ",\"ip\":" + json.quote(&peer_ip) +
                ",\"tls_ms\":" + strconv.itoa(tls_ms) + ",\"error\":" + json.quote(&emsg))
            close_raw_fd_quiet(fd)
            <<
        }
        tls_ms = (time.now() - t_tls0) / 1000000
        if tls_ms < 0 { tls_ms = 0 }
        jobs <- HubJob{kind: HUB_METRIC_TLS, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 1, reply_ch: chan HubReply{cap: 1}}
    }

    $req_n := 0
    while req_n < 200 {
        $req_t0 := t0_ns
        $req_tls_ms := tls_ms
        $read_to_ns := 10000000000
        $req_id := req_prefix + ""
        if req_n > 0 {
            req_t0 = time.now()
            req_tls_ms = 0
            read_to_ns = 5000000000
            req_id = req_prefix + "_" + strconv.itoa(req_n)
        }

        t_read0 := time.now()
        $read_errs := []string{}
        $req := read_req_into($&cc, read_to_ns, $&read_errs)
        if read_errs.len > 0 {
            read_err := read_errs[0] + ""
            if req_n > 0 && cc.buf.len == 0 {
                // Clean Keep-Alive idle close or timeout between requests
                <-
            }
            $rm := (time.now() - t_read0) / 1000000
            if rm < 0 { rm = 0 }
            r := err_resp(400, "ERR_BAD_REQUEST", read_err + "", 0, 0, 0)
            t_w0 := time.now()
            _ := write_http_resp_ka($&cc, &r, false)
            $w_ms := (time.now() - t_w0) / 1000000
            if w_ms < 0 { w_ms = 0 }
            $tot_us := (time.now() - req_t0) / 1000
            if tot_us < 0 { tot_us = 0 }
            tot_ms := tot_us / 1000
            now_r := time.now_time().unix()
            log_event_json(log_ch, now_r, "http_read_fail",
                "\"req_id\":" + json.quote(&req_id) + ",\"ip\":" + json.quote(&peer_ip) +
                ",\"tls_ms\":" + strconv.itoa(req_tls_ms) + ",\"read_ms\":" + strconv.itoa(rm) +
                ",\"error\":" + json.quote(&read_err))
            log_access_json(log_ch, slow_ms, now_r, req_id + "", "?", "/invalid", 400, "ERR_BAD_REQUEST",
                tls_on, peer_ip + "", "anon", "", 0, r.body.len, req_tls_ms, rm, 0, 0, w_ms, tot_ms, tot_us)
            <-
        }
        $read_ms := (time.now() - t_read0) / 1000000
        if read_ms < 0 { read_ms = 0 }

        client_ip := effective_client_ip(peer_ip + "", &req, trust_proxy)
        req.remote_ip = client_ip + ""
        meth := req.method()
        raw_p := req.path()
        route := normalize_route(raw_p + "")
        req_bytes := req.req_body.len

        reply_ch := chan HubReply{cap: 1}
        if path_only(raw_p + "") == "/v1/stream" {
            jobs <- HubJob{kind: HUB_SSE_SUB, req: req, sse_id: 0, enqueued_ns: time.now(), flag: 0, reply_ch: reply_ch}
            rep := <-reply_ch
            if !rep.is_sse {
                t_w0 := time.now()
                _ := write_http_resp_ka($&cc, &rep.resp, false)
                $w_ms := (time.now() - t_w0) / 1000000
                if w_ms < 0 { w_ms = 0 }
                $tot_us := (time.now() - req_t0) / 1000
                if tot_us < 0 { tot_us = 0 }
                log_access_json(log_ch, slow_ms, time.now_time().unix(), req_id + "", meth + "", route + "",
                    rep.resp.status, rep.err_code + "", tls_on, client_ip + "", rep.actor_type + "", rep.actor_id + "",
                    req_bytes, rep.resp.body.len, req_tls_ms, read_ms, rep.queue_ms, rep.handle_ms, w_ms, tot_us / 1000, tot_us)
                <-
            }
            t_w0 := time.now()
            open_rc := write_sse_open($&cc)
            $w_ms := (time.now() - t_w0) / 1000000
            if w_ms < 0 { w_ms = 0 }
            $tot_us := (time.now() - req_t0) / 1000
            if tot_us < 0 { tot_us = 0 }
            $open_status := 200
            if open_rc < 0 { open_status = 499 }
            log_access_json(log_ch, slow_ms, time.now_time().unix(), req_id + "", meth + "", route + "",
                open_status, "", tls_on, client_ip + "", rep.actor_type + "", rep.actor_id + "",
                req_bytes, 0, req_tls_ms, read_ms, rep.queue_ms, rep.handle_ms, w_ms, tot_us / 1000, tot_us)
            if open_rc < 0 {
                unsub_ch := chan HubReply{cap: 1}
                jobs <- HubJob{kind: HUB_SSE_UNSUB, req: empty_req(), sse_id: rep.sse_id, enqueued_ns: time.now(), flag: 0, reply_ch: unsub_ch}
                _ := <-unsub_ch
                log_event_json(log_ch, time.now_time().unix(), "sse_close",
                    "\"sse_id\":" + strconv.itoa(rep.sse_id) + ",\"agent_id\":" + json.quote(&rep.actor_id) +
                    ",\"reason\":\"open_write_fail\",\"duration_ms\":0,\"events_sent\":0,\"pings_sent\":0")
                <-
            }
            sse_t0 := time.now()
            tick := time.new_ticker(250000000)
            $ping_ticks := 0
            $ev_sent := 0
            $pg_sent := 0
            $close_reason := "peer_closed"
            $alive := true
            while alive {
                select {
                    msg := <-rep.sse_ch {
                        if msg == SSE_CTRL_CLOSE {
                            disc := "event: system\ndata: {\"kind\":\"disconnected\"}\n\n"
                            _ := cc_write($&cc, &disc)
                            close_reason = "ctrl_close"
                            alive = false
                        } else if msg == SSE_CTRL_SHUTDOWN {
                            sd := "event: system\ndata: {\"kind\":\"shutdown\"}\n\n"
                            _ := cc_write($&cc, &sd)
                            close_reason = "shutdown"
                            alive = false
                        } else if cc_peer_closed(&cc) {
                            close_reason = "peer_closed"
                            alive = false
                        } else if cc_write($&cc, &msg) < 0 {
                            close_reason = "write_error"
                            alive = false
                        } else {
                            ev_sent += 1
                        }
                    }
                    _ := <-tick.c {
                        if cc_peer_closed(&cc) {
                            close_reason = "peer_closed"
                            alive = false
                        } else {
                            ping_ticks += 1
                            if ping_ticks >= 100 {
                                ping_ticks = 0
                                ping := ": ping\n\n"
                                if cc_write($&cc, &ping) < 0 {
                                    close_reason = "write_error"
                                    alive = false
                                } else {
                                    pg_sent += 1
                                }
                            }
                        }
                    }
                }
            }
            tick.stop()
            $sse_dur := (time.now() - sse_t0) / 1000000
            if sse_dur < 0 { sse_dur = 0 }
            unsub_ch := chan HubReply{cap: 1}
            jobs <- HubJob{kind: HUB_SSE_UNSUB, req: empty_req(), sse_id: rep.sse_id, enqueued_ns: time.now(), flag: 0, reply_ch: unsub_ch}
            _ := <-unsub_ch
            log_event_json(log_ch, time.now_time().unix(), "sse_close",
                "\"sse_id\":" + strconv.itoa(rep.sse_id) + ",\"agent_id\":" + json.quote(&rep.actor_id) +
                ",\"reason\":" + json.quote(&close_reason) + ",\"duration_ms\":" + strconv.itoa(sse_dur) +
                ",\"events_sent\":" + strconv.itoa(ev_sent) + ",\"pings_sent\":" + strconv.itoa(pg_sent))
            <-
        }

        ka := wants_keep_alive(&req) && req_n + 1 < 200
        req_p_only := path_only(raw_p + "")
        if meth == "POST" && req_p_only == "/internal/shutdown" && shutdown_secret.len > 0 {
            now_sd := time.now_time().unix()
            if !is_loopback_ip_str(&peer_ip) {
                r := err_resp(403, "ERR_FORBIDDEN", "shutdown endpoint is loopback-only", 0, 0, 0)
                t_w0 := time.now()
                _ := write_http_resp_ka($&cc, &r, false)
                $w_ms := (time.now() - t_w0) / 1000000
                if w_ms < 0 { w_ms = 0 }
                $tot_us := (time.now() - req_t0) / 1000
                if tot_us < 0 { tot_us = 0 }
                log_event_json(log_ch, now_sd, "shutdown_auth_fail",
                    "\"ip\":" + json.quote(&client_ip) + ",\"peer_ip\":" + json.quote(&peer_ip) + ",\"reason\":\"non_loopback\"")
                log_access_json(log_ch, slow_ms, now_sd, req_id + "", meth + "", route + "",
                    403, "ERR_FORBIDDEN", tls_on, client_ip + "", "anon", "",
                    req_bytes, r.body.len, req_tls_ms, read_ms, 0, 0, w_ms, tot_us / 1000, tot_us)
                <-
            }
            got_sec := req.header("X-Fatext-Shutdown-Secret")
            if !const_time_str_eq(&got_sec, &shutdown_secret) {
                r := err_resp(403, "ERR_FORBIDDEN", "invalid shutdown secret", 0, 0, 0)
                t_w0 := time.now()
                _ := write_http_resp_ka($&cc, &r, false)
                $w_ms := (time.now() - t_w0) / 1000000
                if w_ms < 0 { w_ms = 0 }
                $tot_us := (time.now() - req_t0) / 1000
                if tot_us < 0 { tot_us = 0 }
                $sd_reason := "bad_secret"
                if got_sec.len == 0 { sd_reason = "missing_secret" }
                log_event_json(log_ch, now_sd, "shutdown_auth_fail",
                    "\"ip\":" + json.quote(&client_ip) + ",\"peer_ip\":" + json.quote(&peer_ip) + ",\"reason\":" + json.quote(&sd_reason))
                log_access_json(log_ch, slow_ms, now_sd, req_id + "", meth + "", route + "",
                    403, "ERR_FORBIDDEN", tls_on, client_ip + "", "anon", "",
                    req_bytes, r.body.len, req_tls_ms, read_ms, 0, 0, w_ms, tot_us / 1000, tot_us)
                <-
            }
            r := json_resp(200, "{\"ok\":true,\"stopping\":true}")
            t_w0 := time.now()
            _ := write_http_resp_ka($&cc, &r, false)
            $w_ms := (time.now() - t_w0) / 1000000
            if w_ms < 0 { w_ms = 0 }
            $tot_us := (time.now() - req_t0) / 1000
            if tot_us < 0 { tot_us = 0 }
            log_event_json(log_ch, now_sd, "shutdown_requested",
                "\"peer_ip\":" + json.quote(&peer_ip))
            log_access_json(log_ch, slow_ms, now_sd, req_id + "", meth + "", route + "",
                200, "", tls_on, client_ip + "", "internal", "shutdown",
                req_bytes, r.body.len, req_tls_ms, read_ms, 0, 0, w_ms, tot_us / 1000, tot_us)
            select {
                sig_ch <- signal.SIGTERM {}
                else {}
            }
            <-
        }
        if meth == "GET" && is_static_or_dl_path(&req_p_only) {
            t_st0 := time.now()
            st_rch := chan HttpResp{cap: 1}
            static_ch <- StaticJob{path: req_p_only, client_ip: client_ip + "", reply_ch: st_rch}
            sresp := <-st_rch
            if sresp.status != 0 {
                $sh_ms := (time.now() - t_st0) / 1000000
                if sh_ms < 0 { sh_ms = 0 }
                t_w0 := time.now()
                w_rc := write_http_resp_ka($&cc, &sresp, ka)
                $w_ms := (time.now() - t_w0) / 1000000
                if w_ms < 0 { w_ms = 0 }
                $tot_us := (time.now() - req_t0) / 1000
                if tot_us < 0 { tot_us = 0 }
                $secode := ""
                if sresp.status == 429 { secode = "ERR_RATE_LIMITED" }
                else if sresp.status >= 400 { secode = "ERR_NOT_FOUND" }
                log_access_json(log_ch, slow_ms, time.now_time().unix(), req_id + "", meth + "", route + "",
                    sresp.status, secode, tls_on, client_ip + "", "anon", "",
                    req_bytes, sresp.body.len, req_tls_ms, read_ms, 0, sh_ms, w_ms, tot_us / 1000, tot_us)
                req_n += 1
                if !ka || w_rc < 0 {
                    <-
                }
                ->
            }
        }
        jobs <- HubJob{kind: HUB_HTTP, req: req, sse_id: 0, enqueued_ns: time.now(), flag: 0, reply_ch: reply_ch}
        rep := <-reply_ch
        req_n += 1
        t_w0 := time.now()
        w_rc := write_http_resp_ka($&cc, &rep.resp, ka)
        $w_ms := (time.now() - t_w0) / 1000000
        if w_ms < 0 { w_ms = 0 }
        $tot_us := (time.now() - req_t0) / 1000
        if tot_us < 0 { tot_us = 0 }
        log_access_json(log_ch, slow_ms, time.now_time().unix(), req_id + "", meth + "", route + "",
            rep.resp.status, rep.err_code + "", tls_on, client_ip + "", rep.actor_type + "", rep.actor_id + "",
            req_bytes, rep.resp.body.len, req_tls_ms, read_ms, rep.queue_ms, rep.handle_ms, w_ms, tot_us / 1000, tot_us)
        if !ka || w_rc < 0 {
            <-
        }
    }
    cc_close($&cc)
}

fn is_allowed_redirect_path(rpath &string) bool {
    if rpath.len == 0 || rpath.len > 4096 { << false }
    if (rpath[0] & 255) != 47 { << false }
    if strings.has_prefix(rpath, "//") || strings.has_prefix(rpath, "/\\") { << false }
    for i in 0:rpath.len {
        c := rpath[i] & 255
        if c <= 32 || c >= 127 || c == 92 { << false }
    }
    << true
}

fn resolve_allowed_redirect_host(raw_host &string, https_host string, allowed_hosts &[]string) string {
    $h := strings.to_lower(&strings.trim_space(raw_host))
    if strings.has_suffix(&h, ":80") && h.len > 3 {
        h = h[0:(h.len - 3)]
    }
    for i in 0:allowed_hosts.len {
        if h == allowed_hosts[i] {
            << h
        }
    }
    if h == https_host || h == "www." + https_host {
        << h
    }
    << https_host + ""
}

fn handle_redirect_conn(fd int, peer_ip string, https_host string, allowed_hosts &[]string, chal_ch chan AcmeChalMsg) {
    cc_disable_sigpipe(fd)
    $cc := cc_from_tcp(fd, peer_ip + "")
    req := read_http_request_timeout($&cc, 2000000000) or (err) {
        r400 := err_resp(400, "ERR_BAD_REQUEST", err.msg(), 0, 0, 0)
        _ := write_http_resp($&cc, &r400)
        cc_close($&cc)
        <<
    }
    rpath := req.path()
    p_only := path_only(rpath + "")
    if strings.has_prefix(&p_only, "/.well-known/acme-challenge/") {
        meth := req.method()
        if meth != "GET" && meth != "HEAD" {
            r405 := err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
            _ := write_http_resp($&cc, &r405)
            cc_close($&cc)
            <<
        }
        raw_ch_host := req.header("Host")
        ch_host := strip_host_port(&raw_ch_host)
        if ch_host.len == 0 || !str_list_contains(allowed_hosts, ch_host + "") {
            r404h := http_resp(404, "text/plain; charset=utf-8", "", &"not found\n")
            _ := write_http_resp($&cc, &r404h)
            cc_close($&cc)
            <<
        }
        tok := p_only[28:p_only.len]
        if !is_valid_acme_token(&tok) {
            r404 := http_resp(404, "text/plain; charset=utf-8", "", &"not found\n")
            _ := write_http_resp($&cc, &r404)
            cc_close($&cc)
            <<
        }
        key_auth := acme_chal_get(chal_ch, tok + "")
        if key_auth.len == 0 {
            r404 := http_resp(404, "text/plain; charset=utf-8", "", &"challenge not found\n")
            _ := write_http_resp($&cc, &r404)
            cc_close($&cc)
            <<
        }
        if meth == "HEAD" {
            empty_b := ""
            r200 := http_resp(200, "text/plain; charset=utf-8", "Cache-Control: no-store\r\n", &empty_b)
            _ := write_http_resp($&cc, &r200)
            cc_close($&cc)
            <<
        }
        r200 := http_resp(200, "text/plain; charset=utf-8", "Cache-Control: no-store\r\n", &key_auth)
        _ := write_http_resp($&cc, &r200)
        cc_close($&cc)
        <<
    }
    if !is_allowed_redirect_path(&rpath) {
        r400 := err_resp(400, "ERR_BAD_REQUEST", "invalid redirect path", 0, 0, 0)
        _ := write_http_resp($&cc, &r400)
        cc_close($&cc)
        <<
    }
    raw_h := req.header("Host")
    host := resolve_allowed_redirect_host(&raw_h, https_host + "", allowed_hosts)
    loc := "https://" + host + rpath
    body := "Redirecting to " + loc + "\n"
    r := http_resp(301, "text/plain; charset=utf-8", "Location: " + loc + "\r\n", &body)
    _ := write_http_resp($&cc, &r)
    cc_close($&cc)
}

fn handle_redirect_conn_guarded(fd int, peer_ip string, https_host string, allowed_hosts []string, chal_ch chan AcmeChalMsg, gate_ch chan ConnGateMsg) {
    handle_redirect_conn(fd, peer_ip + "", https_host + "", &allowed_hosts, chal_ch)
    release_conn_slot(gate_ch, peer_ip + "")
}

fn redirect_loop(redir_addr string, https_host string, allowed_hosts []string, chal_ch chan AcmeChalMsg, gate_ch chan ConnGateMsg, log_ch chan string, ready_ch chan int) {
    lfd := net.listen(redir_addr + "") or (err) {
        println("fatext-server: redirect/HTTP-01 listen failed: " + err.msg())
        ready_ch <- 0
        <<
    }
    ready_ch <- 1
    while true {
        fd := net.accept(lfd) or (err) {
            time.sleep(10000000)
            ->
        }
        peer_ip := resolve_peer_ip(fd)
        if !acquire_conn_slot(gate_ch, peer_ip + "") {
            log_event_json(log_ch, time.now_time().unix(), "conn_rejected",
                "\"ip\":" + json.quote(&peer_ip) + ",\"reason\":\"redirect_conn_limit\"")
            close_raw_fd_quiet(fd)
            ->
        }
        xu handle_redirect_conn_guarded(fd, peer_ip + "", https_host + "", clone_str_slice(&allowed_hosts), chal_ch, gate_ch)
    }
}

fn metrics_ticker_loop(interval_sec int, jobs chan HubJob) {
    ns := interval_sec * 1000000000
    tick := time.new_ticker(ns)
    while true {
        _ := <-tick.c
        jobs <- HubJob{kind: HUB_METRIC_FLUSH, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 0, reply_ch: chan HubReply{cap: 1}}
    }
}

fn ignore_sigpipe_quiet() {
    _ := signal.ignore(signal.SIGPIPE) or (err) { << }
}

fn watch_signal_quiet(ch chan int, sig int) {
    _ := signal.notify(ch, sig) or (err) { << }
}

fn shutdown_watcher_loop(sig_ch chan int, accept_stop chan int, lfd int, drain_ms int, jobs chan HubJob, log_ch chan string, flush_done chan int) {
    sig := <-sig_ch
    time.sleep(30000000)

    d_rch := chan HubReply{cap: 1}
    jobs <- HubJob{kind: HUB_SHUTDOWN_DRAIN, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 0, reply_ch: d_rch}
    dtick := time.new_ticker(1000000000)
    select {
        _ := <-d_rch {}
        _ := <-dtick.c {}
    }
    dtick.stop()

    select {
        accept_stop <- 1 {}
        else {}
    }
    close_raw_fd_quiet(lfd)
    if drain_ms > 0 {
        time.sleep(drain_ms * 1000000)
    }

    now := time.now_time().unix()
    log_event_json(log_ch, now, "server_stop", "\"signal\":" + strconv.itoa(sig))

    m_rch := chan HubReply{cap: 1}
    m_job := HubJob{kind: HUB_METRIC_FLUSH, req: empty_req(), sse_id: 0, enqueued_ns: 0, flag: 1, reply_ch: m_rch}
    jobs <- m_job
    mtick := time.new_ticker(500000000)
    select {
        _ := <-m_rch {}
        _ := <-mtick.c {}
    }
    mtick.stop()

    flush_sig := LOG_CTRL_FLUSH
    log_ch <- flush_sig
    ltick := time.new_ticker(2000000000)
    select {
        _ := <-flush_done {}
        _ := <-ltick.c {}
    }
    ltick.stop()
    core.exit_process(0)
}

fn flush_logs_before_exit(log_ch chan string, flush_done chan int) {
    flush_sig := LOG_CTRL_FLUSH
    log_ch <- flush_sig
    ltick := time.new_ticker(1500000000)
    select {
        _ := <-flush_done {}
        _ := <-ltick.c {}
    }
    ltick.stop()
}

fn main() int {
    ignore_sigpipe_quiet()
    addr := getenv_or("FATEXT_ADDR", "127.0.0.1:8080")
    data_dir := getenv_or("FATEXT_DATA_DIR", "/var/lib/fatext")
    www_dir := getenv_or("FATEXT_WWW_DIR", "./www")
    tpl_dir := getenv_or("FATEXT_TEMPLATES_DIR", "./templates")
    dl_dir := getenv_or("FATEXT_DL_DIR", data_dir + "/dl")
    pow_bits := getenv_int_or("FATEXT_POW_BITS", 20)
    mail_secret := os.getenv("FATEXT_MAIL_INTERNAL_SECRET")
    shutdown_secret := os.getenv("FATEXT_SHUTDOWN_SECRET")
    admin_secret := os.getenv("FATEXT_ADMIN_SECRET")
    ip_rpm := getenv_int_or("FATEXT_IP_RPM", 600)
    tls_cert_path := os.getenv("FATEXT_TLS_CERT")
    tls_key_path := os.getenv("FATEXT_TLS_KEY")
    $redir_addr := os.getenv("FATEXT_HTTP_REDIRECT_ADDR")
    raw_public_host := os.getenv("FATEXT_PUBLIC_HOST")
    $public_host := strings.to_lower(&getenv_or("FATEXT_PUBLIC_HOST", "fatext.com"))

    acme_domains_raw := strings.trim_space(&os.getenv("FATEXT_ACME_DOMAINS"))
    acme_email := strings.trim_space(&os.getenv("FATEXT_ACME_EMAIL"))
    acme_dir := getenv_or("FATEXT_ACME_DIR", data_dir + "/acme")
    acme_staging := getenv_int_or("FATEXT_ACME_STAGING", 0) != 0
    acme_dir_override := strings.trim_space(&os.getenv("FATEXT_ACME_DIRECTORY_URL"))
    $acme_renew_days := getenv_int_or("FATEXT_ACME_RENEW_DAYS", 30)
    if acme_renew_days < 1 { acme_renew_days = 1 }
    if acme_renew_days > 89 { acme_renew_days = 89 }
    $acme_check_sec := getenv_int_or("FATEXT_ACME_CHECK_SEC", 21600)
    if acme_check_sec < 1 { acme_check_sec = 1 }
    acme_insecure_tls := getenv_int_or("FATEXT_ACME_INSECURE_TLS", 0) != 0

    log_dir := getenv_or("FATEXT_LOG_DIR", data_dir + "/logs")
    retain_days := getenv_int_or("FATEXT_LOG_RETENTION_DAYS", 30)
    slow_ms := getenv_int_or("FATEXT_SLOW_MS", 200)
    metrics_interval_sec := getenv_int_or("FATEXT_METRICS_INTERVAL_SEC", 60)
    stdout_mirror := getenv_int_or("FATEXT_LOG_STDOUT", 0) != 0
    trust_proxy := getenv_int_or("FATEXT_TRUST_PROXY", 0) != 0
    max_conns := getenv_int_or("FATEXT_MAX_CONNS", 4096)
    max_conns_per_ip := getenv_int_or("FATEXT_MAX_CONNS_PER_IP", 64)
    redir_max_conns := getenv_int_or("FATEXT_REDIRECT_MAX_CONNS", 512)
    redir_max_conns_per_ip := getenv_int_or("FATEXT_REDIRECT_MAX_CONNS_PER_IP", 16)
    admin_local_only := getenv_int_or("FATEXT_ADMIN_LOCAL_ONLY", 0) != 0
    max_sse := getenv_int_or("FATEXT_MAX_SSE", 2048)
    max_sse_per_agent := getenv_int_or("FATEXT_MAX_SSE_PER_AGENT", 8)
    drain_ms := getenv_int_or("FATEXT_DRAIN_MS", 150)
    tls_handshake_ms := getenv_int_or("FATEXT_TLS_HANDSHAKE_MS", 5000)
    tls_hs_ns := tls_handshake_ms * 1000000

    has_static_tls := tls_cert_path.len > 0 || tls_key_path.len > 0
    acme_on := acme_domains_raw.len > 0
    if acme_on && has_static_tls {
        println("fatext-server: FATEXT_ACME_DOMAINS cannot be combined with FATEXT_TLS_CERT/FATEXT_TLS_KEY")
        << 1
    }
    if (tls_cert_path.len > 0 && tls_key_path.len == 0) || (tls_cert_path.len == 0 && tls_key_path.len > 0) {
        println("fatext-server: FATEXT_TLS_CERT and FATEXT_TLS_KEY must both be set")
        << 1
    }

    $tls_on := false
    $tls_mode := "off"
    $init_snap := empty_cert_snapshot()
    $acme_domains := []string{}
    $acme_dir_url := ACME_PROD_DIR
    if acme_staging { acme_dir_url = ACME_STAGING_DIR }
    if acme_dir_override.len > 0 { acme_dir_url = acme_dir_override + "" }
    allow_loopback_http := acme_dir_override.len > 0

    now_boot := time.now_time().unix()
    if tls_cert_path.len > 0 && tls_key_path.len > 0 {
        cert_pem := os.read(tls_cert_path + "") or (err) {
            println("fatext-server: failed reading FATEXT_TLS_CERT: " + err.msg())
            << 1
        }
        key_pem := os.read(tls_key_path + "") or (err) {
            println("fatext-server: failed reading FATEXT_TLS_KEY: " + err.msg())
            << 1
        }
        cmeta := parse_and_validate_cert_pair(&cert_pem, &key_pem) or (err) {
            println("fatext-server: invalid FATEXT_TLS_CERT/KEY: " + err.msg())
            << 1
        }
        tls_on = true
        tls_mode = "static"
        init_snap = CertSnapshot{
            enabled: true,
            mode: "static",
            cert_pem: cert_pem,
            key_pem: key_pem,
            domains_csv: cmeta.domains_csv + "",
            not_before: cmeta.not_before,
            not_after: cmeta.not_after,
            updated_at: now_boot
        }
    } else if acme_on {
        acme_domains = parse_acme_domains(&acme_domains_raw) or (err) {
            println("fatext-server: " + err.msg())
            << 1
        }
        validate_acme_url(&acme_dir_url, allow_loopback_http) or (err) {
            println("fatext-server: invalid ACME directory URL: " + err.msg())
            << 1
        }
        if raw_public_host.len == 0 {
            public_host = acme_domains[0] + ""
        }
        if redir_addr.len == 0 {
            redir_addr = "0.0.0.0:80"
        }
        tls_on = true
        tls_mode = "acme"
    }

    $allowed_hosts := []string{}
    allowed_hosts.push(public_host + "")
    allowed_hosts.push("www." + public_host)
    for di in 0:acme_domains.len {
        d_s := acme_domains[di] + ""
        if !str_list_contains(&allowed_hosts, d_s + "") {
            allowed_hosts.push(d_s)
        }
    }

    cert_ch := chan CertStoreMsg{cap: 64}
    xu cert_store_loop(init_snap, cert_ch)
    chal_ch := chan AcmeChalMsg{cap: 64}
    xu acme_chal_loop(chal_ch)

    $st := new_state(addr + "", data_dir + "", www_dir + "", tpl_dir + "", dl_dir + "", pow_bits, mail_secret + "", ip_rpm)
    init_state($&st)

    $ch_names := []string{}
    for ci in 0:st.channels.len {
        ch_names.push(st.channels[ci].name + "")
    }

    log_ch := chan string{cap: 1024}
    flush_done := chan int{cap: 1}
    xu logger_loop(log_dir + "", retain_days, stdout_mirror, log_ch, flush_done)

    webhook_ch := chan string{cap: 128}
    for wi in 0:4 {
        _ := wi
        xu webhook_worker_loop(webhook_ch)
    }

    now0 := time.now_time().unix()
    hub := new_hub_state(st, log_ch, webhook_ch, log_dir + "", slow_ms, now0, max_sse, max_sse_per_agent, admin_secret + "", admin_local_only, shutdown_secret.len > 0, cert_ch, tls_cert_path + "", tls_key_path + "")
    jobs := chan HubJob{cap: 128}
    xu hub_loop(hub, jobs)
    xu maintenance_loop(data_dir + "", ch_names, log_ch, jobs)

    static_ch := chan StaticJob{cap: 64}
    xu static_loop(www_dir + "", dl_dir + "", ip_rpm, static_ch)

    gate_ch := chan ConnGateMsg{cap: 128}
    xu conn_guard_loop(max_conns, max_conns_per_ip, gate_ch)

    if metrics_interval_sec > 0 {
        xu metrics_ticker_loop(metrics_interval_sec, jobs)
    }

    if tls_on && redir_addr.len > 0 {
        redir_gate_ch := chan ConnGateMsg{cap: 64}
        xu conn_guard_loop(redir_max_conns, redir_max_conns_per_ip, redir_gate_ch)
        redir_ready := chan int{cap: 1}
        xu redirect_loop(redir_addr + "", public_host + "", clone_str_slice(&allowed_hosts), chal_ch, redir_gate_ch, log_ch, redir_ready)
        rok := <-redir_ready
        if acme_on && rok == 0 {
            err_msg := "ACME HTTP-01 listener failed to bind " + redir_addr
            log_event_json(log_ch, time.now_time().unix(), "acme_error", "\"error\":" + json.quote(&err_msg))
            flush_logs_before_exit(log_ch, flush_done)
            println("fatext-server: " + err_msg)
            core.exit_process(1)
            << 1
        }
    }

    if acme_on {
        acme_cfg := AcmeConfig{
            domains: clone_str_slice(&acme_domains),
            email: acme_email + "",
            acme_dir: acme_dir + "",
            directory_url: acme_dir_url + "",
            renew_days: acme_renew_days,
            check_sec: acme_check_sec,
            insecure_tls: acme_insecure_tls,
            allow_loopback_http: allow_loopback_http
        }
        $dom_json := []string{}
        for di in 0:acme_domains.len {
            ds := acme_domains[di] + ""
            dom_json.push(json.quote(&ds))
        }
        log_event_json(log_ch, time.now_time().unix(), "acme_start",
            "\"domains\":[" + strings.join(dom_json, ",") + "]" +
            ",\"directory_url\":" + json.quote(&acme_dir_url) +
            ",\"acme_dir\":" + json.quote(&acme_dir) +
            ",\"renew_days\":" + strconv.itoa(acme_renew_days) +
            ",\"check_sec\":" + strconv.itoa(acme_check_sec))
        loaded := acme_try_load_cached(&acme_cfg, cert_ch, log_ch)
        if !loaded {
            $issued := false
            $last_err := ""
            $try_n := 0
            while try_n < 3 && !issued {
                try_n += 1
                _ := acme_issue_and_install(&acme_cfg, chal_ch, cert_ch, log_ch) or (err) {
                    last_err = err.msg()
                    if try_n < 3 {
                        time.sleep(1000000000)
                    }
                    ->
                }
                issued = true
            }
            if !issued {
                log_event_json(log_ch, time.now_time().unix(), "acme_error",
                    "\"error\":" + json.quote(&last_err) + ",\"stage\":\"startup\"")
                flush_logs_before_exit(log_ch, flush_done)
                println("fatext-server: initial ACME issuance failed: " + last_err)
                core.exit_process(1)
                << 1
            }
        }
        xu acme_renew_loop(acme_cfg, chal_ch, cert_ch, log_ch)
    }

    lfd := net.listen(addr + "") or (err) {
        println("fatext-server: listen failed: " + err.msg())
        core.exit_process(1)
        << 1
    }
    sig_ch := chan int{cap: 4}
    accept_stop := chan int{cap: 1}
    watch_signal_quiet(sig_ch, signal.SIGINT)
    watch_signal_quiet(sig_ch, signal.SIGTERM)
    xu shutdown_watcher_loop(sig_ch, accept_stop, lfd, drain_ms, jobs, log_ch, flush_done)

    $scheme := "http"
    $tls_s := "false"
    if tls_on {
        scheme = "https"
        tls_s = "true"
    }
    $adm_s := "false"
    if admin_secret.len > 0 { adm_s = "true" }
    $adm_loc_s := "false"
    if admin_local_only { adm_loc_s = "true" }
    log_event_json(log_ch, now0, "server_start",
        "\"addr\":" + json.quote(&addr) + ",\"tls\":" + tls_s +
        ",\"tls_mode\":" + json.quote(&tls_mode) +
        ",\"admin_enabled\":" + adm_s +
        ",\"admin_local_only\":" + adm_loc_s +
        ",\"pow_bits\":" + strconv.itoa(pow_bits) + ",\"ip_rpm\":" + strconv.itoa(ip_rpm) +
        ",\"max_conns\":" + strconv.itoa(max_conns) + ",\"max_conns_per_ip\":" + strconv.itoa(max_conns_per_ip) +
        ",\"tls_handshake_ms\":" + strconv.itoa(tls_handshake_ms) +
        ",\"log_dir\":" + json.quote(&log_dir) + ",\"retain_days\":" + strconv.itoa(retain_days) +
        ",\"slow_ms\":" + strconv.itoa(slow_ms) + ",\"metrics_interval_sec\":" + strconv.itoa(metrics_interval_sec))
    println("fatext-server listening on " + scheme + "://" + addr + " (tls=" + tls_mode + ", data=" + data_dir + ", pow=" + str(pow_bits) + ", logs=" + log_dir + ")")

    $req_seq := 0
    $accept_running := true
    while accept_running {
        select {
            _ := <-accept_stop {
                accept_running = false
            }
            else {}
        }
        if !accept_running { -> }
        fd := net.accept(lfd) or (err) {
            select {
                _ := <-accept_stop {
                    accept_running = false
                }
                else {}
            }
            if accept_running {
                time.sleep(10000000)
            }
            ->
        }
        peer_ip := resolve_peer_ip(fd)
        if !acquire_conn_slot(gate_ch, peer_ip + "") {
            log_event_json(log_ch, time.now_time().unix(), "conn_rejected",
                "\"ip\":" + json.quote(&peer_ip) + ",\"reason\":\"conn_limit\"")
            close_raw_fd_quiet(fd)
            ->
        }
        req_seq += 1
        rcfg := ConnRuntimeCfg{
            tls_on: tls_on,
            tls_hs_ns: tls_hs_ns,
            cert_ch: cert_ch,
            slow_ms: slow_ms,
            trust_proxy: trust_proxy,
            shutdown_secret: shutdown_secret + ""
        }
        xu handle_connection_guarded(fd, req_seq, peer_ip + "", rcfg, gate_ch, static_ch, jobs, log_ch, sig_ch)
    }
    while true {
        time.sleep(1000000000)
    }
    << 0
}
