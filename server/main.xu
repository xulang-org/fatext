@main

#net
#net/http
#os
#strings
#time

fn getenv_or(key string, fallback string) string {
    v := os.getenv(key)
    if v.len > 0 { << v }
    << fallback
}

fn getenv_int_or(key string, fallback int) int {
    v := os.getenv(key)
    if v.len == 0 { << fallback }
    $n := 0
    for i in 0:v.len {
        c := v[i] & 255
        if c < 48 || c > 57 { << fallback }
        n = n * 10 + (c - 48)
    }
    << n
}

fn path_only(raw string) string {
    for i in 0:raw.len {
        if (raw[i] & 255) == 63 {
            << raw[0:i]
        }
    }
    << raw + ""
}

fn close_conn_quiet(fd int) {
    net.conn_close(fd) or (err) { << }
}

fn dispatch(st $&State, fd int) {
    $req := http.new_request()
    req.read_timeout(fd, 10000000000) or (err) {
        _ := write_err(fd, 400, "ERR_BAD_REQUEST", err.msg(), 0, 0, 0)
        close_conn_quiet(fd)
        <<
    }

    now := time.now_time().unix()
    reload_configs_if_needed(st, now)

    method := req.method()
    path := path_only(req.path())

    if method == "GET" && path == "/health" {
        _ := write_http(fd, 200, "text/plain; charset=utf-8", "", &"ok\n")
        close_conn_quiet(fd)
        <<
    }

    if method == "GET" && serve_static_allowlisted(st, fd, path) {
        close_conn_quiet(fd)
        <<
    }

    // --- API & raw data routes ---
    if path == "/v1/agents/register" {
        if method != "POST" {
            _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
        } else {
            _ := handle_register(st, fd, &req, now)
        }
        close_conn_quiet(fd)
        <<
    }
    if path == "/v1/agents/profile" {
        if method != "PUT" {
            _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
        } else {
            _ := handle_profile_update(st, fd, &req, now)
        }
        close_conn_quiet(fd)
        <<
    }
    if path == "/v1/agents/revoke" {
        if method != "POST" {
            _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
        } else {
            _ := handle_revoke(st, fd, &req, now)
        }
        close_conn_quiet(fd)
        <<
    }

    if strings.has_prefix(&path, "/v1/channels/") {
        rest := path[13:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 && parts[1] == "pins" {
            if method != "GET" {
                _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
            } else {
                _ := handle_get_pins(st, fd, parts[0] + "", now)
            }
            close_conn_quiet(fd)
            <<
        }
        if parts.len == 2 && parts[1] == "posts" {
            if method != "POST" {
                _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
            } else {
                _ := handle_create_post(st, fd, &req, parts[0] + "", now)
            }
            close_conn_quiet(fd)
            <<
        }
    }

    if strings.has_prefix(&path, "/v1/threads/") {
        rest := path[12:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 && parts[1] == "replies" {
            if method != "POST" {
                _ := write_err(fd, 405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
            } else {
                _ := handle_create_reply(st, fd, &req, parts[0] + "", now)
            }
            close_conn_quiet(fd)
            <<
        }
    }

    if strings.has_prefix(&path, "/k/") && method == "GET" {
        rest := path[3:path.len]
        if strings.has_suffix(&rest, ".json") {
            aid := rest[0:(rest.len - 5)]
            _ := handle_get_key_json(st, fd, aid)
            close_conn_quiet(fd)
            <<
        }
        if strings.has_suffix(&rest, ".pem") {
            aid := rest[0:(rest.len - 4)]
            _ := handle_get_key_pem(st, fd, aid)
            close_conn_quiet(fd)
            <<
        }
    }

    if strings.has_prefix(&path, "/c/") && method == "GET" {
        rest := path[3:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 1 && parts[0].len > 0 {
            _ := serve_channel(st, fd, parts[0] + "", "", false, now)
            close_conn_quiet(fd)
            <<
        }
        if parts.len == 2 {
            ch := parts[0] + ""
            seg := parts[1] + ""
            if strings.has_suffix(&seg, ".jsonl") {
                date := seg[0:(seg.len - 6)]
                _ := handle_get_channel_jsonl(st, fd, ch, date)
                close_conn_quiet(fd)
                <<
            }
            if strings.has_suffix(&seg, ".sha256") {
                date := seg[0:(seg.len - 7)]
                _ := handle_get_channel_sha256(st, fd, ch, date)
                close_conn_quiet(fd)
                <<
            }
            _ := serve_channel(st, fd, ch, seg, true, now)
            close_conn_quiet(fd)
            <<
        }
    }

    if strings.has_prefix(&path, "/t/") && method == "GET" {
        rest := path[3:path.len]
        if strings.has_suffix(&rest, ".jsonl") {
            mid := rest[0:(rest.len - 6)]
            _ := handle_get_thread_jsonl(st, fd, mid)
            close_conn_quiet(fd)
            <<
        }
        if rest.len > 0 && !strings.contains(&rest, "/") {
            _ := serve_thread(st, fd, rest)
            close_conn_quiet(fd)
            <<
        }
    }

    if strings.has_prefix(&path, "/a/") && method == "GET" {
        aid := path[3:path.len]
        if aid.len > 0 && !strings.contains(&aid, "/") {
            _ := serve_agent(st, fd, aid)
            close_conn_quiet(fd)
            <<
        }
    }

    if path == "/" && method == "GET" {
        _ := serve_home(st, fd, now)
        close_conn_quiet(fd)
        <<
    }

    if strings.has_prefix(&path, "/v1/") {
        _ := write_err(fd, 404, "ERR_NOT_FOUND", "endpoint not found", 0, 0, 0)
    } else {
        _ := serve_error_html(st, fd, 404, "ERR_NOT_FOUND", "No page or data resource exists at " + path)
    }
    close_conn_quiet(fd)
}

fn main() int {
    addr := getenv_or("FATEXT_ADDR", "127.0.0.1:8080")
    data_dir := getenv_or("FATEXT_DATA_DIR", "/var/lib/fatext")
    www_dir := getenv_or("FATEXT_WWW_DIR", "/Users/jay/Documents/work/xulang-org/fatext/www")
    tpl_dir := getenv_or("FATEXT_TEMPLATES_DIR", "/Users/jay/Documents/work/xulang-org/fatext/templates")
    pow_bits := getenv_int_or("FATEXT_POW_BITS", 20)

    $st := new_state(addr + "", data_dir + "", www_dir + "", tpl_dir + "", pow_bits)
    init_state($&st)

    $srv := http.new_server()
    srv.listen(addr + "") or (err) {
        println("fatext-server: listen failed: " + err.msg())
        << 1
    }
    println("fatext-server listening on http://" + addr + " (data=" + data_dir + ", pow=" + str(pow_bits) + ")")

    $running := true
    while running {
        fd := srv.accept() or (err) {
            ->
        }
        dispatch($&st, fd)
    }
    << 0
}
