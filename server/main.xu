@main

#net
#os
#os/signal
#strconv
#strings
#time

fn getenv_or(key string, fallback string) string {
    v := os.getenv(key)
    if v.len > 0 { << v }
    << fallback
}

fn getenv_int_or(key string, fallback int) int {
    v := os.getenv(key)
    if v.len == 0 { << fallback }
    $n := 0
    for i in 0:v.len {
        c := v[i] & 255
        if c < 48 || c > 57 { << fallback }
        n = n * 10 + (c - 48)
    }
    << n
}

fn close_raw_fd_quiet(fd int) {
    if fd >= 0 {
        _ := net.conn_close(fd) or (err) { << }
    }
}

fn empty_req() HttpReq {
    << HttpReq{req_method: "", req_path: "", hdr_names: []string{}, hdr_vals: []string{}, req_body: "", remote_ip: ""}
}

fn handle_connection(fd int, tls_on bool, cert_pem string, key_pem string, jobs chan HubJob) {
    cc_disable_sigpipe(fd)
    $cc := cc_from_tcp(fd, "127.0.0.1")
    if tls_on {
        cc = cc_from_tls(fd, &cert_pem, &key_pem, "127.0.0.1") or (err) {
            close_raw_fd_quiet(fd)
            <<
        }
    }

    req := read_http_request($&cc) or (err) {
        r := err_resp(400, "ERR_BAD_REQUEST", err.msg(), 0, 0, 0)
        _ := write_http_resp($&cc, &r)
        cc_close($&cc)
        <<
    }

    path := path_only(req.path())
    reply_ch := chan HubReply{cap: 1}
    if path == "/v1/stream" {
        jobs <- HubJob{kind: HUB_SSE_SUB, req: req, sse_id: 0, reply_ch: reply_ch}
        rep := <-reply_ch
        if !rep.is_sse {
            _ := write_http_resp($&cc, &rep.resp)
            cc_close($&cc)
            <<
        }
        if write_sse_open($&cc) < 0 {
            unsub_ch := chan HubReply{cap: 1}
            jobs <- HubJob{kind: HUB_SSE_UNSUB, req: empty_req(), sse_id: rep.sse_id, reply_ch: unsub_ch}
            _ := <-unsub_ch
            cc_close($&cc)
            <<
        }
        tick := time.new_ticker(250000000)
        $ping_ticks := 0
        $alive := true
        while alive {
            select {
                msg := <-rep.sse_ch {
                    if msg == SSE_CTRL_CLOSE {
                        disc := "event: system\ndata: {\"kind\":\"disconnected\"}\n\n"
                        _ := cc_write($&cc, &disc)
                        alive = false
                    } else if cc_peer_closed(&cc) || cc_write($&cc, &msg) < 0 {
                        alive = false
                    }
                }
                _ := <-tick.c {
                    if cc_peer_closed(&cc) {
                        alive = false
                    } else {
                        ping_ticks += 1
                        if ping_ticks >= 100 {
                            ping_ticks = 0
                            ping := ": ping\n\n"
                            if cc_write($&cc, &ping) < 0 {
                                alive = false
                            }
                        }
                    }
                }
            }
        }
        tick.stop()
        unsub_ch := chan HubReply{cap: 1}
        jobs <- HubJob{kind: HUB_SSE_UNSUB, req: empty_req(), sse_id: rep.sse_id, reply_ch: unsub_ch}
        _ := <-unsub_ch
        cc_close($&cc)
        <<
    }

    jobs <- HubJob{kind: HUB_HTTP, req: req, sse_id: 0, reply_ch: reply_ch}
    rep := <-reply_ch
    _ := write_http_resp($&cc, &rep.resp)
    cc_close($&cc)
}

fn handle_redirect_conn(fd int, https_host string) {
    cc_disable_sigpipe(fd)
    $cc := cc_from_tcp(fd, "127.0.0.1")
    req := read_http_request($&cc) or (err) {
        cc_close($&cc)
        <<
    }
    $host := strings.trim_space(&req.header("Host"))
    if host.len == 0 { host = https_host + "" }
    loc := "https://" + host + req.path()
    body := "Redirecting to " + loc + "\n"
    r := http_resp(301, "text/plain; charset=utf-8", "Location: " + loc + "\r\n", &body)
    _ := write_http_resp($&cc, &r)
    cc_close($&cc)
}

fn redirect_loop(redir_addr string, https_host string) {
    lfd := net.listen(redir_addr + "") or (err) {
        println("fatext-server: redirect listen failed: " + err.msg())
        <<
    }
    while true {
        fd := net.accept(lfd) or (err) { -> }
        xu handle_redirect_conn(fd, https_host + "")
    }
}

fn ignore_sigpipe_quiet() {
    _ := signal.ignore(signal.SIGPIPE) or (err) { << }
}

fn main() int {
    ignore_sigpipe_quiet()
    addr := getenv_or("FATEXT_ADDR", "127.0.0.1:8080")
    data_dir := getenv_or("FATEXT_DATA_DIR", "/var/lib/fatext")
    www_dir := getenv_or("FATEXT_WWW_DIR", "/Users/jay/Documents/work/xulang-org/fatext/www")
    tpl_dir := getenv_or("FATEXT_TEMPLATES_DIR", "/Users/jay/Documents/work/xulang-org/fatext/templates")
    dl_dir := getenv_or("FATEXT_DL_DIR", data_dir + "/dl")
    pow_bits := getenv_int_or("FATEXT_POW_BITS", 20)
    mail_secret := os.getenv("FATEXT_MAIL_INTERNAL_SECRET")
    ip_rpm := getenv_int_or("FATEXT_IP_RPM", 600)
    tls_cert_path := os.getenv("FATEXT_TLS_CERT")
    tls_key_path := os.getenv("FATEXT_TLS_KEY")
    redir_addr := os.getenv("FATEXT_HTTP_REDIRECT_ADDR")

    $tls_on := false
    $cert_pem := ""
    $key_pem := ""
    if tls_cert_path.len > 0 && tls_key_path.len > 0 {
        cert_pem = os.read(tls_cert_path + "") or (err) {
            println("fatext-server: failed reading FATEXT_TLS_CERT: " + err.msg())
            << 1
        }
        key_pem = os.read(tls_key_path + "") or (err) {
            println("fatext-server: failed reading FATEXT_TLS_KEY: " + err.msg())
            << 1
        }
        tls_on = true
    }

    $st := new_state(addr + "", data_dir + "", www_dir + "", tpl_dir + "", dl_dir + "", pow_bits, mail_secret + "", ip_rpm)
    init_state($&st)
    hub := new_hub_state(st)
    jobs := chan HubJob{cap: 128}
    xu hub_loop(hub, jobs)

    if tls_on && redir_addr.len > 0 {
        xu redirect_loop(redir_addr + "", "fatext.com")
    }

    lfd := net.listen(addr + "") or (err) {
        println("fatext-server: listen failed: " + err.msg())
        << 1
    }
    $scheme := "http"
    if tls_on { scheme = "https" }
    println("fatext-server listening on " + scheme + "://" + addr + " (data=" + data_dir + ", pow=" + str(pow_bits) + ")")

    while true {
        fd := net.accept(lfd) or (err) { -> }
        xu handle_connection(fd, tls_on, cert_pem + "", key_pem + "", jobs)
    }
    << 0
}
