@main

#errors
#crypto/tls
#net
#os
#strconv
#strings
#time

pub struct ClientConn {
    pub is_tls bool
    pub fd int
    pub tc tls.Conn
    pub remote_ip string
    pub buf string
}

fn tls_read_q(tc $&tls.Conn, n int) string {
    << tc.read(n) or >>
}

fn tls_write_q(tc $&tls.Conn, data &string) int {
    << tc.write(data) or >>
}

fn tls_close_q(tc $&tls.Conn) {
    tc.close() or (err) { << }
}

fn tls_set_deadline_q(tc $&tls.Conn, dl int) {
    _ := tc.set_deadline(dl) or (err) { << }
}

fn net_set_deadline_q(nc $&net.Conn, dl int) {
    _ := nc.set_deadline(dl) or (err) { << }
}

pub fn cc_from_tcp(fd int, remote_ip string) ClientConn {
    << ClientConn{
        is_tls: false,
        fd: fd,
        tc: tls.closed_conn(),
        remote_ip: remote_ip,
        buf: ""
    }
}

pub fn cc_from_tls(fd int, cert_pem &string, key_pem &string, remote_ip string, hs_timeout_ns int) ClientConn {
    $cfg := tls.new_config("")
    cfg.cert_pem = cert_pem + ""
    cfg.key_pem = key_pem + ""
    $nc := net.file_conn(fd) or >>
    if hs_timeout_ns > 0 {
        net_set_deadline_q($&nc, time.now() + hs_timeout_ns)
    }
    $tc := tls.server(nc, &cfg) or >>
    if hs_timeout_ns > 0 {
        tls_set_deadline_q($&tc, 0)
    }
    << ClientConn{
        is_tls: true,
        fd: fd,
        tc: tc,
        remote_ip: remote_ip,
        buf: ""
    }
}

pub fn cc_set_sock_timeout(cc $&ClientConn, dur_ns int) {
    if cc.is_tls {
        if dur_ns <= 0 {
            tls_set_deadline_q($&cc.tc, 0)
        } else {
            tls_set_deadline_q($&cc.tc, time.now() + dur_ns)
        }
        <<
    }
    if cc.fd >= 0 {
        _ := os.set_sock_timeout(cc.fd, dur_ns) or (err) { << }
    }
}

pub fn cc_read(cc $&ClientConn, max int) string {
    if cc.is_tls {
        << tls_read_q($&cc.tc, max) or >>
    }
    << net.conn_read(cc.fd, max) or >>
}

pub const HTTP_WRITE_TIMEOUT_NS = 15000000000
pub const SSE_WRITE_TIMEOUT_NS = 10000000000

pub fn cc_write(cc $&ClientConn, data &string) int {
    if cc.is_tls {
        << tls_write_q($&cc.tc, data) or (err) { << -1 }
    }
    << net.conn_write(cc.fd, data) or (err) { << -1 }
}

pub fn cc_write_timeout(cc $&ClientConn, data &string, dur_ns int) int {
    if dur_ns > 0 {
        cc_set_sock_timeout(cc, dur_ns)
    }
    rc := cc_write(cc, data)
    if dur_ns > 0 {
        cc_set_sock_timeout(cc, 0)
    }
    << rc
}

// SO_NOSIGPIPE is a macOS socket option. The process also ignores SIGPIPE.
pub fn cc_disable_sigpipe(fd int) {
    if fd < 0 { << }
    _ := os.setsockopt_int(fd, 65535, 4130, 1) or (err) { << }
}

pub fn cc_peer_closed(cc &ClientConn) bool {
    if cc.fd < 0 { << true }
    mask := os.socket_wait(cc.fd, 1, -1) or (err) { << true }
    if cc.is_tls {
        << (mask & 12) != 0
    }
    << (mask & 13) != 0
}

pub fn cc_close(cc $&ClientConn) {
    if cc.is_tls {
        tls_close_q($&cc.tc)
        cc.fd = -1
        <<
    }
    if cc.fd >= 0 {
        _ := net.conn_close(cc.fd) or (err) { << }
        cc.fd = -1
    }
}

pub struct HttpReq {
    pub req_method string
    pub req_path string
    pub hdr_names []string
    pub hdr_vals []string
    pub req_body string
    pub remote_ip string
    pub peer_ip string
}

pub fn (r &HttpReq) method() string {
    << r.req_method + ""
}

pub fn (r &HttpReq) path() string {
    << r.req_path + ""
}

pub fn (r &HttpReq) body() string {
    << r.req_body + ""
}

pub fn (r &HttpReq) header(name string) string {
    want := strings.to_lower(&name)
    for i in 0:r.hdr_names.len {
        if r.hdr_names[i] == want {
            << r.hdr_vals[i] + ""
        }
    }
    << ""
}

pub fn (r &HttpReq) header_all(name string) string {
    want := strings.to_lower(&name)
    $vals := []string{}
    for i in 0:r.hdr_names.len {
        if r.hdr_names[i] == want && r.hdr_vals[i].len > 0 {
            vals.push(r.hdr_vals[i] + "")
        }
    }
    if vals.len == 0 { << "" }
    << strings.join(vals, ", ")
}

pub struct HttpResp {
    pub status int
    pub ctype string
    pub extra string
    pub body string
}

pub fn http_resp(status int, ctype string, extra string, body &string) HttpResp {
    << HttpResp{status: status, ctype: ctype, extra: extra, body: body + ""}
}

pub fn json_resp(status int, body string) HttpResp {
    << HttpResp{status: status, ctype: "application/json; charset=utf-8", extra: "", body: body}
}

fn http_reason(status int) string {
    if status == 200 { << "OK" }
    if status == 201 { << "Created" }
    if status == 202 { << "Accepted" }
    if status == 204 { << "No Content" }
    if status == 422 { << "Unprocessable Content" }
    if status == 301 { << "Moved Permanently" }
    if status == 400 { << "Bad Request" }
    if status == 401 { << "Unauthorized" }
    if status == 403 { << "Forbidden" }
    if status == 404 { << "Not Found" }
    if status == 405 { << "Method Not Allowed" }
    if status == 408 { << "Request Timeout" }
    if status == 409 { << "Conflict" }
    if status == 413 { << "Payload Too Large" }
    if status == 429 { << "Too Many Requests" }
    if status == 503 { << "Service Unavailable" }
    << "Internal Server Error"
}

pub fn format_http_resp_ka_tls_head(r &HttpResp, keep_alive bool, is_tls bool, omit_body bool) string {
    $out := "HTTP/1.1 " + strconv.itoa(r.status) + " " + http_reason(r.status) + "\r\n"
    out = out + "Content-Type: " + r.ctype + "\r\n"
    out = out + "Content-Length: " + strconv.itoa(r.body.len) + "\r\n"
    out = out + "X-Content-Type-Options: nosniff\r\n"
    out = out + "X-Frame-Options: DENY\r\n"
    out = out + "Referrer-Policy: no-referrer\r\n"
    if strings.has_prefix(&r.ctype, "text/html") && !strings.has_prefix(&r.extra, "Content-Security-Policy: ") {
        out = out + "Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'\r\n"
    }
    if is_tls {
        out = out + "Strict-Transport-Security: max-age=31536000; includeSubDomains\r\n"
    }
    if r.extra.len > 0 {
        out = out + r.extra
    }
    if keep_alive {
        out = out + "Connection: keep-alive\r\nKeep-Alive: timeout=15, max=200\r\n\r\n"
    } else {
        out = out + "Connection: close\r\n\r\n"
    }
    if !omit_body {
        out = out + r.body
    }
    << out
}

pub fn format_http_resp_ka_tls(r &HttpResp, keep_alive bool, is_tls bool) string {
    << format_http_resp_ka_tls_head(r, keep_alive, is_tls, false)
}

pub fn format_http_resp_ka(r &HttpResp, keep_alive bool) string {
    << format_http_resp_ka_tls(r, keep_alive, false)
}

pub fn format_http_resp(r &HttpResp) string {
    << format_http_resp_ka(r, false)
}

pub fn write_http_resp_ka_head(cc $&ClientConn, r &HttpResp, keep_alive bool, omit_body bool) int {
    wire := format_http_resp_ka_tls_head(r, keep_alive, cc.is_tls, omit_body)
    << cc_write_timeout(cc, &wire, HTTP_WRITE_TIMEOUT_NS)
}

pub fn write_http_resp_ka(cc $&ClientConn, r &HttpResp, keep_alive bool) int {
    << write_http_resp_ka_head(cc, r, keep_alive, false)
}

pub fn write_http_resp(cc $&ClientConn, r &HttpResp) int {
    << write_http_resp_ka(cc, r, false)
}

pub fn wants_keep_alive(req &HttpReq) bool {
    conn_h := strings.to_lower(&req.header("Connection"))
    if strings.contains(&conn_h, "close") { << false }
    << true
}

pub fn write_sse_open(cc $&ClientConn) int {
    hdr := "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nX-Accel-Buffering: no\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n: connected\n\n"
    << cc_write_timeout(cc, &hdr, SSE_WRITE_TIMEOUT_NS)
}

fn is_strict_header_name(s &string) bool {
    if s.len == 0 || s.len > 128 { << false }
    for i in 0:s.len {
        c := s[i] & 255
        if c <= 32 || c >= 127 { << false }
    }
    << true
}

fn is_valid_http_method(s &string) bool {
    if s.len == 0 || s.len > 16 { << false }
    for i in 0:s.len {
        c := s[i] & 255
        if c < 65 || c > 90 { << false }
    }
    << true
}

fn is_valid_http_path(s &string) bool {
    if s.len == 0 || s.len > 8192 { << false }
    if (s[0] & 255) != 47 { << false }
    if strings.has_prefix(s, "//") { << false }
    for i in 0:s.len {
        c := s[i] & 255
        if c <= 32 || c >= 127 { << false }
    }
    << true
}

struct BodyFraming {
    ok bool
    is_chunked bool
    clen int
    err_msg string
}

fn framing_err(msg string) BodyFraming {
    << BodyFraming{ok: false, is_chunked: false, clen: 0, err_msg: msg}
}

fn parse_body_framing(names &[]string, vals &[]string) BodyFraming {
    $seen_cl := false
    $seen_te := false
    $cl := 0
    for i in 0:names.len {
        if names[i] == "transfer-encoding" {
            if seen_te { << framing_err("duplicate transfer-encoding") }
            v := strings.to_lower(&strings.trim_space(&vals[i]))
            if v != "chunked" { << framing_err("unsupported transfer-encoding") }
            seen_te = true
        }
        if names[i] == "content-length" {
            if seen_cl { << framing_err("duplicate content-length") }
            v := strings.trim_space(&vals[i])
            if v.len == 0 || v.len > 10 { << framing_err("invalid or oversized content-length") }
            for j in 0:v.len {
                c := v[j] & 255
                if c < 48 || c > 57 { << framing_err("invalid or oversized content-length") }
            }
            n := strconv.atoi(&v) or (err) { << framing_err("invalid or oversized content-length") }
            if n < 0 { << framing_err("invalid or oversized content-length") }
            seen_cl = true
            cl = n
        }
    }
    if seen_te && seen_cl {
        << framing_err("conflicting transfer-encoding and content-length")
    }
    if seen_te {
        << BodyFraming{ok: true, is_chunked: true, clen: 0, err_msg: ""}
    }
    if cl > 262144 {
        << framing_err("invalid or oversized content-length")
    }
    << BodyFraming{ok: true, is_chunked: false, clen: cl, err_msg: ""}
}

struct ChunkLineRes {
    ok bool
    is_timeout bool
    err_msg string
    line string
    rest string
}

fn read_chunk_crlf_line(cc $&ClientConn, buf_in string, deadline_ns int, max_len int) ChunkLineRes {
    $buf := buf_in + ""
    while true {
        idx := strings.index_of(&buf, "\r\n")
        if idx >= 0 {
            if idx > max_len {
                << ChunkLineRes{ok: false, is_timeout: false, err_msg: "chunk line too large", line: "", rest: ""}
            }
            ln := buf[0:idx] + ""
            $rem := ""
            if idx + 2 < buf.len {
                rem = buf[(idx + 2):buf.len] + ""
            }
            << ChunkLineRes{ok: true, is_timeout: false, err_msg: "", line: ln, rest: rem}
        }
        if buf.len > max_len {
            << ChunkLineRes{ok: false, is_timeout: false, err_msg: "chunk line too large", line: "", rest: ""}
        }
        if deadline_ns > 0 {
            rem_ns := deadline_ns - time.now()
            if rem_ns <= 0 {
                << ChunkLineRes{ok: false, is_timeout: true, err_msg: "request body read timeout", line: "", rest: ""}
            }
            cc_set_sock_timeout(cc, rem_ns)
        }
        chunk := cc_read(cc, 4096) or (err) {
            emsg := err.msg()
            if is_read_timeout_err(&emsg) {
                << ChunkLineRes{ok: false, is_timeout: true, err_msg: "request body read timeout", line: "", rest: ""}
            }
            << ChunkLineRes{ok: false, is_timeout: false, err_msg: emsg, line: "", rest: ""}
        }
        if chunk.len == 0 {
            << ChunkLineRes{ok: false, is_timeout: false, err_msg: "unexpected eof reading chunked body", line: "", rest: ""}
        }
        buf = buf + chunk
    }
    << ChunkLineRes{ok: false, is_timeout: false, err_msg: "chunk line error", line: "", rest: ""}
}

fn trim_ows(s &string) string {
    $start := 0
    while start < s.len {
        c := s[start] & 255
        if c != 32 && c != 9 { <- }
        start += 1
    }
    $end := s.len
    while end > start {
        c := s[end - 1] & 255
        if c != 32 && c != 9 { <- }
        end -= 1
    }
    if start >= end { << "" }
    << s[start:end] + ""
}

fn parse_chunk_size_hex_strict(line &string) int {
    semi := strings.index_of(line, ";")
    $raw := *line + ""
    if semi >= 0 {
        raw = line[0:semi] + ""
    }
    s := trim_ows(&raw)
    if s.len == 0 || s.len > 8 { << -1 }
    $val := 0
    for i in 0:s.len {
        c := s[i] & 255
        $d := -1
        if c >= 48 && c <= 57 { d = c - 48 }
        else if c >= 97 && c <= 102 { d = 10 + (c - 97) }
        else if c >= 65 && c <= 70 { d = 10 + (c - 65) }
        if d < 0 { << -1 }
        val = val * 16 + d
    }
    << val
}

struct ChunkBodyRes {
    ok bool
    is_timeout bool
    err_msg string
    body string
    rest string
}

fn chunk_body_err(is_timeout bool, msg string) ChunkBodyRes {
    << ChunkBodyRes{ok: false, is_timeout: is_timeout, err_msg: msg, body: "", rest: ""}
}

fn read_chunked_body(cc $&ClientConn, rest_in string, deadline_ns int) ChunkBodyRes {
    $rest := rest_in + ""
    $decoded := ""
    while true {
        sz_res := read_chunk_crlf_line(cc, rest, deadline_ns, 1024)
        if !sz_res.ok {
            << chunk_body_err(sz_res.is_timeout, sz_res.err_msg + "")
        }
        rest = sz_res.rest + ""
        chunk_sz := parse_chunk_size_hex_strict(&sz_res.line)
        if chunk_sz < 0 {
            << chunk_body_err(false, "invalid chunk size")
        }
        if chunk_sz == 0 {
            $trailer_lines := 0
            $trailer_bytes := 0
            while true {
                tlr := read_chunk_crlf_line(cc, rest, deadline_ns, 1024)
                if !tlr.ok {
                    << chunk_body_err(tlr.is_timeout, tlr.err_msg + "")
                }
                rest = tlr.rest + ""
                if tlr.line.len == 0 {
                    <-
                }
                trailer_lines += 1
                trailer_bytes += tlr.line.len + 2
                if trailer_lines > 32 || trailer_bytes > 4096 {
                    << chunk_body_err(false, "chunk trailers too large")
                }
                col := strings.index_of(&tlr.line, ":")
                if col <= 0 {
                    << chunk_body_err(false, "malformed chunk trailer")
                }
                k_raw := tlr.line[0:col] + ""
                if !is_strict_header_name(&k_raw) {
                    << chunk_body_err(false, "invalid chunk trailer name")
                }
            }
            <-
        }
        if decoded.len + chunk_sz > 262144 {
            << chunk_body_err(false, "chunked body too large")
        }
        need_bytes := chunk_sz + 2
        while rest.len < need_bytes {
            want := need_bytes - rest.len
            $rmax := 8192
            if want < rmax { rmax = want }
            if deadline_ns > 0 {
                rem_ns := deadline_ns - time.now()
                if rem_ns <= 0 {
                    << chunk_body_err(true, "request body read timeout")
                }
                cc_set_sock_timeout(cc, rem_ns)
            }
            chunk := cc_read(cc, rmax) or (err) {
                emsg := err.msg()
                if is_read_timeout_err(&emsg) {
                    << chunk_body_err(true, "request body read timeout")
                }
                << chunk_body_err(false, emsg)
            }
            if chunk.len == 0 {
                << chunk_body_err(false, "unexpected eof reading chunked body")
            }
            rest = rest + chunk
        }
        if (rest[chunk_sz] & 255) != 13 || (rest[chunk_sz + 1] & 255) != 10 {
            << chunk_body_err(false, "malformed chunk terminator")
        }
        decoded = decoded + rest[0:chunk_sz]
        if need_bytes < rest.len {
            rest = rest[need_bytes:rest.len] + ""
        } else {
            rest = ""
        }
    }
    << ChunkBodyRes{ok: true, is_timeout: false, err_msg: "", body: decoded, rest: rest}
}

pub struct ReadReqMeta {
    pub ok bool
    pub idle_closed bool
    pub is_timeout bool
    pub err_msg string
}

fn empty_http_req() HttpReq {
    << HttpReq{req_method: "", req_path: "", hdr_names: []string{}, hdr_vals: []string{}, req_body: "", remote_ip: "", peer_ip: ""}
}

fn read_fail_meta(is_timeout bool, msg string) ReadReqMeta {
    << ReadReqMeta{ok: false, idle_closed: false, is_timeout: is_timeout, err_msg: msg}
}

fn read_idle_meta() ReadReqMeta {
    << ReadReqMeta{ok: false, idle_closed: true, is_timeout: false, err_msg: ""}
}

fn is_read_timeout_err(msg &string) bool {
    low := strings.to_lower(msg)
    << strings.contains(&low, "resource temporarily unavailable") ||
        strings.contains(&low, "i/o timeout") ||
        strings.contains(&low, "timed out") ||
        strings.contains(&low, "timeout")
}

fn is_idle_disconnect_err(msg &string) bool {
    if is_read_timeout_err(msg) { << true }
    low := strings.to_lower(msg)
    << low == "eof reading request" ||
        low == "tls: eof" ||
        strings.contains(&low, "connection reset") ||
        strings.contains(&low, "broken pipe")
}

fn has_expect_100_continue(names &[]string, vals &[]string) bool {
    for i in 0:names.len {
        if names[i] == "expect" {
            v := strings.to_lower(&strings.trim_space(&vals[i]))
            if v == "100-continue" { << true }
        }
    }
    << false
}

pub fn read_http_request_split(cc $&ClientConn, idle_timeout_ns int, read_timeout_ns int, out_req $&HttpReq) ReadReqMeta {
    $saw_bytes := cc.buf.len > 0
    $deadline_ns := 0
    $idle_deadline_ns := 0
    if saw_bytes {
        if read_timeout_ns > 0 {
            deadline_ns = time.now() + read_timeout_ns
            cc_set_sock_timeout(cc, read_timeout_ns)
        } else {
            cc_set_sock_timeout(cc, 0)
        }
    } else {
        if idle_timeout_ns > 0 {
            idle_deadline_ns = time.now() + idle_timeout_ns
            cc_set_sock_timeout(cc, idle_timeout_ns)
        } else {
            cc_set_sock_timeout(cc, 0)
        }
    }
    $hdr_end := -1
    while hdr_end < 0 {
        idx := strings.index_of(&cc.buf, "\r\n\r\n")
        if idx >= 0 {
            hdr_end = idx
            <-
        }
        if cc.buf.len > 16384 {
            cc_set_sock_timeout(cc, 0)
            << read_fail_meta(false, "header too large")
        }
        if saw_bytes {
            if deadline_ns > 0 {
                rem := deadline_ns - time.now()
                if rem <= 0 {
                    cc_set_sock_timeout(cc, 0)
                    << read_fail_meta(true, "request read timeout")
                }
                cc_set_sock_timeout(cc, rem)
            }
        } else if idle_deadline_ns > 0 {
            rem_idle := idle_deadline_ns - time.now()
            if rem_idle <= 0 {
                cc_set_sock_timeout(cc, 0)
                << read_idle_meta()
            }
            cc_set_sock_timeout(cc, rem_idle)
        }
        chunk := cc_read(cc, 4096) or (err) {
            emsg := err.msg()
            cc_set_sock_timeout(cc, 0)
            if !saw_bytes && is_idle_disconnect_err(&emsg) {
                << read_idle_meta()
            }
            if is_read_timeout_err(&emsg) {
                << read_fail_meta(true, "request read timeout")
            }
            << read_fail_meta(false, emsg)
        }
        if chunk.len == 0 {
            cc_set_sock_timeout(cc, 0)
            if !saw_bytes {
                << read_idle_meta()
            }
            << read_fail_meta(false, "eof reading request")
        }
        if !saw_bytes {
            saw_bytes = true
            if read_timeout_ns > 0 {
                deadline_ns = time.now() + read_timeout_ns
            }
        }
        cc.buf = cc.buf + chunk
    }
    if hdr_end > 16384 {
        cc_set_sock_timeout(cc, 0)
        << read_fail_meta(false, "header too large")
    }
    head_s := cc.buf[0:hdr_end]
    $rest := ""
    if hdr_end + 4 < cc.buf.len {
        rest = cc.buf[(hdr_end + 4):cc.buf.len]
    }
    cc.buf = ""

    lines := strings.split(&head_s, "\r\n")
    if lines.len == 0 || lines.len > 129 {
        cc_set_sock_timeout(cc, 0)
        << read_fail_meta(false, "empty or oversized header block")
    }
    req_parts := strings.split(&lines[0], " ")
    if req_parts.len != 3 {
        cc_set_sock_timeout(cc, 0)
        << read_fail_meta(false, "malformed request line")
    }
    meth := strings.to_upper(&strings.trim_space(&req_parts[0]))
    rpath := req_parts[1] + ""
    proto := strings.trim_space(&req_parts[2])
    if !is_valid_http_method(&meth) || !is_valid_http_path(&rpath) || (proto != "HTTP/1.1" && proto != "HTTP/1.0") {
        cc_set_sock_timeout(cc, 0)
        << read_fail_meta(false, "invalid request target or protocol")
    }

    $hnames := []string{}
    $hvals := []string{}
    for i in 1:lines.len {
        ln := lines[i] + ""
        if ln.len == 0 { -> }
        col := strings.index_of(&ln, ":")
        if col <= 0 {
            cc_set_sock_timeout(cc, 0)
            << read_fail_meta(false, "malformed header")
        }
        k_raw := ln[0:col] + ""
        if !is_strict_header_name(&k_raw) {
            cc_set_sock_timeout(cc, 0)
            << read_fail_meta(false, "invalid header name")
        }
        k := strings.to_lower(&k_raw)
        $v := ""
        if col + 1 < ln.len {
            v = strings.trim_space(&ln[(col + 1):ln.len])
        }
        hnames.push(k)
        hvals.push(v)
    }

    framing := parse_body_framing(&hnames, &hvals)
    if !framing.ok {
        cc_set_sock_timeout(cc, 0)
        << read_fail_meta(false, framing.err_msg + "")
    }
    $body := ""
    if framing.is_chunked {
        if rest.len == 0 && proto == "HTTP/1.1" && has_expect_100_continue(&hnames, &hvals) {
            cont := "HTTP/1.1 100 Continue\r\n\r\n"
            if cc_write_timeout(cc, &cont, 2000000000) < 0 {
                cc_set_sock_timeout(cc, 0)
                << read_fail_meta(false, "failed writing 100 Continue")
            }
        }
        cb := read_chunked_body(cc, rest, deadline_ns)
        if !cb.ok {
            cc_set_sock_timeout(cc, 0)
            << read_fail_meta(cb.is_timeout, cb.err_msg + "")
        }
        body = cb.body
        cc.buf = cb.rest
    } else {
        clen := framing.clen
        if clen > 0 && rest.len < clen && proto == "HTTP/1.1" && has_expect_100_continue(&hnames, &hvals) {
            cont := "HTTP/1.1 100 Continue\r\n\r\n"
            if cc_write_timeout(cc, &cont, 2000000000) < 0 {
                cc_set_sock_timeout(cc, 0)
                << read_fail_meta(false, "failed writing 100 Continue")
            }
        }
        while rest.len < clen {
            need := clen - rest.len
            $rmax := 8192
            if need < rmax { rmax = need }
            if deadline_ns > 0 {
                rem := deadline_ns - time.now()
                if rem <= 0 {
                    cc_set_sock_timeout(cc, 0)
                    << read_fail_meta(true, "request body read timeout")
                }
                cc_set_sock_timeout(cc, rem)
            }
            chunk := cc_read(cc, rmax) or (err) {
                emsg := err.msg()
                cc_set_sock_timeout(cc, 0)
                if is_read_timeout_err(&emsg) {
                    << read_fail_meta(true, "request body read timeout")
                }
                << read_fail_meta(false, emsg)
            }
            if chunk.len == 0 {
                cc_set_sock_timeout(cc, 0)
                << read_fail_meta(false, "unexpected eof reading body")
            }
            rest = rest + chunk
        }
        if rest.len > clen {
            body = rest[0:clen]
            cc.buf = rest[clen:rest.len]
        } else {
            body = rest
            cc.buf = ""
        }
    }
    cc_set_sock_timeout(cc, 0)
    out_req.req_method = meth
    out_req.req_path = rpath
    out_req.hdr_names = hnames
    out_req.hdr_vals = hvals
    out_req.req_body = body
    out_req.remote_ip = cc.remote_ip + ""
    out_req.peer_ip = cc.remote_ip + ""
    << ReadReqMeta{ok: true, idle_closed: false, is_timeout: false, err_msg: ""}
}

pub fn read_http_request_timeout(cc $&ClientConn, timeout_ns int) HttpReq {
    $req := empty_http_req()
    rr := read_http_request_split(cc, timeout_ns, timeout_ns, $&req)
    if !rr.ok {
        if rr.idle_closed {
            >> errors.new("eof reading request")
        }
        >> errors.new(rr.err_msg + "")
    }
    << req
}

pub fn read_http_request(cc $&ClientConn) HttpReq {
    << read_http_request_timeout(cc, 10000000000) or >>
}

pub fn read_req_into(cc $&ClientConn, timeout_ns int, out_errs $&[]string) HttpReq {
    << read_http_request_timeout(cc, timeout_ns) or (err) {
        out_errs.push(err.msg())
        << empty_http_req()
    }
}
