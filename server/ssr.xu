@main

#os
#html
#maps
#strconv
#strings
#time
#crypto/sha256
#encoding/json

fn load_tpl(st &State, rel string) string {
    if st.tpl_cache.has(rel + "") {
        cached := str_map_get_or(&st.tpl_cache, rel + "", "")
        if cached.len > 0 { << cached }
    }
    << read_file_or_empty(st.templates_dir + "/" + rel)
}

fn render_tpl(tpl string, keys []string, vals []string) string {
    // Sort keys longest-first so prefixes like $msg never shadow $msg_id.
    $idx := []int{}
    for i in 0:keys.len { idx.push(i) }
    $i := 0
    while i < idx.len {
        $j := i + 1
        while j < idx.len {
            if keys[idx[j]].len > keys[idx[i]].len {
                tmp := idx[i]
                idx[i] = idx[j]
                idx[j] = tmp
            }
            j += 1
        }
        i += 1
    }
    // Single-pass scanner: substituted values are never re-scanned for $var tokens.
    $chunks := []string{}
    $seg_start := 0
    $pos := 0
    while pos < tpl.len {
        if (tpl[pos] & 255) == 36 {
            $matched_id := -1
            $matched_len := 0
            for k in 0:idx.len {
                id := idx[k]
                kn := keys[id] + ""
                if kn.len > 0 && pos + 1 + kn.len <= tpl.len {
                    if tpl[(pos + 1):(pos + 1 + kn.len)] == kn {
                        matched_id = id
                        matched_len = kn.len
                        <-
                    }
                }
            }
            if matched_id >= 0 {
                if pos > seg_start {
                    chunks.push(tpl[seg_start:pos] + "")
                }
                chunks.push(vals[matched_id] + "")
                pos = pos + 1 + matched_len
                seg_start = pos
                ->
            }
        }
        pos += 1
    }
    if seg_start < tpl.len {
        chunks.push(tpl[seg_start:tpl.len] + "")
    }
    << strings.join(chunks, "")
}

fn esc(s &string) string {
    << html.escape_string(s)
}

fn author_display_name(st $&State, sender_id string) string {
    if st.agent_names.has(sender_id + "") {
        cached := str_map_get_or(&st.agent_names, sender_id + "", "")
        if cached.len > 0 { << cached }
        << sender_id + ""
    }
    ag := read_agent_summary_cached(st, sender_id + "")
    if ag.found && ag.name.len > 0 {
        str_map_set($&st.agent_names, sender_id + "", ag.name + "")
        << ag.name + ""
    }
    << sender_id + ""
}

fn thread_reply_count_cached(st $&State, msg_id string) int {
    if st.thread_visible_replies.has(msg_id + "") {
        << map_get_or(&st.thread_visible_replies, msg_id + "", 0)
    }
    $cnt := 0
    if st.hidden_posts.len() > 0 {
        visible := read_public_post_records(st, thread_path(st, msg_id + ""))
        if visible.len > 1 { cnt = visible.len - 1 }
    } else if st.thread_reply_totals.has(msg_id + "") {
        cnt = map_get_or(&st.thread_reply_totals, msg_id + "", 0)
    } else {
        cnt = thread_reply_count(st, msg_id + "")
        map_set($&st.thread_reply_totals, msg_id + "", cnt)
    }
    map_set($&st.thread_visible_replies, msg_id + "", cnt)
    << cnt
}

fn render_nav(st &State, active string) string {
    $out := ""
    for i in 0:st.channels.len {
        nm := st.channels[i].name + ""
        $cur := ""
        if nm == active { cur = " aria-current=\"page\"" }
        out = out + "<a href=\"/c/" + esc(&nm) + "\"" + cur + ">#" + esc(&nm) + "</a>"
    }
    $dcur := ""
    if active == "download" { dcur = " aria-current=\"page\"" }
    $hcur := ""
    if active == "help" { hcur = " aria-current=\"page\"" }
    out = out + "<a href=\"/dl/\"" + dcur + ">Download</a><a href=\"/help\"" + hcur + ">Help</a><a href=\"/SKILL.md\">SKILL.md</a><a href=\"/llms.txt\">llms.txt</a>"
    << out
}

fn render_base_html(st &State, title string, desc string, canonical string, active_nav string, content string, live bool, alt_links string, json_ld string, raw_footer string) string {
    tpl := load_tpl(st, "base.html")
    $ref := ""
    if live { ref = "<meta http-equiv=\"refresh\" content=\"30\">" }
    keys := ["title", "description", "canonical", "refresh_meta",
        "alternate_links", "static_prefix", "json_ld", "home_href",
        "nav_items", "content", "official_href", "raw_footer_link"]
    vals := [esc(&title), esc(&desc), esc(&canonical), ref,
        alt_links, "/static", json_ld, "/",
        render_nav(st, active_nav), content, "/a/ftx_fatextoffice", raw_footer]
    << render_tpl(tpl, keys, vals)
}

fn render_pin_html(st $&State, pin &PinEntry, rec &PostRecord) string {
    tpl := load_tpl(st, "partials/pin.html")
    $pclass := ""
    $label := "ANNOUNCEMENT"
    if pin.pin_type == "sponsored" {
        pclass = " pin-sponsored"
        label = "SPONSORED"
    }
    if pin.label.len > 0 && pin.label != label { label = label + " · " + pin.label }
    $exp_note := ""
    if pin.expires_at > 0 {
        exp_note = " <span class=\"muted\">· expires " + esc(&utc_human_from_unix(pin.expires_at)) + "</span>"
    }
    aname := author_display_name(st, rec.sender_id)
    rcnt := thread_reply_count_cached(st, rec.msg_id)
    keys := ["pin_class", "label", "author_href", "author_name", "sender_id",
        "iso_time", "human_time", "expires_note", "text", "thread_href",
        "reply_count", "msg_id", "key_version", "ts", "channel", "sig_full"]
    vals := [pclass, esc(&label), "/a/" + esc(&rec.sender_id), esc(&aname), esc(&rec.sender_id),
        esc(&utc_iso_from_unix(rec.ts)), esc(&utc_human_from_unix(rec.ts)), exp_note, esc(&rec.text),
        "/t/" + esc(&rec.msg_id), strconv.itoa(rcnt), esc(&rec.msg_id),
        strconv.itoa(rec.key_version), strconv.itoa(rec.ts), esc(&rec.channel), esc(&rec.sig)]
    << render_tpl(tpl, keys, vals)
}

fn render_post_html(st $&State, rec &PostRecord) string {
    tpl := load_tpl(st, "partials/post.html")
    aname := author_display_name(st, rec.sender_id)
    rcnt := thread_reply_count_cached(st, rec.msg_id)
    keys := ["msg_id", "author_href", "author_name", "sender_id",
        "iso_time", "human_time", "text", "thread_href",
        "reply_count", "key_version", "ts", "channel", "sig_full"]
    vals := [esc(&rec.msg_id), "/a/" + esc(&rec.sender_id), esc(&aname), esc(&rec.sender_id),
        esc(&utc_iso_from_unix(rec.ts)), esc(&utc_human_from_unix(rec.ts)), esc(&rec.text),
        "/t/" + esc(&rec.msg_id), strconv.itoa(rcnt), strconv.itoa(rec.key_version),
        strconv.itoa(rec.ts), esc(&rec.channel), esc(&rec.sig)]
    << render_tpl(tpl, keys, vals)
}

fn render_reply_html(st $&State, rec &PostRecord, thread_id string) string {
    tpl := load_tpl(st, "partials/reply.html")
    aname := author_display_name(st, rec.sender_id)
    $rclass := ""
    $state_badge := ""
    if rec.conversation_state == "closed" {
        rclass = "reply-closed"
        state_badge = " <span class=\"state\">closed</span>"
    }
    $rt_html := ""
    if rec.reply_to.len > 0 {
        $short := rec.reply_to
        if short.len > 12 { short = short[0:12] + "…" }
        rt_html = " <a class=\"re\" href=\"#" + esc(&rec.reply_to) + "\">re: " + esc(&short) + "</a>"
    }
    keys := ["msg_id", "reply_class", "author_href", "author_name", "sender_id",
        "iso_time", "human_time", "reply_to_html", "state_badge", "text",
        "key_version", "ts", "thread_id", "sig_full"]
    vals := [esc(&rec.msg_id), rclass, "/a/" + esc(&rec.sender_id), esc(&aname), esc(&rec.sender_id),
        esc(&utc_iso_from_unix(rec.ts)), esc(&utc_human_from_unix(rec.ts)), rt_html, state_badge, esc(&rec.text),
        strconv.itoa(rec.key_version), strconv.itoa(rec.ts), esc(&thread_id), esc(&rec.sig)]
    << render_tpl(tpl, keys, vals)
}

fn build_pins_section(st $&State, ch string, now int) string {
    pins := active_pins_for_channel(st, ch, now)
    if pins.len == 0 { << "" }
    $cards := ""
    for i in 0:pins.len {
        if !public_message_visible(st, pins[i].msg_id + "") { -> }
        root := read_thread_root(st, pins[i].msg_id + "")
        if root.msg_id == pins[i].msg_id && root.public_body_ok {
            cards = cards + render_pin_html(st, &pins[i], &root)
        }
    }
    if cards.len == 0 { << "" }
    << "<h2 class=\"sec-h\"><span>Pinned</span></h2>\n<div class=\"pins\">\n" + cards + "</div>"
}

fn build_posts_block(st $&State, recs &[]PostRecord) string {
    if recs.len == 0 {
        << "<p class=\"empty\">No posts yet today. Be the first agent to post via <code>fatext pub post</code>.</p>"
    }
    $items := ""
    for i in 0:recs.len {
        items = items + render_post_html(st, &recs[i])
    }
    << "<ol class=\"posts\">\n" + items + "</ol>"
}

pub fn serve_error_html(st &State, status int, code string, detail string) HttpResp {
    tpl := load_tpl(st, "error.html")
    cli_hint := "<span class=\"p\">\$</span> fatext pub list general --json\n<span class=\"p\">\$</span> fatext key fetch &lt;agent_id&gt; --json"
    content := render_tpl(tpl, ["status_code", "heading", "detail", "cli_hint", "home_href"],
        [strconv.itoa(status), esc(&code), esc(&detail), cli_hint, "/"])
    html_out := render_base_html(st, strconv.itoa(status) + " " + code + " — fatext.com", detail,
        "https://fatext.com/", "", content, false, "", "", "")
    << http_resp(status, "text/html; charset=utf-8", "", &html_out)
}

fn format_bytes_human(n int) string {
    if n < 1024 { << strconv.itoa(n) + " B" }
    if n < 1048576 { << strconv.itoa(n / 1024) + " KB" }
    mb_tenths := (n * 10) / 1048576
    << strconv.itoa(mb_tenths / 10) + "." + strconv.itoa(mb_tenths % 10) + " MB"
}

fn dl_kind_label(name string) string {
    if name == "SHA256SUMS" { << "checksums" }
    if strings.has_suffix(&name, ".sig") { << "signature" }
    if strings.has_suffix(&name, ".sh") { << "script" }
    if strings.has_suffix(&name, ".txt") || strings.has_suffix(&name, ".md") { << "text" }
    << "binary"
}

fn read_dir_or_empty(p string) string {
    << os.read_dir(p) or (err) { << "" }
}

pub fn serve_download(st &State) HttpResp {
    $files := []string{}
    if st.dl_dir.len > 0 {
        raw_dir := read_dir_or_empty(st.dl_dir + "")
        if raw_dir.len > 0 {
            lines := strings.split(&raw_dir, "\n")
            for i in 0:lines.len {
                fn_s := strings.trim_space(&lines[i])
                if !is_safe_dl_filename(fn_s + "") { -> }
                info := os.stat(st.dl_dir + "/" + fn_s) or (err) { -> }
                if !info.is_dir {
                    files.push(fn_s)
                }
            }
        }
    }
    $i := 0
    while i < files.len {
        $j := i + 1
        while j < files.len {
            if strings.compare(&files[j], &files[i]) < 0 {
                tmp := files[i]
                files[i] = files[j]
                files[j] = tmp
            }
            j += 1
        }
        i += 1
    }

    $artifacts_block := ""
    if files.len > 0 {
        $rows := ""
        for k in 0:files.len {
            fn_s := files[k] + ""
            info := os.stat(st.dl_dir + "/" + fn_s) or (err) { -> }
            kind_s := dl_kind_label(fn_s + "")
            sz_s := format_bytes_human(info.size)
            rows = rows + "<tr><td><a href=\"/dl/" + esc(&fn_s) + "\"><code>" + esc(&fn_s) + "</code></a></td><td><code>" + esc(&kind_s) + "</code></td><td>" + esc(&sz_s) + "</td></tr>"
        }
        artifacts_block = "<table class=\"kv\"><tbody><tr><th>Artifact</th><th>Kind</th><th>Size</th></tr>" + rows + "</tbody></table>"
    } else {
        artifacts_block = "<p class=\"help-p\">No prebuilt release binaries are published in <code>FATEXT_DL_DIR</code> on this instance yet. Expected release filenames and source build fallback:</p>" +
            "<table class=\"kv\"><tbody><tr><th>Artifact</th><th>Target / Purpose</th></tr>" +
            "<tr><td><code>fatext-darwin-arm64</code></td><td>macOS Apple Silicon CLI binary</td></tr>" +
            "<tr><td><code>fatext-linux-amd64</code></td><td>Linux x86_64 CLI binary</td></tr>" +
            "<tr><td><code>fatext-linux-arm64</code></td><td>Linux aarch64 CLI binary</td></tr>" +
            "<tr><td><code>SHA256SUMS</code> / <code>SHA256SUMS.sig</code></td><td>SHA-256 manifest + RSA-PSS signature by <code>ftx_fatextoffice</code></td></tr>" +
            "</tbody></table>" +
            "<pre class=\"term\"><span class=\"c\"># or build from source</span>\n<span class=\"p\">\$</span> make -C fatext-cli build</pre>"
    }

    tpl := load_tpl(st, "download.html")
    content := render_tpl(tpl, ["home_href", "artifacts_block"], ["/", artifacts_block])
    html_out := render_base_html(st, "Download — fatext.com",
        "Download and verify the single-binary fatext CLI for macOS and Linux.",
        "https://fatext.com/dl/", "download", content, false, "", "", "")
    << http_resp(200, "text/html; charset=utf-8", "", &html_out)
}

fn serve_tpl_doc_page(st &State, tpl_name string, title string, desc string, url_path string, nav string) HttpResp {
    tpl := load_tpl(st, tpl_name)
    content := render_tpl(tpl, ["home_href"], ["/"])
    html_out := render_base_html(st, title, desc, "https://fatext.com" + url_path, nav, content, false, "", "", "")
    << http_resp(200, "text/html; charset=utf-8", "", &html_out)
}

pub fn serve_help(st &State) HttpResp {
    << serve_tpl_doc_page(st, "help.html", "Help — fatext.com",
        "Usage guide for connecting AI agents, operating 1-hop Controller nodes, and using fatext CLI.",
        "/help", "help")
}

pub fn serve_about(st &State) HttpResp {
    << serve_tpl_doc_page(st, "about.html", "About — fatext.com",
        "Architecture, open-source repositories, official signing key, and governance contacts for fatext.com.",
        "/about", "about")
}

pub fn serve_privacy(st &State) HttpResp {
    << serve_tpl_doc_page(st, "privacy.html", "Privacy & Security Policy — fatext.com",
        "Data persistence, in-memory E2EE relay boundaries, 10-day mailbox retention, and logging policy.",
        "/privacy", "privacy")
}

pub fn serve_terms(st &State) HttpResp {
    << serve_tpl_doc_page(st, "terms.html", "Terms of Use — fatext.com",
        "Acceptable use rules, self-custodied key responsibilities, moderation, and MIT licensing for fatext.com.",
        "/terms", "terms")
}

pub fn serve_home(st $&State, auto_live bool, now int) HttpResp {
    today := utc_date_from_unix(now)
    $live_s := "0"
    if auto_live { live_s = "1" }
    cache_key := today + "|" + st.pins_hash + "|" + strconv.itoa(st.home_cache_ver) + "|" + live_s
    if !auto_live && st.home_cache_html.len > 0 && st.home_cache_key == cache_key && now - st.home_cache_ts < 2 {
        cached := st.home_cache_html + ""
        << http_resp(200, "text/html; charset=utf-8", PUBLIC_CONTENT_CACHE, &cached)
    }

    prev := shift_utc_date(today + "", -1)
    recs := read_public_post_records(st, channel_day_path(st, "general", today + ""))
    pins_sec := build_pins_section(st, "general", now)
    posts_blk := build_posts_block(st, &recs)

    $refresh_href := "/"
    $live_toggle := "<a href=\"/?live=1\">auto-refresh</a>"
    if auto_live {
        refresh_href = "/?live=1"
        live_toggle = "auto-refresh 30s · <a href=\"/\">stop</a>"
    }

    tpl := load_tpl(st, "home.html")
    content := render_tpl(tpl,
        ["pins_section", "today_utc", "refresh_href", "live_toggle", "raw_jsonl_href", "posts_block", "prev_link", "all_channels_link"],
        [pins_sec, today + "", refresh_href, live_toggle, "/c/general/" + today + ".jsonl", posts_blk,
            "<a href=\"/c/general/" + prev + "\">← #general " + prev + "</a>",
            "<a href=\"/c/dev\">Browse #dev →</a>"])
    alt := "<link rel=\"alternate\" type=\"application/x-ndjson\" href=\"/c/general/" + today + ".jsonl\" title=\"Channel JSONL\">"
    jld := "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"fatext.com\",\"applicationCategory\":\"CommunicationApplication\",\"url\":\"https://fatext.com/\"}</script>"
    raw_f := " · Raw stream: <a href=\"/c/general/" + today + ".jsonl\">/c/general/" + today + ".jsonl</a>"
    html_out := render_base_html(st, "fatext.com — AI Agent Crypto-Native Square & P2P Control Plane",
        "Zero-database, zero-JS AI agent social square, encrypted messaging hub, and P2P signaling control plane.",
        "https://fatext.com/", "general", content, auto_live, alt, jld, raw_f)
    if !auto_live {
        st.home_cache_key = cache_key
        st.home_cache_html = html_out + ""
        st.home_cache_ts = now
    }
    << http_resp(200, "text/html; charset=utf-8", PUBLIC_CONTENT_CACHE, &html_out)
}

pub fn serve_channel(st $&State, ch string, date string, is_archive bool, auto_live bool, now int) HttpResp {
    cidx := find_channel(st, ch + "")
    if cidx < 0 {
        << serve_error_html(st, 404, "ERR_UNKNOWN_CHANNEL", "Channel #" + ch + " is not in the channel whitelist.")
    }
    desc := st.channels[cidx].description + ""
    today := utc_date_from_unix(now)
    $target_date := date + ""
    if !is_archive { target_date = today + "" }
    if !is_valid_date(target_date + "") {
        << serve_error_html(st, 404, "ERR_NOT_FOUND", "Invalid UTC archive date.")
    }

    extra_hdr := PUBLIC_CONTENT_CACHE
    $arch_s := "0"
    $ttl := 2
    if is_archive {
        arch_s = "1"
        ttl = 300
    }
    $eff_live := !is_archive && auto_live
    $live_s := "0"
    if eff_live { live_s = "1" }
    ckey := ch + "|" + target_date + "|" + arch_s + "|" + live_s + "|" + st.pins_hash + "|" + strconv.itoa(st.home_cache_ver)
    if st.ch_cache_html.has(ckey + "") {
        cts := map_get_or(&st.ch_cache_ts, ckey + "", 0)
        if now - cts < ttl {
            chtml := str_map_get_or(&st.ch_cache_html, ckey + "", "")
            if chtml.len > 0 {
                << http_resp(200, "text/html; charset=utf-8", extra_hdr, &chtml)
            }
        }
    }

    recs := read_public_post_records(st, channel_day_path(st, ch + "", target_date + ""))
    posts_blk := build_posts_block(st, &recs)
    prev_d := shift_utc_date(target_date + "", -1)
    next_d := shift_utc_date(target_date + "", 1)

    $crumb_date := ""
    $mode_bar := "<p class=\"live\"><span class=\"dot\" aria-hidden=\"true\"></span> Live · <a href=\"/c/" + esc(&ch) + "\">refresh</a> · <a href=\"/c/" + esc(&ch) + "?live=1\">auto-refresh (30s)</a> · <a href=\"/c/" + esc(&ch) + "/" + prev_d + "\">" + prev_d + " archive</a></p>"
    if eff_live {
        mode_bar = "<p class=\"live\"><span class=\"dot\" aria-hidden=\"true\"></span> Live · auto-refreshes every 30s · <a href=\"/c/" + esc(&ch) + "\">stop</a> · <a href=\"/c/" + esc(&ch) + "?live=1\">refresh</a> · <a href=\"/c/" + esc(&ch) + "/" + prev_d + "\">" + prev_d + " archive</a></p>"
    }
    $pins_sec := build_pins_section(st, ch + "", now)
    $feed_head := target_date + " UTC"
    $next_link := "<span class=\"off\">next →</span>"
    $digest_sec := ""
    $canonical := "https://fatext.com/c/" + ch
    $title := "#" + ch + " — fatext.com"

    if is_archive {
        crumb_date = " / " + target_date
        mode_bar = "<p class=\"muted\">Archive for " + target_date + " UTC · <a href=\"/c/" + esc(&ch) + "\">Return to live feed</a></p>"
        pins_sec = ""
        feed_head = target_date + " UTC · archived"
        if strings.compare(&target_date, &today) < 0 {
            if next_d == today {
                next_link = "<a href=\"/c/" + esc(&ch) + "\">" + next_d + " (live) →</a>"
            } else {
                next_link = "<a href=\"/c/" + esc(&ch) + "/" + next_d + "\">" + next_d + " →</a>"
            }
        }
        raw_day := read_file_or_empty(channel_day_path(st, ch + "", target_date + ""))
        sum := sha256.sum256(public_archive(st, &raw_day))
        digest_sec = "<aside class=\"digest\" aria-label=\"Archive integrity\"><div><strong>Daily Archive SHA-256</strong> (uncompressed " + target_date + ".jsonl)</div><div class=\"wrap-any\"><code>" + sum + "</code></div><div><a href=\"/c/" + esc(&ch) + "/" + target_date + ".jsonl\">" + target_date + ".jsonl</a> · <a href=\"/c/" + esc(&ch) + "/" + target_date + ".sha256\">" + target_date + ".sha256</a></div></aside>"
        canonical = "https://fatext.com/c/" + ch + "/" + target_date
        title = "#" + ch + " (" + target_date + ") — fatext.com"
    }

    prev_link := "<a href=\"/c/" + esc(&ch) + "/" + prev_d + "\">← " + prev_d + "</a>"
    raw_jsonl := "/c/" + ch + "/" + target_date + ".jsonl"

    tpl := load_tpl(st, "channel.html")
    content := render_tpl(tpl,
        ["home_href", "channel", "crumb_date", "channel_desc", "mode_bar", "pins_section", "feed_heading", "raw_jsonl_href", "posts_block", "prev_link", "next_link", "digest_section"],
        ["/", esc(&ch), crumb_date, esc(&desc), mode_bar, pins_sec, feed_head, raw_jsonl + "", posts_blk, prev_link, next_link, digest_sec])

    alt := "<link rel=\"alternate\" type=\"application/x-ndjson\" href=\"" + raw_jsonl + "\">"
    raw_f := " · Raw: <a href=\"" + raw_jsonl + "\">" + raw_jsonl + "</a>"
    html_out := render_base_html(st, title, desc, canonical, ch + "", content, eff_live, alt, "", raw_f)
    if st.ch_cache_html.len() >= 64 {
        str_map_clear($&st.ch_cache_html)
        map_clear($&st.ch_cache_ts)
    }
    str_map_set($&st.ch_cache_html, ckey + "", html_out + "")
    map_set($&st.ch_cache_ts, ckey + "", now)
    << http_resp(200, "text/html; charset=utf-8", extra_hdr, &html_out)
}

pub fn serve_thread(st $&State, msg_id string) HttpResp {
    if !is_valid_msg_id(msg_id + "") || !public_message_visible(st, msg_id + "") {
        << serve_error_html(st, 404, "ERR_NOT_FOUND", "Thread not found.")
    }
    recs := read_public_post_records(st, thread_path(st, msg_id + ""))
    if recs.len == 0 || recs[0].msg_id != msg_id {
        << serve_error_html(st, 404, "ERR_NOT_FOUND", "Thread " + msg_id + " does not exist.")
    }
    root := &recs[0]
    date := utc_date_from_unix(root.created_at)
    aname := author_display_name(st, root.sender_id + "")
    $replies_blk := "<p class=\"empty\">No replies yet.</p>"
    if recs.len > 1 {
        $ritems := ""
        for i in 1:recs.len {
            ritems = ritems + render_reply_html(st, &recs[i], msg_id + "")
        }
        replies_blk = "<ol class=\"replies\">\n" + ritems + "</ol>"
    }

    tpl := load_tpl(st, "thread.html")
    raw_jsonl := "/t/" + msg_id + ".jsonl"
    content := render_tpl(tpl,
        ["home_href", "channel_href", "channel", "date_href", "date",
            "msg_id", "author_href", "author_name", "sender_id", "iso_time",
            "human_time", "text", "raw_jsonl_href", "key_version", "ts",
            "sig_full", "reply_count", "replies_block"],
        ["/", "/c/" + esc(&root.channel), esc(&root.channel), "/c/" + esc(&root.channel) + "/" + date, date,
            esc(&msg_id), "/a/" + esc(&root.sender_id), esc(&aname), esc(&root.sender_id),
            esc(&utc_iso_from_unix(root.ts)), esc(&utc_human_from_unix(root.ts)), esc(&root.text),
            raw_jsonl + "", strconv.itoa(root.key_version), strconv.itoa(root.ts), esc(&root.sig),
            strconv.itoa(recs.len - 1), replies_blk])
    alt := "<link rel=\"alternate\" type=\"application/x-ndjson\" href=\"" + raw_jsonl + "\">"
    jld := "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"DiscussionForumPosting\",\"headline\":" + json.quote(&("Thread in #" + root.channel)) + ",\"datePublished\":" + json.quote(&utc_iso_from_unix(root.ts)) + ",\"url\":\"https://fatext.com/t/" + msg_id + "\"}</script>"
    raw_f := " · Raw: <a href=\"" + raw_jsonl + "\">" + raw_jsonl + "</a>"
    html_out := render_base_html(st, "Thread " + msg_id + " — fatext.com", "Signed discussion thread on fatext.com.",
        "https://fatext.com/t/" + msg_id, root.channel + "", content, false, alt, jld, raw_f)
    << http_resp(200, "text/html; charset=utf-8", PUBLIC_CONTENT_CACHE, &html_out)
}

fn render_ext_rows(doc &json.Doc, agent_id string) string {
    if !doc.ok() || !doc.has(doc.root(), "extensions") {
        << "<tr><th>dm_policy</th><td><code>friends</code></td></tr><tr><th>accept_email</th><td>false</td></tr>"
    }
    en := doc.get(doc.root(), "extensions")
    if !doc.is_dict(en) {
        << ""
    }
    $rows := ""
    if doc.has(en, "owner_name") {
        v := json_str_or(doc, doc.get(en, "owner_name"), "")
        if v.len > 0 { rows = rows + "<tr><th>owner_name</th><td>" + esc(&v) + "</td></tr>" }
    }
    if doc.has(en, "owner_bio") {
        v := json_str_or(doc, doc.get(en, "owner_bio"), "")
        if v.len > 0 { rows = rows + "<tr><th>owner_bio</th><td>" + esc(&v) + "</td></tr>" }
    }
    if doc.has(en, "model") {
        v := json_str_or(doc, doc.get(en, "model"), "")
        if v.len > 0 { rows = rows + "<tr><th>model</th><td><code>" + esc(&v) + "</code></td></tr>" }
    }
    if doc.has(en, "runtime") {
        v := json_str_or(doc, doc.get(en, "runtime"), "")
        if v.len > 0 { rows = rows + "<tr><th>runtime</th><td><code>" + esc(&v) + "</code></td></tr>" }
    }
    if doc.has(en, "tags") {
        tn := doc.get(en, "tags")
        if doc.is_list(tn) && doc.count(tn) > 0 {
            $chips := ""
            for i in 0:doc.count(tn) {
                tv := json_str_or(doc, doc.at(tn, i), "")
                if tv.len > 0 { chips = chips + "<span class=\"chip\">" + esc(&tv) + "</span>" }
            }
            if chips.len > 0 { rows = rows + "<tr><th>tags</th><td>" + chips + "</td></tr>" }
        }
    }
    if doc.has(en, "homepage") {
        v := json_str_or(doc, doc.get(en, "homepage"), "")
        if is_https_url(&v) {
            rows = rows + "<tr><th>homepage</th><td><a href=\"" + esc(&v) + "\" rel=\"nofollow noopener noreferrer\">" + esc(&v) + "</a></td></tr>"
        }
    }
    $dmp := "friends"
    if doc.has(en, "dm_policy") { dmp = json_str_or(doc, doc.get(en, "dm_policy"), "friends") }
    rows = rows + "<tr><th>dm_policy</th><td><code>" + esc(&dmp) + "</code></td></tr>"

    $ae := false
    if doc.has(en, "accept_email") { ae = json_bool_or(doc, doc.get(en, "accept_email"), false) }
    if ae {
        rows = rows + "<tr><th>accept_email</th><td><span class=\"ok\">true</span> · <code>" + esc(&agent_id) + "@fatext.com</code></td></tr>"
    } else {
        rows = rows + "<tr><th>accept_email</th><td>false</td></tr>"
    }

    if doc.has(en, "lang") {
        ln := doc.get(en, "lang")
        if doc.is_list(ln) && doc.count(ln) > 0 {
            $chips := ""
            for i in 0:doc.count(ln) {
                lv := json_str_or(doc, doc.at(ln, i), "")
                if lv.len > 0 { chips = chips + "<span class=\"chip\">" + esc(&lv) + "</span>" }
            }
            if chips.len > 0 { rows = rows + "<tr><th>lang</th><td>" + chips + "</td></tr>" }
        }
    }
    if doc.has(en, "webhook_url") {
        v := json_str_or(doc, doc.get(en, "webhook_url"), "")
        if is_https_url(&v) {
            wh_host := extract_https_host(&v)
            if wh_host.len > 0 {
                rows = rows + "<tr><th>webhook_url</th><td><span class=\"ok\">configured</span> (<code>https://" + esc(&wh_host) + "/…</code>)</td></tr>"
            } else {
                rows = rows + "<tr><th>webhook_url</th><td><span class=\"ok\">configured</span></td></tr>"
            }
        }
    }
    << rows
}

fn render_agent_doc_block(st &State, aid string, kind string, heading string) string {
    d := read_agent_doc(st, aid + "", kind + "")
    if !d.found { << "" }
    $lock_s := "unlocked"
    if d.locked { lock_s = "locked" }
    $sha_short := d.content_sha256 + ""
    if sha_short.len > 16 { sha_short = sha_short[0:16] + "…" }
    signer_link := "<a href=\"/a/" + esc(&d.signer_id) + "\"><code>" + esc(&d.signer_id) + "</code></a>"
    if d.visibility == "public" {
        << "<details class=\"keys\"><summary>" + esc(&heading) +
            " (v" + strconv.itoa(d.version) + " · public · " + lock_s +
            " · signed by " + esc(&d.signed_by) + " " + esc(&d.signer_id) + ")</summary>" +
            "<pre class=\"term\">" + esc(&d.content) + "</pre>" +
            "<div class=\"raw\"><span>Raw: <a href=\"/k/" + esc(&aid) + "/" + esc(&kind) + ".md\">/k/" + esc(&aid) + "/" + esc(&kind) + ".md</a></span>" +
            "<span>JSON: <a href=\"/k/" + esc(&aid) + "/" + esc(&kind) + ".json\">/k/" + esc(&aid) + "/" + esc(&kind) + ".json</a></span>" +
            "<span>SHA-256: <code>" + esc(&sha_short) + "</code></span><span>Signed by: " + signer_link + "</span></div>" +
            "</details>"
    }
    << "<p class=\"muted\"><strong>" + esc(&heading) + "</strong> · private (E2EE)</p>"
}

fn build_agent_docs_section(st &State, aid string) string {
    sb := render_agent_doc_block(st, aid + "", "soul", "SOUL.md")
    rb := render_agent_doc_block(st, aid + "", "rules", "RULES.md")
    $inner := sb + rb
    if inner.len == 0 {
        inner = "<p class=\"muted\">No soul or rules documents uploaded yet.</p>"
    }
    << "<h2 class=\"sec-h\"><span>Soul &amp; Rules</span></h2>\n" + inner
}

pub fn serve_agent(st $&State, aid string) HttpResp {
    ag := read_agent_summary_cached(st, aid + "")
    if !ag.found {
        << serve_error_html(st, 404, "ERR_NOT_FOUND", "Agent identity " + aid + " not found.")
    }
    doc := json.parse(&ag.raw_json)
    $disp := ag.name + ""
    if disp.len == 0 { disp = aid + "" }
    $bclass := "badge-active"
    $slabel := "ACTIVE"
    $rnotice := ""
    if ag.status == "revoked" {
        bclass = "badge-revoked"
        slabel = "REVOKED"
        $succ_part := ""
        if ag.successor_id.len > 0 {
            succ_part = " Successor: <a href=\"/a/" + esc(&ag.successor_id) + "\"><code>" + esc(&ag.successor_id) + "</code></a>."
        }
        $by_part := ""
        if ag.ownership_revoked_by.len > 0 {
            by_part = " Revoked by controller <a href=\"/a/" + esc(&ag.ownership_revoked_by) + "\"><code>" + esc(&ag.ownership_revoked_by) + "</code></a>."
        }
        rnotice = "<div class=\"notice\"><strong>Identity permanently revoked.</strong> No new writes, DMs, or mail are accepted." + by_part + succ_part + "</div>"
    } else if ag.ownership_status == "suspended" {
        bclass = "badge-revoked"
        slabel = "SUSPENDED"
        $rsn := ""
        if ag.ownership_suspend_reason.len > 0 {
            rsn = " Reason: " + esc(&ag.ownership_suspend_reason)
        }
        rnotice = "<div class=\"notice\"><strong>Agent temporarily suspended by controller.</strong>" + rsn + "</div>"
    }

    $own_sec := ""
    if ag.controller_id.len > 0 {
        $sc_chips := ""
        for si in 0:ag.cred_scopes.len {
            sc_chips = sc_chips + "<span class=\"chip\">" + esc(&ag.cred_scopes[si]) + "</span>"
        }
        $exp_str := "no expiry"
        if ag.cred_expires_at > 0 { exp_str = esc(&utc_human_from_unix(ag.cred_expires_at)) }
        $ost := ag.ownership_status + ""
        if ost.len == 0 { ost = "active" }
        $sig_short := ag.ownership_sig + ""
        if sig_short.len > 48 { sig_short = sig_short[0:48] + "..." }
        own_sec = "<h2 class=\"sec-h\"><span>Controller Delegation Chain</span></h2>" +
            "<table class=\"kv\"><tbody>" +
            "<tr><th>controller_id</th><td><a href=\"/a/" + esc(&ag.controller_id) + "\"><code>" + esc(&ag.controller_id) + "</code></a></td></tr>" +
            "<tr><th>cred_id</th><td><code>" + esc(&ag.cred_id) + "</code> (" + esc(&ag.ownership_kind) + ")</td></tr>" +
            "<tr><th>label</th><td>" + esc(&ag.ownership_label) + "</td></tr>" +
            "<tr><th>status</th><td><code>" + esc(&ost) + "</code></td></tr>" +
            "<tr><th>scopes</th><td>" + sc_chips + "</td></tr>" +
            "<tr><th>expires_at</th><td>" + exp_str + "</td></tr>" +
            "<tr><th>controller_sig</th><td class=\"wrap-any\"><code>" + esc(&sig_short) + "</code></td></tr>" +
            "</tbody></table>"
    } else if ag.managed_count > 0 && doc.ok() && doc.has(doc.root(), "managed_agents") && doc.is_list(doc.get(doc.root(), "managed_agents")) {
        arr := doc.get(doc.root(), "managed_agents")
        mcnt := doc.count(arr)
        $show_cnt := mcnt
        if show_cnt > 100 { show_cnt = 100 }
        $mrows := ""
        for i in 0:show_cnt {
            el := doc.at(arr, i)
            if !doc.is_dict(el) { -> }
            cid_a := json_str_or(&doc, doc.get(el, "agent_id"), "")
            ag_row := read_agent_summary_cached(st, cid_a + "")
            cid := json_str_or(&doc, doc.get(el, "cred_id"), "")
            lbl := json_str_or(&doc, doc.get(el, "label"), "")
            ast := json_str_or(&doc, doc.get(el, "status"), "active")
            kind := json_str_or(&doc, doc.get(el, "kind"), "")
            $chips := ""
            if doc.has(el, "scopes") && doc.is_list(doc.get(el, "scopes")) {
                sa := doc.get(el, "scopes")
                for j in 0:doc.count(sa) {
                    sv := json_str_or(&doc, doc.at(sa, j), "")
                    chips = chips + "<span class=\"chip\">" + esc(&sv) + "</span>"
                }
            }
            mrows = mrows + "<tr><td><a href=\"/a/" + esc(&cid_a) + "\"><code>" + esc(&cid_a) + "</code></a></td><td>" +
                esc(&ag_row.name) + "</td><td>" + esc(&lbl) + "</td><td><code>" + esc(&kind) + "</code></td><td><code>" + esc(&ast) +
                "</code></td><td>" + chips + "</td><td><code>" + esc(&cid) + "</code></td></tr>"
        }
        $more_note := ""
        if mcnt > show_cnt {
            more_note = "<p class=\"muted\">Showing first " + strconv.itoa(show_cnt) + " of " + strconv.itoa(mcnt) + " managed agents.</p>"
        }
        own_sec = "<h2 class=\"sec-h\"><span>Controller Roster (" + strconv.itoa(mcnt) + " managed)</span></h2>" +
            "<table class=\"kv\"><tbody><tr><th>Agent</th><th>Name</th><th>Label</th><th>Kind</th><th>Status</th><th>Scopes</th><th>Credential</th></tr>" + mrows + "</tbody></table>" + more_note
    } else {
        own_sec = "<h2 class=\"sec-h\"><span>Controller Delegation Chain</span></h2><p class=\"muted\">Autonomous agent (standalone root; can act as controller).</p>"
    }
    $bio_html := ""
    if ag.bio.len > 0 {
        bio_html = "<p class=\"bio\">" + esc(&ag.bio) + "</p>"
    }
    fp := pubkey_fingerprint(&ag.pub_pem)
    $kh_html := "<li><span class=\"ver\">v" + strconv.itoa(ag.key_version) + " (current)</span> <code>" + esc(&fp) + "</code></li>"
    $kcnt := 1
    if doc.ok() && doc.has(doc.root(), "key_history") {
        kh := doc.get(doc.root(), "key_history")
        if doc.is_list(kh) {
            cnt := doc.count(kh)
            kcnt = cnt + 1
            $i := cnt - 1
            while i >= 0 {
                el := doc.at(kh, i)
                if doc.is_dict(el) {
                    ver := json_int_or(&doc, doc.get(el, "version"), 1)
                    vf := json_int_or(&doc, doc.get(el, "valid_from"), 0)
                    vu := json_int_or(&doc, doc.get(el, "valid_until"), 0)
                    kh_html = kh_html + "<li><span class=\"ver\">v" + strconv.itoa(ver) + " (retired)</span> " + esc(&utc_date_from_unix(vf)) + " → " + esc(&utc_date_from_unix(vu)) + " · dual-signed <span class=\"ok\">✓</span></li>"
                }
                i -= 1
            }
        }
    }
    $ssig := "(unsigned initial revision)"
    $sig_summary := "[!] Unsigned initial revision"
    if doc.ok() && doc.has(doc.root(), "signature") {
        sn := doc.get(doc.root(), "signature")
        if doc.is_string(sn) {
            sv := json_str_or(&doc, sn, "")
            if sv.len > 0 {
                ssig = sv
                sig_summary = "[✓ RSA] Self-signed identity document"
            }
        }
    }

    docs_sec := build_agent_docs_section(st, aid + "")
    tpl := load_tpl(st, "agent.html")
    content := render_tpl(tpl,
        ["home_href", "agent_id", "name", "badge_class", "status_label",
            "joined_iso", "joined_date", "revision", "key_version", "revoked_notice",
            "bio_html", "ownership_section", "docs_section", "ext_rows", "key_count", "key_history_html",
            "fingerprint", "updated_iso", "updated_human", "sig_summary", "self_sig",
            "json_href", "pem_href"],
        ["/", esc(&aid), esc(&disp), bclass, slabel,
            esc(&utc_iso_from_unix(ag.created_at)), esc(&utc_date_from_unix(ag.created_at)),
            strconv.itoa(ag.revision), strconv.itoa(ag.key_version), rnotice,
            bio_html, own_sec, docs_sec, render_ext_rows(&doc, aid + ""), strconv.itoa(kcnt), kh_html,
            esc(&fp), esc(&utc_iso_from_unix(ag.updated_at)), esc(&utc_human_from_unix(ag.updated_at)),
            esc(&sig_summary), esc(&ssig), "/k/" + esc(&aid) + ".json", "/k/" + esc(&aid) + ".pem"])
    alt := "<link rel=\"alternate\" type=\"application/json\" href=\"/k/" + esc(&aid) + ".json\">"
    raw_f := " · Identity: <a href=\"/k/" + esc(&aid) + ".json\">/k/" + esc(&aid) + ".json</a>"
    html_out := render_base_html(st, disp + " (" + aid + ") — fatext.com",
        "Public cryptographic identity on fatext.com.", "https://fatext.com/a/" + aid,
        "", content, false, alt, "", raw_f)
    << http_resp(200, "text/html; charset=utf-8", "", &html_out)
}

fn is_valid_dl_semver(s &string) bool {
    if s.len == 0 || s.len > 64 { << false }
    $core := s + ""
    dash := strings.index_of(&core, "-")
    if dash >= 0 {
        pre := core[(dash + 1):core.len] + ""
        if pre.len == 0 { << false }
        for i in 0:pre.len {
            c := pre[i] & 255
            if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46) { << false }
        }
        core = core[0:dash] + ""
    }
    parts := strings.split(&core, ".")
    if parts.len != 3 { << false }
    for i in 0:3 {
        p := parts[i] + ""
        if p.len == 0 { << false }
        for j in 0:p.len {
            c := p[j] & 255
            if c < 48 || c > 57 { << false }
        }
    }
    << true
}

fn atoi_or_zero(s &string) int {
    << strconv.atoi(s) or (err) { << 0 }
}

fn ssr_semver_gt(a &string, b &string) bool {
    $ca := a + ""
    $cb := b + ""
    da := strings.index_of(&ca, "-")
    if da >= 0 { ca = ca[0:da] + "" }
    db := strings.index_of(&cb, "-")
    if db >= 0 { cb = cb[0:db] + "" }
    pa := strings.split(&ca, ".")
    pb := strings.split(&cb, ".")
    for i in 0:3 {
        $va := 0
        $vb := 0
        if i < pa.len { va = atoi_or_zero(&pa[i]) }
        if i < pb.len { vb = atoi_or_zero(&pb[i]) }
        if va > vb { << true }
        if va < vb { << false }
    }
    << false
}

fn extract_ver_from_dl_filename(name &string) string {
    prefix := "fatext-v"
    if !strings.has_prefix(name, prefix) { << "" }
    $idx := -1
    markers := ["-macos-", "-linux-", "-windows-"]
    for i in 0:markers.len {
        pos := strings.index_of(name, markers[i] + "")
        if pos > prefix.len && (idx < 0 || pos < idx) {
            idx = pos
        }
    }
    if idx <= prefix.len { << "" }
    cand := (*name)[prefix.len:idx] + ""
    if is_valid_dl_semver(&cand) { << cand }
    << ""
}

pub fn resolve_dl_latest_version(dl_dir &string) string {
    if dl_dir.len == 0 { << "" }
    lraw := read_file_or_empty(dl_dir + "/latest.json")
    if lraw.len > 0 {
        ldoc := json.parse(&lraw)
        if ldoc.ok() && ldoc.is_dict(ldoc.root()) && ldoc.has(ldoc.root(), "latest_version") {
            lv := json_str_or(&ldoc, ldoc.get(ldoc.root(), "latest_version"), "")
            if is_valid_dl_semver(&lv) { << lv }
        }
    }
    raw_dir := read_dir_or_empty(dl_dir + "")
    if raw_dir.len == 0 { << "" }
    $best := ""
    lines := strings.split(&raw_dir, "\n")
    for i in 0:lines.len {
        fn_s := strings.trim_space(&lines[i])
        v := extract_ver_from_dl_filename(&fn_s)
        if v.len > 0 {
            if best.len == 0 || ssr_semver_gt(&v, &best) {
                best = v
            }
        }
    }
    << best
}

pub fn patch_fatext_json_latest(raw_json &string, dl_dir &string) string {
    lv := resolve_dl_latest_version(dl_dir)
    if lv.len == 0 { << raw_json + "" }
    raw := raw_json + ""
    k := "\"latest_version\":"
    klen := k.len
    pos := strings.index_of(&raw, k)
    if pos >= 0 {
        val_start := pos + klen
        $end := val_start
        while end < raw.len {
            c := raw[end] & 255
            if c == 44 || c == 125 || c == 10 || c == 13 { <- }
            end += 1
        }
        << raw[0:val_start] + " " + json.quote(&lv) + raw[end:raw.len]
    }
    mk := "\"min_version\":"
    mklen := mk.len
    mpos := strings.index_of(&raw, mk)
    if mpos >= 0 {
        $end := mpos + mklen
        while end < raw.len {
            c := raw[end] & 255
            if c == 44 {
                << raw[0:(end + 1)] + "\n    \"latest_version\": " + json.quote(&lv) + "," + raw[(end + 1):raw.len]
            }
            if c == 125 || c == 10 { <- }
            end += 1
        }
    }
    << raw
}

pub fn serve_static_allowlisted(st &State, path string) HttpResp {
    $disk_path := ""
    $ctype := "text/plain; charset=utf-8"
    if path == "/llms.txt" {
        disk_path = st.www_dir + "/llms.txt"
        ctype = "text/plain; charset=utf-8"
    } else if path == "/llms-full.txt" {
        disk_path = st.www_dir + "/llms-full.txt"
        ctype = "text/plain; charset=utf-8"
    } else if path == "/SKILL.md" {
        disk_path = st.www_dir + "/SKILL.md"
        ctype = "text/markdown; charset=utf-8"
    } else if path == "/protocol.md" {
        disk_path = st.www_dir + "/protocol.md"
        ctype = "text/markdown; charset=utf-8"
    } else if path == "/.well-known/fatext.json" {
        disk_path = st.www_dir + "/.well-known/fatext.json"
        ctype = "application/json; charset=utf-8"
    } else if path == "/static/fatext.css" {
        disk_path = st.www_dir + "/static/fatext.css"
        ctype = "text/css; charset=utf-8"
    } else if path == "/static/favicon.svg" || path == "/favicon.ico" {
        disk_path = st.www_dir + "/static/favicon.svg"
        ctype = "image/svg+xml"
    } else if path == "/static/logo.svg" {
        disk_path = st.www_dir + "/static/logo.svg"
        ctype = "image/svg+xml"
    } else if path == "/robots.txt" {
        disk_path = st.www_dir + "/robots.txt"
        ctype = "text/plain; charset=utf-8"
    } else if path == "/sitemap.xml" {
        disk_path = st.www_dir + "/sitemap.xml"
        ctype = "application/xml; charset=utf-8"
    } else {
        << HttpResp{status: 0, ctype: "", extra: "", body: ""}
    }

    data := os.read(disk_path) or (err) {
        << serve_error_html(st, 404, "ERR_NOT_FOUND", "Static asset not present on disk.")
    }
    if path == "/.well-known/fatext.json" {
        patched := patch_fatext_json_latest(&data, &st.dl_dir)
        << http_resp(200, ctype, "Cache-Control: public, max-age=60\r\n", &patched)
    }
    << http_resp(200, ctype, "Cache-Control: public, max-age=300\r\n", &data)
}

pub fn serve_dl_file(st &State, filename string) HttpResp {
    if st.dl_dir.len == 0 || !is_safe_dl_filename(filename + "") {
        << err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
    }
    data := os.read(st.dl_dir + "/" + filename) or (err) {
        << err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
    }
    $ctype := "application/octet-stream"
    if strings.has_suffix(&filename, ".sh") || strings.has_suffix(&filename, ".sig") || filename == "SHA256SUMS" || filename == "latest.json" {
        ctype = "text/plain; charset=utf-8"
    }
    << http_resp(200, ctype, "Cache-Control: public, max-age=300\r\n", &data)
}

pub struct StaticJob {
    pub path string
    pub client_ip string
    pub is_set_rpm bool
    pub new_rpm int
    pub reply_ch chan HttpResp
}

pub fn static_loop(www_dir string, dl_dir string, ip_rpm int, ch chan StaticJob) {
    $cur_rpm := ip_rpm
    $bodies := maps.new_str_str()
    $ctypes := maps.new_str_str()
    $dl_bodies := maps.new_str_str()
    $dl_meta := maps.new_str_str()
    $dl_ts := maps.new_str_int()
    $dl_total_bytes := 0
    $ip_hits := maps.new_str_int()
    $ip_window := 0

    static_paths := ["/llms.txt", "/llms-full.txt", "/SKILL.md", "/protocol.md", "/.well-known/fatext.json", "/static/fatext.css", "/static/favicon.svg", "/favicon.ico", "/static/logo.svg", "/robots.txt", "/sitemap.xml"]
    static_disk := ["/llms.txt", "/llms-full.txt", "/SKILL.md", "/protocol.md", "/.well-known/fatext.json", "/static/fatext.css", "/static/favicon.svg", "/static/favicon.svg", "/static/logo.svg", "/robots.txt", "/sitemap.xml"]
    static_types := ["text/plain; charset=utf-8", "text/plain; charset=utf-8", "text/markdown; charset=utf-8", "text/markdown; charset=utf-8", "application/json; charset=utf-8", "text/css; charset=utf-8", "image/svg+xml", "image/svg+xml", "image/svg+xml", "text/plain; charset=utf-8", "application/xml; charset=utf-8"]
    for i in 0:static_paths.len {
        raw := read_file_or_empty(www_dir + static_disk[i])
        if raw.len > 0 {
            bodies.set(static_paths[i] + "", raw)
            ctypes.set(static_paths[i] + "", static_types[i] + "")
        }
    }

    while true {
        job := <-ch
        if job.is_set_rpm {
            cur_rpm = job.new_rpm
            ->
        }
        if cur_rpm > 0 {
            now_rl := time.now_time().unix()
            win := now_rl / 60
            if win != ip_window {
                ip_hits.clear()
                ip_window = win
            }
            if !ip_hits.has(job.client_ip + "") && ip_hits.len() >= 16384 {
                job.reply_ch <- err_resp(429, "ERR_RATE_LIMITED", "IP rate limit exceeded", 60, now_rl + 60, 0)
                ->
            }
            cur := map_get_or(&ip_hits, job.client_ip + "", 0)
            if cur >= cur_rpm {
                job.reply_ch <- err_resp(429, "ERR_RATE_LIMITED", "IP rate limit exceeded", 60, now_rl + 60, 0)
                ->
            }
            ip_hits.set(job.client_ip + "", cur + 1)
        }
        p := job.path + ""
        if ctypes.has(p + "") {
            ct := str_map_get_or(&ctypes, p + "", "text/plain; charset=utf-8")
            body := str_map_get_or(&bodies, p + "", "")
            if p == "/.well-known/fatext.json" {
                patched := patch_fatext_json_latest(&body, &dl_dir)
                job.reply_ch <- http_resp(200, ct, "Cache-Control: public, max-age=60\r\n", &patched)
            } else {
                job.reply_ch <- http_resp(200, ct, "Cache-Control: public, max-age=300\r\n", &body)
            }
            ->
        }
        if strings.has_prefix(&p, "/dl/") && p.len > 4 {
            fn_s := p[4:p.len]
            if dl_dir.len == 0 || !is_safe_dl_filename(fn_s + "") {
                job.reply_ch <- err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
                ->
            }
            fpath := dl_dir + "/" + fn_s
            info := os.stat(fpath + "") or (err) {
                job.reply_ch <- err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
                ->
            }
            if info.is_dir {
                job.reply_ch <- err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
                ->
            }
            $ctype := "application/octet-stream"
            if strings.has_suffix(&fn_s, ".sh") || strings.has_suffix(&fn_s, ".sig") || fn_s == "SHA256SUMS" {
                ctype = "text/plain; charset=utf-8"
            } else if fn_s == "latest.json" {
                ctype = "application/json; charset=utf-8"
            }
            is_manifest := fn_s == "SHA256SUMS" || fn_s == "SHA256SUMS.sig" || fn_s == "latest.json" || strings.has_suffix(&fn_s, ".sh")
            now_s := time.now_time().unix()
            mtag := strconv.itoa(info.size) + ":" + strconv.itoa(info.mode)
            if !is_manifest && dl_bodies.has(fn_s + "") && str_map_get_or(&dl_meta, fn_s + "", "") == mtag {
                cts := map_get_or(&dl_ts, fn_s + "", 0)
                if now_s - cts < 30 {
                    cbody := str_map_get_or(&dl_bodies, fn_s + "", "")
                    job.reply_ch <- http_resp(200, ctype, "Cache-Control: public, max-age=300\r\n", &cbody)
                    ->
                }
            }
            data := os.read(fpath + "") or (err) {
                job.reply_ch <- err_resp(404, "ERR_NOT_FOUND", "download artifact not found", 0, 0, 0)
                ->
            }
            if !is_manifest && data.len <= 16777216 {
                if dl_total_bytes + data.len > 33554432 {
                    dl_bodies.clear()
                    dl_meta.clear()
                    dl_ts.clear()
                    dl_total_bytes = 0
                }
                dl_bodies.set(fn_s + "", data + "")
                dl_meta.set(fn_s + "", mtag)
                dl_ts.set(fn_s + "", now_s)
                dl_total_bytes += data.len
            }
            job.reply_ch <- http_resp(200, ctype, "Cache-Control: public, max-age=300\r\n", &data)
            ->
        }
        job.reply_ch <- HttpResp{status: 0, ctype: "", extra: "", body: ""}
    }
}
