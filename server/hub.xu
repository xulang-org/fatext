@main

#os
#maps
#strconv
#strings
#time
#crypto/sha256
#encoding/json

pub const HUB_HTTP = 1
pub const HUB_SSE_SUB = 2
pub const HUB_SSE_UNSUB = 3
pub const HUB_METRIC_TLS = 4
pub const HUB_METRIC_FLUSH = 5
pub const HUB_METRIC_GC = 6
pub const HUB_SHUTDOWN_DRAIN = 7
pub const HUB_MODERATION_PREFLIGHT = 8
pub const HUB_ENTITY_STATS_UPDATE = 9
pub const HUB_CONFIG_RELOAD = 10
pub const SSE_CTRL_SHUTDOWN = "__FATEXT_SSE_SHUTDOWN__"

pub struct SseClient {
    pub id int
    pub agent_id string
    pub controller_id string
    pub stop_ch chan int
    pub channels []string
    pub rooms []string
    pub ch chan string
}

pub struct HubReply {
    pub resp HttpResp
    pub is_sse bool
    pub sse_id int
    pub sse_ch chan string
    pub sse_expires_at int
    pub sse_stop chan int
    pub queue_ms int
    pub handle_ms int
    pub err_code string
    pub actor_type string
    pub actor_id string
}

pub struct HubJob {
    pub kind int
    pub req HttpReq
    pub sse_id int
    pub enqueued_ns int
    pub flag int
    pub entity_stats EntityStatsCache
    pub reply_ch chan HubReply
}

pub struct EntityStatsCache {
    pub ts int
    pub agents_total int
    pub agents_active int
    pub agents_revoked int
    pub agents_suspended int
    pub controllers_total int
    pub managed_agents_total int
    pub rooms_total int
    pub posts_today int
    pub per_channel_today_json string
}

pub struct HubState {
    pub st State
    pub clients []SseClient
    pub sse_agent_counts maps.StrInt
    pub next_sse_id int
    pub ip_hits maps.StrInt
    pub ip_window int
    pub log_ch chan string
    pub static_ch chan StaticJob
    pub webhook_ch chan string
    pub webhooks_enabled bool
    pub log_dir string
    pub slow_ms int
    pub draining bool
    pub started_at int
    pub max_sse int
    pub max_sse_per_agent int
    pub admin_secret string
    pub admin_local_only bool
    pub shutdown_enabled bool
    pub cert_ch chan CertStoreMsg
    pub tls_cert_path string
    pub tls_key_path string
    pub tls_trusted_host string
    pub metrics MetricsState
    pub cum_metrics MetricsState
    pub entity_cache EntityStatsCache
    pub entity_cache_day string
    pub ch_posts_today maps.StrInt
    pub pub_stats_ts int
    pub pub_stats_json string
}

pub fn empty_entity_stats_cache() EntityStatsCache {
    << EntityStatsCache{
        ts: 0,
        agents_total: 0,
        agents_active: 0,
        agents_revoked: 0,
        agents_suspended: 0,
        controllers_total: 0,
        managed_agents_total: 0,
        rooms_total: 0,
        posts_today: 0,
        per_channel_today_json: "{}"
    }
}

pub fn make_hub_job(kind int, req HttpReq, sse_id int, enqueued_ns int, flag int, reply_ch chan HubReply) HubJob {
    << HubJob{
        kind: kind,
        req: req,
        sse_id: sse_id,
        enqueued_ns: enqueued_ns,
        flag: flag,
        entity_stats: empty_entity_stats_cache(),
        reply_ch: reply_ch
    }
}

pub fn new_hub_state(st State, log_ch chan string, static_ch chan StaticJob, webhook_ch chan string, webhooks_enabled bool, log_dir string, slow_ms int, now int, max_sse int, max_sse_per_agent int, admin_secret string, admin_local_only bool, shutdown_enabled bool, cert_ch chan CertStoreMsg, tls_cert_path string, tls_key_path string, tls_trusted_host string) HubState {
    << HubState{
        st: st,
        clients: []SseClient{},
        sse_agent_counts: maps.new_str_int(),
        next_sse_id: 1,
        ip_hits: maps.new_str_int(),
        ip_window: 0,
        log_ch: log_ch,
        static_ch: static_ch,
        webhook_ch: webhook_ch,
        webhooks_enabled: webhooks_enabled,
        log_dir: log_dir,
        slow_ms: slow_ms,
        draining: false,
        started_at: now,
        max_sse: max_sse,
        max_sse_per_agent: max_sse_per_agent,
        admin_secret: admin_secret,
        admin_local_only: admin_local_only,
        shutdown_enabled: shutdown_enabled,
        cert_ch: cert_ch,
        tls_cert_path: tls_cert_path,
        tls_key_path: tls_key_path,
        tls_trusted_host: tls_trusted_host,
        metrics: new_metrics_state(now),
        cum_metrics: new_metrics_state(now),
        entity_cache: empty_entity_stats_cache(),
        entity_cache_day: utc_date_from_unix(now),
        ch_posts_today: maps.new_str_int(),
        pub_stats_ts: 0,
        pub_stats_json: ""
    }
}

fn sse_count_inc(hub $&HubState, aid string) {
    cur := map_get_or(&hub.sse_agent_counts, aid + "", 0)
    map_set($&hub.sse_agent_counts, aid + "", cur + 1)
}

fn sse_count_dec(hub $&HubState, aid string) {
    cur := map_get_or(&hub.sse_agent_counts, aid + "", 0)
    if cur <= 1 {
        m := $&hub.sse_agent_counts
        m.del(aid + "")
    } else {
        map_set($&hub.sse_agent_counts, aid + "", cur - 1)
    }
}

fn empty_sse_ch() chan string {
    << chan string{cap: 1}
}

pub fn reply_http(resp HttpResp, queue_ms int, handle_ms int, err_code string, actor_type string, actor_id string) HubReply {
    << HubReply{
        resp: resp, is_sse: false, sse_id: 0, sse_ch: empty_sse_ch(), sse_expires_at: 0, sse_stop: chan int{cap: 1},
        queue_ms: queue_ms, handle_ms: handle_ms, err_code: err_code,
        actor_type: actor_type, actor_id: actor_id
    }
}

fn send_sse_msg(cli &SseClient, msg string) bool {
    select {
        cli.ch <- msg { << true }
        else { << false }
    }
}

pub fn hub_push_to_agent(hub $&HubState, agent_id string, event_type string, data_json &string) int {
    if map_get_or(&hub.sse_agent_counts, agent_id + "", 0) <= 0 {
        << 0
    }
    msg := "event: " + event_type + "\ndata: " + data_json + "\n\n"
    $sent := 0
    for i in 0:hub.clients.len {
        if hub.clients[i].agent_id == agent_id {
            if send_sse_msg(&hub.clients[i], msg + "") {
                sent += 1
                hub.metrics.sse_events_pushed += 1
            } else {
                hub.metrics.sse_dropped_full += 1
            }
        }
    }
    << sent
}

pub fn hub_disconnect_agent_count(hub $&HubState, agent_id string, include_managed bool) int {
    $cnt := 0
    $next_clients := []SseClient{}
    $dropped_aids := []string{}
    for i in 0:hub.clients.len {
        c := &hub.clients[i]
        if c.agent_id == agent_id || (include_managed && c.controller_id == agent_id) {
            cnt += 1
            dropped_aids.push(c.agent_id + "")
            c.stop_ch <- 1
        } else {
            next_clients.push(SseClient{
                id: c.id,
                agent_id: c.agent_id + "",
                controller_id: c.controller_id + "",
                stop_ch: c.stop_ch,
                channels: clone_str_slice(&c.channels),
                rooms: clone_str_slice(&c.rooms),
                ch: c.ch
            })
        }
    }
    hub.clients = next_clients
    for k in 0:dropped_aids.len {
        sse_count_dec(hub, dropped_aids[k] + "")
    }
    << cnt
}

pub fn hub_disconnect_agent(hub $&HubState, agent_id string) {
    _ := hub_disconnect_agent_count(hub, agent_id + "", false)
}

pub fn hub_push_dm(hub $&HubState, to_id string, data_json &string) int {
    << hub_push_to_agent(hub, to_id, "dm", data_json)
}

pub fn hub_push_room_checked(hub $&HubState, room &RoomData, sender_id string, data_json &string, now int) int {
    $rm_set := maps.new_str_int()
    for mi in 0:room.members.len {
        rm_set.set(room.members[mi].agent_id + "", 1)
    }
    msg := "event: room\ndata: " + data_json + "\n\n"
    $sent := 0
    for i in 0:hub.clients.len {
        cid := hub.clients[i].agent_id + ""
        if cid == sender_id { -> }
        if !rm_set.has(cid + "") { -> }
        if !(hub.clients[i].rooms.len == 0 || str_list_contains(&hub.clients[i].rooms, room.room_id + "")) { -> }
        if agent_blocks_sender_cached($&hub.st, cid + "", sender_id + "", now) { -> }
        if send_sse_msg(&hub.clients[i], msg + "") {
            sent += 1
            hub.metrics.sse_events_pushed += 1
        } else {
            hub.metrics.sse_dropped_full += 1
        }
    }
    << sent
}

pub fn hub_push_room_event(hub $&HubState, room &RoomData, data_json &string) int {
    $rm_set := maps.new_str_int()
    for mi in 0:room.members.len {
        rm_set.set(room.members[mi].agent_id + "", 1)
    }
    msg := "event: room_event\ndata: " + data_json + "\n\n"
    $sent := 0
    for i in 0:hub.clients.len {
        c := &hub.clients[i]
        if !rm_set.has(c.agent_id + "") { -> }
        if str_list_contains(&c.rooms, room.room_id + "") || c.rooms.len == 0 {
            if send_sse_msg(c, msg + "") {
                sent += 1
                hub.metrics.sse_events_pushed += 1
            } else {
                hub.metrics.sse_dropped_full += 1
            }
        }
    }
    << sent
}

pub fn hub_push_channel(hub $&HubState, ch string, event_type string, data_json &string) int {
    msg := "event: " + event_type + "\ndata: " + data_json + "\n\n"
    $sent := 0
    for i in 0:hub.clients.len {
        c := &hub.clients[i]
        if c.channels.len == 0 || str_list_contains(&c.channels, ch + "") {
            if send_sse_msg(c, msg + "") {
                sent += 1
                hub.metrics.sse_events_pushed += 1
            } else {
                hub.metrics.sse_dropped_full += 1
            }
        }
    }
    << sent
}

pub fn path_only(raw string) string {
    for i in 0:raw.len {
        if (raw[i] & 255) == 63 {
            << raw[0:i]
        }
    }
    << raw + ""
}

fn clear_map(m $&maps.StrInt) {
    m.clear()
}

fn check_ip_rate_limit(hub $&HubState, remote_ip string, now int) bool {
    if hub.st.ip_rpm <= 0 { << true }
    win := now / 60
    if win != hub.ip_window {
        hub.ip_window = win
        clear_map($&hub.ip_hits)
    }
    $k := remote_ip + ""
    if k.len == 0 { k = "unknown" }
    if !hub.ip_hits.has(k + "") && hub.ip_hits.len() >= 16384 {
        << false
    }
    cur := map_get_or(&hub.ip_hits, k + "", 0)
    if cur >= hub.st.ip_rpm { << false }
    map_set($&hub.ip_hits, k + "", cur + 1)
    << true
}

fn parse_csv_query_param(raw_path string, key string) []string {
    $out := []string{}
    qidx := strings.index_of(&raw_path, "?")
    if qidx < 0 { << out }
    qp := raw_path[(qidx + 1):raw_path.len]
    parts := strings.split(&qp, "&")
    prefix := key + "="
    for i in 0:parts.len {
        p := parts[i] + ""
        if strings.has_prefix(&p, prefix) {
            v := p[prefix.len:p.len]
            items := strings.split(&v, ",")
            for j in 0:items.len {
                t := strings.trim_space(&items[j])
                if t.len > 0 { out.push(t) }
            }
        }
    }
    << out
}

pub fn url_decode_simple(s &string) string {
    $out := ""
    $i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 37 && i + 2 < s.len {
            h1 := s[i + 1] & 255
            h2 := s[i + 2] & 255
            v1 := hex_val(h1)
            v2 := hex_val(h2)
            if v1 >= 0 && v2 >= 0 {
                out.push_byte((v1 << 4) | v2)
                i += 3
                ->
            }
        }
        out.push_byte(c)
        i += 1
    }
    << out
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 65 && c <= 70 { << c - 55 }
    if c >= 97 && c <= 102 { << c - 87 }
    << -1
}

fn run_mail_gc_pass(data_dir string, now int) int {
    $deleted := 0
    mail_root := data_dir + "/mail"
    buckets := os.read_dir(mail_root + "") or (err) { << 0 }
    blines := strings.split(&buckets, "\n")
    for bi in 0:blines.len {
        b := strings.trim_space(&blines[bi])
        if b.len != 2 { -> }
        bdir := mail_root + "/" + b
        agents := os.read_dir(bdir + "") or (err) { -> }
        alines := strings.split(&agents, "\n")
        for ai in 0:alines.len {
            aid := strings.trim_space(&alines[ai])
            if !is_valid_agent_id(aid + "") { -> }
            adir := bdir + "/" + aid
            files := os.read_dir(adir + "") or (err) { -> }
            flines := strings.split(&files, "\n")
            for fi in 0:flines.len {
                fn_s := strings.trim_space(&flines[fi])
                if !strings.has_suffix(&fn_s, ".json") { -> }
                fpath := adir + "/" + fn_s
                raw := read_file_or_empty(fpath + "")
                doc := json.parse(&raw)
                if doc.ok() && doc.has(doc.root(), "received_at") {
                    rat := json_int_or(&doc, doc.get(doc.root(), "received_at"), 0)
                    if rat > 0 && now - rat > MAIL_TTL_SEC {
                        _ := os.remove(fpath + "") or (err) { -> }
                        deleted += 1
                    }
                }
            }
        }
    }
    << deleted
}

pub fn maintenance_loop(data_dir string, ch_names []string, log_ch chan string, jobs chan HubJob, moderation_retention_days int) {
    $last_anchor := ""
    $last_gc := 0
    tick := time.new_ticker(60000000000)
    while true {
        now := time.now_time().unix()
        today := utc_date_from_unix(now)
        if last_anchor != today {
            last_anchor = today + ""
            yday := shift_utc_date(today + "", -1)
            work_root := data_dir + "/registration-work"
            dirs := read_dir_or_empty(work_root + "")
            days := strings.split(&dirs, "\n")
            for di in 0:days.len {
                day := days[di] + ""
                if is_valid_date(day + "") && strings.compare(&day, &yday) < 0 {
                    _ := os.remove_all(work_root + "/" + day) or (err) { -> }
                }
            }
            $cur_chs := read_channel_names_from_disk(data_dir + "")
            if cur_chs.len == 0 {
                cur_chs = clone_str_slice(&ch_names)
            }
            $anchors := 0
            for i in 0:cur_chs.len {
                ch := cur_chs[i] + ""
                y := yday[0:4]
                m := yday[5:7]
                p := data_dir + "/public/channels/" + ch + "/" + y + "/" + m + "/" + yday + ".jsonl"
                raw := read_file_or_empty(p + "")
                if raw.len > 0 {
                    sha_p := p + ".sha256"
                    if read_file_or_empty(sha_p + "").len == 0 {
                        anchor := sha256.sum256(raw + "") + "  " + yday + ".jsonl\n"
                        write_atomic_quiet(sha_p, &anchor)
                        anchors += 1
                    }
                }
            }
            if anchors > 0 {
                log_event_json(log_ch, now, "maintenance",
                    "\"task\":\"daily_anchors\",\"date\":" + json.quote(&yday) + ",\"anchors\":" + strconv.itoa(anchors))
            }
        }
        if now - last_gc >= 3600 {
            t0 := time.now()
            last_gc = now
            purge_moderation_records(data_dir + "", today + "", moderation_retention_days, now, log_ch)
            deleted := run_mail_gc_pass(data_dir + "", now)
            if deleted > 0 {
                gc_job := make_hub_job(HUB_METRIC_GC, empty_req(), 0, 0, deleted, chan HubReply{cap: 1})
                jobs <- gc_job
            }
            dur_ms := (time.now() - t0) / 1000000
            log_event_json(log_ch, now, "maintenance",
                "\"task\":\"mail_gc\",\"deleted\":" + strconv.itoa(deleted) + ",\"duration_ms\":" + strconv.itoa(dur_ms))
        }
        _ := <-tick.c
    }
}

fn config_snapshot_digest(data_dir string) string {
    p1 := read_file_or_empty(data_dir + "/public/channels.json")
    p2 := read_file_or_empty(data_dir + "/public/pins.json")
    p3 := read_file_or_empty(data_dir + "/blacklist/banned_agents.jsonl")
    p4 := read_file_or_empty(data_dir + "/keys/revoked.jsonl")
    p5 := read_file_or_empty(data_dir + "/blacklist/banned_emails.txt")
    raw := strconv.itoa(p1.len) + ":" + p1 + "\n" +
        strconv.itoa(p2.len) + ":" + p2 + "\n" +
        strconv.itoa(p3.len) + ":" + p3 + "\n" +
        strconv.itoa(p4.len) + ":" + p4 + "\n" +
        strconv.itoa(p5.len) + ":" + p5
    << sha256.sum256(raw)
}

pub fn config_watch_loop(data_dir string, jobs chan HubJob) {
    $last_digest := config_snapshot_digest(data_dir + "")
    tick := time.new_ticker(1000000000)
    while true {
        _ := <-tick.c
        cur := config_snapshot_digest(data_dir + "")
        if cur != last_digest {
            last_digest = cur
            jobs <- make_hub_job(HUB_CONFIG_RELOAD, empty_req(), 0, 0, 0, chan HubReply{cap: 1})
        }
    }
}

pub fn entity_stats_loop(data_dir string, jobs chan HubJob) {
    tick := time.new_ticker(30000000000)
    while true {
        _ := <-tick.c
        now := time.now_time().unix()
        chs := read_channel_names_from_disk(data_dir + "")
        snap := compute_entity_stats(data_dir + "", &chs, now)
        jobs <- HubJob{
            kind: HUB_ENTITY_STATS_UPDATE,
            req: empty_req(),
            sse_id: 0,
            enqueued_ns: 0,
            flag: 0,
            entity_stats: snap,
            reply_ch: chan HubReply{cap: 1}
        }
    }
}

fn dispatch_http(hub $&HubState, req &HttpReq, now int, preflight bool, reviewed bool) HttpResp {
    $method := req.method()
    if method == "HEAD" {
        method = "GET"
    }
    path := path_only(req.path())

    if path == "/report/status" || path == "/v1/reports/status" {
        << handle_guest_report_status(&hub.st, req, path == "/report/status", now)
    }
    if path == "/v1/moderation/notices" {
        << handle_moderation_notices($&hub.st, req, now)
    }
    if path == "/v1/moderation/review" {
        << handle_own_review($&hub.st, req, now)
    }
    if path == "/report" || path == "/v1/reports" {
        << handle_public_report($&hub.st, req, path == "/report", now)
    }
    if method == "GET" && path == "/health" {
        << http_resp(200, "text/plain; charset=utf-8", "", &"ok\n")
    }
    if method == "GET" && path == "/ready" {
        $st_code := 200
        $st_txt := "ready"
        $ok_s := "true"
        if hub.draining {
            st_code = 503
            st_txt = "draining"
            ok_s = "false"
        }
        $up := now - hub.started_at
        if up < 0 { up = 0 }
        rbody := "{\"ok\":" + ok_s +
            ",\"status\":" + json.quote(&st_txt) +
            ",\"active_sse\":" + strconv.itoa(hub.clients.len) +
            ",\"uptime_sec\":" + strconv.itoa(up) +
            ",\"version\":\"3.0\"}"
        << json_resp(st_code, rbody)
    }
    if method == "GET" {
        st_resp := serve_static_allowlisted(&hub.st, path + "")
        if st_resp.status != 0 { << st_resp }
        if path == "/dl" || path == "/dl/" {
            << serve_download(&hub.st)
        }
        if strings.has_prefix(&path, "/dl/") {
            << serve_dl_file(&hub.st, path[4:path.len])
        }
    }

    if path == "/internal/mail/ingest" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_mail_ingest(hub, req, now)
    }
    if path == "/internal/metrics" {
        << handle_internal_metrics(hub, req, now)
    }
    if strings.has_prefix(&path, "/internal/admin/") {
        << handle_admin_dispatch(hub, req, method + "", path + "", now)
    }
    if path == "/v1/stats" {
        if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_public_stats(hub, now)
    }

    if path == "/v1/agents/register" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        resp := handle_register($&hub.st, req, now)
        if resp.status == 201 {
            hub.entity_cache.agents_total += 1
            hub.entity_cache.agents_active += 1
            if strings.contains(&resp.body, "\"controller_id\":") {
                hub.entity_cache.managed_agents_total += 1
            }
            rdoc := json.parse(&req.body())
            if rdoc.ok() && rdoc.is_dict(rdoc.root()) && rdoc.has(rdoc.root(), "controller_only") {
                if json_bool_or(&rdoc, rdoc.get(rdoc.root(), "controller_only"), false) {
                    hub.entity_cache.controllers_total += 1
                }
            }
            hub.pub_stats_ts = 0
        }
        << resp
    }
    if path == "/v1/agents/profile" {
        if method != "PUT" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_profile_update($&hub.st, req, now)
    }
    if path == "/v1/agents/rotate-key" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_rotate_key(hub, req, now)
    }
    if path == "/v1/agents/revoke" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        resp := handle_revoke(hub, req, now)
        if resp.status == 200 {
            hub.entity_cache.agents_revoked += 1
            if hub.entity_cache.agents_active > 0 {
                hub.entity_cache.agents_active -= 1
            }
            hub.pub_stats_ts = 0
        }
        << resp
    }
    if path == "/v1/agents/docs" {
        if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_agent_docs_list($&hub.st, req, now)
    }
    if strings.has_prefix(&path, "/v1/agents/docs/") {
        kind := path[16:path.len]
        if !strings.contains(&kind, "/") {
            if method == "GET" { << handle_agent_doc_get($&hub.st, req, kind, now) }
            if method == "PUT" { << handle_agent_doc_put(hub, req, kind, now) }
            if method == "DELETE" { << handle_agent_doc_delete(hub, req, kind, now) }
            << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
        }
    }

    if path == "/v1/ctl/agents" {
        if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_ctl_list_agents($&hub.st, req, now)
    }
    if strings.has_prefix(&path, "/v1/ctl/agents/") {
        rest := path[15:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 {
            aid := parts[0] + ""
            act := parts[1] + ""
            if act == "credential" {
                if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                << handle_ctl_grant_credential(hub, req, aid, now)
            }
            if act == "suspend" {
                if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                ag_prev := read_agent_summary_cached($&hub.st, aid + "")
                resp := handle_ctl_suspend_agent(hub, req, aid, now)
                if resp.status == 200 && (!ag_prev.found || ag_prev.ownership_status != "suspended") {
                    hub.entity_cache.agents_suspended += 1
                }
                << resp
            }
            if act == "resume" {
                if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                ag_prev := read_agent_summary_cached($&hub.st, aid + "")
                resp := handle_ctl_resume_agent(hub, req, aid, now)
                if resp.status == 200 && ag_prev.found && ag_prev.ownership_status == "suspended" && hub.entity_cache.agents_suspended > 0 {
                    hub.entity_cache.agents_suspended -= 1
                }
                << resp
            }
            if act == "revoke" {
                if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                was_rev := hub.st.revoked.has(aid + "")
                resp := handle_ctl_revoke_agent(hub, req, aid, now)
                if resp.status == 200 && !was_rev {
                    hub.entity_cache.agents_revoked += 1
                    if hub.entity_cache.agents_active > 0 {
                        hub.entity_cache.agents_active -= 1
                    }
                    hub.pub_stats_ts = 0
                }
                << resp
            }
            if act == "policy" {
                if method != "PUT" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                << handle_ctl_update_agent_policy(hub, req, aid, now)
            }
            if act == "docs" {
                if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
                << handle_ctl_agent_docs_list($&hub.st, req, aid, now)
            }
        }
        if parts.len == 3 && parts[1] == "docs" {
            aid := parts[0] + ""
            kind := parts[2] + ""
            if method == "GET" { << handle_ctl_agent_doc_get($&hub.st, req, aid, kind, now) }
            if method == "PUT" { << handle_ctl_agent_doc_put(hub, req, aid, kind, now) }
            if method == "DELETE" { << handle_ctl_agent_doc_delete(hub, req, aid, kind, now) }
            << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
        }
    }

    if path == "/v1/friends" {
        if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_friends_list($&hub.st, req, now)
    }
    if path == "/v1/friends/request" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_friend_request($&hub.st, req, now)
    }
    if path == "/v1/friends/accept" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_friend_accept($&hub.st, req, now)
    }
    if path == "/v1/friends/reject" {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_friend_reject($&hub.st, req, now)
    }
    if strings.has_prefix(&path, "/v1/friends/") {
        if method != "DELETE" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_friend_rm($&hub.st, req, path[12:path.len], now)
    }

    if path == "/v1/blocks" {
        if method == "GET" { << handle_blocks_list($&hub.st, req, now) }
        if method == "POST" { << handle_block_add($&hub.st, req, now) }
        << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
    }
    if strings.has_prefix(&path, "/v1/blocks/") {
        if method != "DELETE" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        raw_t := path[11:path.len]
        << handle_block_rm($&hub.st, req, url_decode_simple(&raw_t), now)
    }

    if strings.has_prefix(&path, "/v1/dm/") {
        if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_dm_send(hub, req, path[7:path.len], now)
    }
    if path == "/v1/rooms" || strings.has_prefix(&path, "/v1/rooms/") {
        resp := handle_rooms_dispatch(hub, req, path + "", method + "", now)
        if path == "/v1/rooms" && method == "POST" && resp.status == 201 {
            hub.entity_cache.rooms_total += 1
        }
        << resp
    }

    if path == "/v1/mail" {
        if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_mail_list($&hub.st, req, now)
    }
    if strings.has_prefix(&path, "/v1/mail/") {
        if method != "DELETE" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
        << handle_mail_delete($&hub.st, req, path[9:path.len], now)
    }

    if strings.has_prefix(&path, "/v1/channels/") {
        rest := path[13:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 && parts[1] == "pins" {
            if method != "GET" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
            << handle_get_pins($&hub.st, parts[0] + "", now)
        }
        if parts.len == 2 && parts[1] == "posts" {
            if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
            ch := parts[0] + ""
            resp := handle_create_post($&hub.st, req, ch + "", now, preflight, reviewed)
            if resp.status == 201 {
                ensure_entity_day_fresh(hub, now)
                hub.entity_cache.posts_today += 1
                cur_cp := map_get_or(&hub.ch_posts_today, ch + "", 0)
                map_set($&hub.ch_posts_today, ch + "", cur_cp + 1)
                rebuild_per_channel_today_json(hub)
                hub.pub_stats_ts = 0
                rdoc := json.parse(&resp.body)
                if rdoc.ok() && rdoc.has(rdoc.root(), "msg_id") {
                    mid := json_str_or(&rdoc, rdoc.get(rdoc.root(), "msg_id"), "")
                    recs := read_jsonl_records(thread_path(&hub.st, mid + ""))
                    if recs.len > 0 {
                        _ := hub_push_channel(hub, ch + "", "post", &recs[0].raw_line)
                    }
                }
            }
            << resp
        }
    }

    if strings.has_prefix(&path, "/v1/threads/") {
        rest := path[12:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 2 && parts[1] == "replies" {
            if method != "POST" { << err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0) }
            tid := parts[0] + ""
            resp := handle_create_reply($&hub.st, req, tid + "", now, preflight, reviewed)
            if resp.status == 201 {
                recs := read_jsonl_records(thread_path(&hub.st, tid + ""))
                if recs.len > 0 {
                    ch := recs[0].channel + ""
                    last := recs[recs.len - 1].raw_line + ""
                    _ := hub_push_channel(hub, ch, "reply", &last)
                }
            }
            << resp
        }
    }

    if strings.has_prefix(&path, "/k/") && method == "GET" {
        rest := path[3:path.len]
        if strings.contains(&rest, "/") {
            parts := strings.split(&rest, "/")
            if parts.len == 2 {
                aid := parts[0] + ""
                sub := parts[1] + ""
                if sub == "docs.json" { << handle_public_docs_list(&hub.st, aid) }
                if sub == "soul.json" { << handle_public_doc_get(&hub.st, aid, "soul", false) }
                if sub == "soul.md" { << handle_public_doc_get(&hub.st, aid, "soul", true) }
                if sub == "rules.json" { << handle_public_doc_get(&hub.st, aid, "rules", false) }
                if sub == "rules.md" { << handle_public_doc_get(&hub.st, aid, "rules", true) }
            }
        }
        if strings.has_suffix(&rest, ".json") {
            << handle_get_key_json($&hub.st, rest[0:(rest.len - 5)])
        }
        if strings.has_suffix(&rest, ".pem") {
            << handle_get_key_pem($&hub.st, rest[0:(rest.len - 4)])
        }
    }

    if strings.has_prefix(&path, "/c/") && method == "GET" {
        rest := path[3:path.len]
        parts := strings.split(&rest, "/")
        if parts.len == 1 && parts[0].len > 0 {
            << serve_channel($&hub.st, parts[0] + "", "", false, now)
        }
        if parts.len == 2 {
            ch := parts[0] + ""
            seg := parts[1] + ""
            if strings.has_suffix(&seg, ".jsonl") {
                << handle_get_channel_jsonl(&hub.st, ch, seg[0:(seg.len - 6)])
            }
            if strings.has_suffix(&seg, ".sha256") {
                << handle_get_channel_sha256(&hub.st, ch, seg[0:(seg.len - 7)])
            }
            << serve_channel($&hub.st, ch, seg, true, now)
        }
    }

    if strings.has_prefix(&path, "/t/") && method == "GET" {
        rest := path[3:path.len]
        if strings.has_suffix(&rest, ".jsonl") {
            << handle_get_thread_jsonl(&hub.st, rest[0:(rest.len - 6)])
        }
        if rest.len > 0 && !strings.contains(&rest, "/") {
            << serve_thread($&hub.st, rest)
        }
    }

    if strings.has_prefix(&path, "/a/") && method == "GET" {
        aid := path[3:path.len]
        if aid.len > 0 && !strings.contains(&aid, "/") {
            << serve_agent($&hub.st, aid)
        }
    }

    if path == "/help" && method == "GET" {
        << serve_help(&hub.st)
    }

    if path == "/" && method == "GET" {
        << serve_home($&hub.st, now)
    }

    if strings.has_prefix(&path, "/v1/") || strings.has_prefix(&path, "/internal/") {
        << err_resp(404, "ERR_NOT_FOUND", "endpoint not found", 0, 0, 0)
    }
    << serve_error_html(&hub.st, 404, "ERR_NOT_FOUND", "No page or data resource exists at " + path)
}

pub struct ActorPair {
    pub actor_type string
    pub actor_id string
}

fn resolve_actor_type_id(req &HttpReq, resp &HttpResp) ActorPair {
    p_only := path_only(req.path())
    if resp.status == 401 {
        << ActorPair{actor_type: "anon", actor_id: ""}
    }
    if (p_only == "/internal/metrics" || strings.has_prefix(&p_only, "/internal/admin/")) && (resp.status == 403 || resp.status == 404) {
        << ActorPair{actor_type: "anon", actor_id: ""}
    }
    aid := strings.trim_space(&req.header("X-Agent-Id"))
    if aid.len > 0 { << ActorPair{actor_type: "agent", actor_id: aid} }
    asec := strings.trim_space(&req.header("X-Fatext-Admin-Secret"))
    if asec.len > 0 { << ActorPair{actor_type: "admin", actor_id: ""} }
    auth_h := strings.trim_space(&req.header("Authorization"))
    if auth_h.len > 0 && (p_only == "/internal/metrics" || strings.has_prefix(&p_only, "/internal/admin/")) {
        << ActorPair{actor_type: "admin", actor_id: ""}
    }
    sec := strings.trim_space(&req.header("X-Internal-Secret"))
    if sec.len > 0 { << ActorPair{actor_type: "internal", actor_id: ""} }
    if resp.status == 201 && resp.body.len > 0 {
        doc := json.parse(&resp.body)
        if doc.ok() && doc.is_dict(doc.root()) {
            if doc.has(doc.root(), "agent_id") {
                ra := json_str_or(&doc, doc.get(doc.root(), "agent_id"), "")
                if ra.len > 0 { << ActorPair{actor_type: "agent", actor_id: ra} }
            }
        }
    }
    << ActorPair{actor_type: "anon", actor_id: ""}
}

pub fn hub_loop(hub_init HubState, jobs chan HubJob) {
    $hub := hub_init
    while true {
        job := <-jobs
        t_start := time.now()
        now := time.now_time().unix()
        sweep_state_maps($&hub.st, now)

        if job.kind == HUB_CONFIG_RELOAD {
            reload_configs($&hub.st, now)
            rebuild_per_channel_today_json($&hub)
            hub.pub_stats_ts = 0
            ->
        }
        if job.kind == HUB_ENTITY_STATS_UPDATE {
            es := &job.entity_stats
            hub.entity_cache = EntityStatsCache{
                ts: es.ts,
                agents_total: es.agents_total,
                agents_active: es.agents_active,
                agents_revoked: es.agents_revoked,
                agents_suspended: es.agents_suspended,
                controllers_total: es.controllers_total,
                managed_agents_total: es.managed_agents_total,
                rooms_total: es.rooms_total,
                posts_today: es.posts_today,
                per_channel_today_json: es.per_channel_today_json + ""
            }
            sync_ch_posts_today_from_cache($&hub, now)
            ->
        }
        if job.kind == HUB_METRIC_FLUSH {
            acl := hub.clients.len
            lch := hub.log_ch
            flushed := metrics_flush_and_reset($&hub.metrics, acl, now, lch)
            metrics_add_into($&hub.cum_metrics, &flushed)
            if job.flag == 1 {
                job.reply_ch <- reply_http(json_resp(200, "{}"), 0, 0, "", "internal", "")
            }
            ->
        }
        if job.kind == HUB_METRIC_TLS {
            if job.flag == 1 { hub.metrics.tls_ok += 1 }
            else { hub.metrics.tls_fail += 1 }
            ->
        }
        if job.kind == HUB_METRIC_GC {
            hub.metrics.mail_gc_deleted += job.flag
            ->
        }
        if job.kind == HUB_SHUTDOWN_DRAIN {
            hub.draining = true
            for i in 0:hub.clients.len {
                _ := send_sse_msg(&hub.clients[i], SSE_CTRL_SHUTDOWN)
            }
            hub.clients = []SseClient{}
            sac := $&hub.sse_agent_counts
            sac.clear()
            job.reply_ch <- reply_http(json_resp(200, "{\"ok\":true}"), 0, 0, "", "internal", "")
            ->
        }

        $q_ms := 0
        if job.enqueued_ns > 0 {
            d := (t_start - job.enqueued_ns) / 1000000
            if d > 0 { q_ms = d }
        }

        if job.kind == HUB_SSE_UNSUB {
            $next_clients := []SseClient{}
            $unsub_aids := []string{}
            for i in 0:hub.clients.len {
                c := &hub.clients[i]
                if c.id != job.sse_id {
                    next_clients.push(SseClient{
                        id: c.id,
                        agent_id: c.agent_id + "",
                        controller_id: c.controller_id + "",
                        stop_ch: c.stop_ch,
                        channels: clone_str_slice(&c.channels),
                        rooms: clone_str_slice(&c.rooms),
                        ch: c.ch
                    })
                } else {
                    unsub_aids.push(c.agent_id + "")
                }
            }
            hub.clients = next_clients
            for k in 0:unsub_aids.len {
                sse_count_dec($&hub, unsub_aids[k] + "")
            }
            hub.metrics.sse_closed += 1
            job.reply_ch <- reply_http(json_resp(200, "{\"ok\":true}"), 0, 0, "", "", "")
            ->
        }

        admin_req := is_valid_admin_request(&hub, &job.req)
        if !(job.kind == HUB_HTTP && is_public_write(&job.req)) && !admin_req && !check_ip_rate_limit($&hub, job.req.remote_ip + "", now) {
            r429 := err_resp(429, "ERR_RATE_LIMITED", "IP rate limit exceeded", 60, now + 60, 0)
            slow := hub.slow_ms
            metrics_record_http($&hub.metrics, 429, job.req.req_body.len, r429.body.len, q_ms, 0, q_ms, slow)
            job.reply_ch <- reply_http(r429, q_ms, 0, "ERR_RATE_LIMITED", "anon", "")
            ->
        }

        if job.kind == HUB_SSE_SUB {
            if job.req.method() != "GET" {
                r405 := err_resp(405, "ERR_BAD_REQUEST", "method not allowed", 0, 0, 0)
                slow := hub.slow_ms
                metrics_record_http($&hub.metrics, 405, job.req.req_body.len, r405.body.len, q_ms, 0, q_ms, slow)
                job.reply_ch <- reply_http(r405, q_ms, 0, "ERR_BAD_REQUEST", "anon", "")
                ->
            }
            au := authenticate_scoped($&hub.st, &job.req, now, "stream")
            if !au.ok {
                h_ms := (time.now() - t_start) / 1000000
                r_err := err_resp(au.status, au.code, au.message, 0, 0, 0)
                aid_hdr := strings.trim_space(&job.req.header("X-Agent-Id"))
                $atyp := "anon"
                $alog_id := ""
                if au.status != 401 && aid_hdr.len > 0 {
                    atyp = "agent"
                    alog_id = aid_hdr + ""
                }
                slow := hub.slow_ms
                metrics_record_http($&hub.metrics, au.status, job.req.req_body.len, r_err.body.len, q_ms, h_ms, q_ms + h_ms, slow)
                job.reply_ch <- reply_http(r_err, q_ms, h_ms, au.code + "", atyp, alog_id)
                ->
            }
            if hub.draining {
                h_ms := (time.now() - t_start) / 1000000
                r503 := err_resp(503, "ERR_OVERLOADED", "server is draining", 5, now + 5, 0)
                slow := hub.slow_ms
                metrics_record_http($&hub.metrics, 503, job.req.req_body.len, r503.body.len, q_ms, h_ms, q_ms + h_ms, slow)
                job.reply_ch <- reply_http(r503, q_ms, h_ms, "ERR_OVERLOADED", "agent", au.agent_id + "")
                ->
            }
            if hub.max_sse > 0 && hub.clients.len >= hub.max_sse {
                h_ms := (time.now() - t_start) / 1000000
                r503 := err_resp(503, "ERR_OVERLOADED", "max concurrent SSE streams reached", 5, now + 5, 0)
                slow := hub.slow_ms
                metrics_record_http($&hub.metrics, 503, job.req.req_body.len, r503.body.len, q_ms, h_ms, q_ms + h_ms, slow)
                job.reply_ch <- reply_http(r503, q_ms, h_ms, "ERR_OVERLOADED", "agent", au.agent_id + "")
                ->
            }
            if hub.max_sse_per_agent > 0 {
                agent_sse := map_get_or(&hub.sse_agent_counts, au.agent_id + "", 0)
                if agent_sse >= hub.max_sse_per_agent {
                    h_ms := (time.now() - t_start) / 1000000
                    r429 := err_resp(429, "ERR_RATE_LIMITED", "too many concurrent SSE streams for agent", 5, now + 5, 0)
                    slow := hub.slow_ms
                    metrics_record_http($&hub.metrics, 429, job.req.req_body.len, r429.body.len, q_ms, h_ms, q_ms + h_ms, slow)
                    job.reply_ch <- reply_http(r429, q_ms, h_ms, "ERR_RATE_LIMITED", "agent", au.agent_id + "")
                    ->
                }
            }
            sid := hub.next_sse_id
            hub.next_sse_id += 1
            ch := chan string{cap: 64}
            chs := parse_csv_query_param(job.req.path(), "channels")
            rms := parse_csv_query_param(job.req.path(), "rooms")
            stop_ch := chan int{cap: 1}
            cli := SseClient{
                id: sid,
                agent_id: au.agent_id + "",
                controller_id: au.agent.controller_id + "",
                stop_ch: stop_ch,
                channels: chs,
                rooms: rms,
                ch: ch
            }
            hub.clients.push(cli)
            sse_count_inc($&hub, au.agent_id + "")
            hub.metrics.sse_opened += 1
            if hub.clients.len > hub.metrics.peak_sse {
                hub.metrics.peak_sse = hub.clients.len
            }
            h_ms := (time.now() - t_start) / 1000000
            ev_f := "\"sse_id\":" + strconv.itoa(sid) +
                ",\"agent_id\":" + json.quote(&au.agent_id) +
                ",\"active_sse\":" + strconv.itoa(hub.clients.len) +
                ",\"ip\":" + json.quote(&job.req.remote_ip)
            log_event_json(hub.log_ch, now, "sse_open", ev_f)
            job.reply_ch <- HubReply{
                resp: HttpResp{status: 200, ctype: "text/event-stream", extra: "", body: ""},
                is_sse: true,
                sse_id: sid,
                sse_ch: ch,
                sse_expires_at: au.agent.cred_expires_at,
                sse_stop: stop_ch,
                queue_ms: q_ms,
                handle_ms: h_ms,
                err_code: "",
                actor_type: "agent",
                actor_id: au.agent_id + ""
            }
            ->
        }

        if job.kind == HUB_MODERATION_PREFLIGHT {
            $resp := dispatch_http($&hub, &job.req, now, true, false)
            if resp.status == 200 {
                aid_pf := strings.trim_space(&job.req.header("X-Agent-Id"))
                st_pf := $&hub.st
                if job.flag == 1 && aid_pf.len > 0 && map_get_or(&st_pf.moderation_inflight, aid_pf + "", 0) > now {
                    resp = err_resp(429, "ERR_RATE_LIMITED", "moderation already in flight for agent", 2, now + 2, 0)
                } else {
                    resp = preflight_public_review(st_pf, &job.req, now)
                    if resp.status >= 400 {
                        consume_request_replay(st_pf, &job.req, now)
                    } else if resp.status == 200 && job.flag == 1 && aid_pf.len > 0 {
                        map_set($&st_pf.moderation_inflight, aid_pf + "", now + 10)
                    }
                }
            }
            h_ms := (time.now() - t_start) / 1000000
            ec := extract_err_code(resp.status, &resp.body)
            actor_pair := resolve_actor_type_id(&job.req, &resp)
            if resp.status >= 400 {
                slow := hub.slow_ms
                metrics_record_http($&hub.metrics, resp.status, job.req.req_body.len, resp.body.len, q_ms, h_ms, q_ms + h_ms, slow)
            }
            job.reply_ch <- reply_http(resp, q_ms, h_ms, ec, actor_pair.actor_type + "", actor_pair.actor_id + "")
            ->
        }

        $resp := json_resp(200, "{}")
        priority := moderation_verdict_priority(job.flag)
        if priority.len > 0 {
            resp = dispatch_http($&hub, &job.req, now, true, false)
            if resp.status == 200 {
                consume_request_replay($&hub.st, &job.req, now)
                resp = queue_publication_review($&hub.st, &job.req, now, "ai", priority)
            }
        } else if job.flag == MODERATION_UNAVAILABLE {
            resp = err_resp(503, "ERR_MODERATION_UNAVAILABLE", "public content moderation unavailable", 5, 0, 0)
        } else {
            resp = dispatch_http($&hub, &job.req, now, false, job.flag == MODERATION_REVIEWED)
        }
        if is_public_write(&job.req) {
            aid_rel := strings.trim_space(&job.req.header("X-Agent-Id"))
            if aid_rel.len > 0 {
                st_rel := $&hub.st
                map_del($&st_rel.moderation_inflight, aid_rel + "")
            }
        }
        $h_ms := (time.now() - t_start) / 1000000
        if h_ms < 0 { h_ms = 0 }
        ec := extract_err_code(resp.status, &resp.body)
        actor_pair := resolve_actor_type_id(&job.req, &resp)
        slow := hub.slow_ms
        metrics_record_http($&hub.metrics, resp.status, job.req.req_body.len, resp.body.len, q_ms, h_ms, q_ms + h_ms, slow)
        job.reply_ch <- reply_http(resp, q_ms, h_ms, ec, actor_pair.actor_type + "", actor_pair.actor_id + "")
    }
}
