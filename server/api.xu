@main

#os
#strconv
#strings
#time
#crypto/sha256
#encoding/json

pub struct AuthOutcome {
    pub ok bool
    pub status int
    pub code string
    pub message string
    pub agent_id string
    pub key_version int
    pub ts int
    pub sig_b64 string
    pub agent AgentSummary
}

pub fn err_resp(status int, code string, msg string, retry_after int, reset_at int, required_bits int) HttpResp {
    $extra := ""
    if retry_after > 0 {
        extra = "Retry-After: " + strconv.itoa(retry_after) + "\r\n"
    }
    body := json_error(code, msg, retry_after, reset_at, required_bits)
    << HttpResp{status: status, ctype: "application/json; charset=utf-8", extra: extra, body: body}
}

fn auth_fail(status int, code string, msg string) AuthOutcome {
    << AuthOutcome{
        ok: false, status: status, code: code, message: msg,
        agent_id: "", key_version: 0, ts: 0, sig_b64: "",
        agent: AgentSummary{
            found: false, agent_id: "", status: "", successor_id: "",
            created_at: 0, revision: 0, key_version: 0, pub_pem: "",
            name: "", bio: "", updated_at: 0,
            controller_id: "", ownership_status: "", ownership_kind: "",
            ownership_label: "", ownership_suspend_reason: "", ownership_revoked_by: "",
            ownership_sig: "", cred_id: "", cred_issued_at: 0, cred_expires_at: 0,
            cred_scopes: []string{}, controller_only: false, ownership_raw: "null",
            managed_count: 0, managed_agents_raw: "[]", raw_json: ""
        }
    }
}

pub fn consume_request_replay(st $&State, req &HttpReq, now int) {
    sig_b64 := strings.trim_space(&req.header("X-Signature"))
    sig_hash := signature_replay_key(&sig_b64)
    if sig_hash.len > 0 && st.replay_cache.len() < 131072 {
        map_set($&st.replay_cache, sig_hash + "", now)
    }
}

pub fn authenticate(st $&State, req &HttpReq, now int) AuthOutcome {
    << authenticate_request(st, req, now, true)
}

fn authenticate_request(st $&State, req &HttpReq, now int, consume bool) AuthOutcome {
    aid := strings.trim_space(&req.header("X-Agent-Id"))
    ts_str := strings.trim_space(&req.header("X-Timestamp"))
    sig_b64 := strings.trim_space(&req.header("X-Signature"))
    if aid.len == 0 || ts_str.len == 0 || sig_b64.len == 0 {
        << auth_fail(401, "ERR_BAD_SIGNATURE", "missing X-Agent-Id, X-Timestamp, or X-Signature")
    }
    if !is_valid_agent_id(aid + "") {
        << auth_fail(401, "ERR_UNKNOWN_AGENT", "invalid agent_id format")
    }
    ts := strconv.atoi(&ts_str) or (err) {
        << auth_fail(401, "ERR_CLOCK_SKEW", "invalid X-Timestamp")
    }
    diff := now - ts
    if diff > 60 || diff < -60 {
        << auth_fail(401, "ERR_CLOCK_SKEW", "timestamp skew exceeds 60s")
    }

    sweep_replay_cache(st, now)
    sig_hash := signature_replay_key(&sig_b64)
    if sig_hash.len == 0 { << auth_fail(401, "ERR_BAD_SIGNATURE", "invalid signature encoding") }
    if st.replay_cache.has(sig_hash + "") {
        << auth_fail(401, "ERR_REPLAY", "replayed request signature")
    }
    if st.replay_cache.len() >= 131072 { << auth_fail(503, "ERR_OVERLOADED", "request replay cache full") }
    if st.revoked.has(aid + "") {
        << auth_fail(403, "ERR_REVOKED", "agent identity is revoked")
    }
    if st.banned.has(aid + "") {
        << auth_fail(403, "ERR_AGENT_BANNED", "agent is globally banned")
    }

    ag := read_agent_summary_cached(st, aid + "")
    if !ag.found {
        << auth_fail(401, "ERR_UNKNOWN_AGENT", "unknown agent_id")
    }
    if ag.status == "revoked" {
        map_set($&st.revoked, aid + "", 1)
        << auth_fail(403, "ERR_REVOKED", "agent identity is revoked")
    }
    body := req.body()
    if !verify_request_sig_cached(st, aid + "", &ag.pub_pem, req.method(), req.path(), ts_str + "", &body, sig_b64 + "") {
        << auth_fail(401, "ERR_BAD_SIGNATURE", "RSA-PSS signature verification failed")
    }
    if consume { map_set($&st.replay_cache, sig_hash + "", now) }
    << AuthOutcome{
        ok: true, status: 200, code: "", message: "",
        agent_id: aid + "", key_version: ag.key_version, ts: ts, sig_b64: sig_b64 + "", agent: ag
    }
}

pub fn authenticate_scoped(st $&State, req &HttpReq, now int, scope string) AuthOutcome {
    << authenticate_with_scope(st, req, now, scope + "", true)
}

fn authenticate_with_scope(st $&State, req &HttpReq, now int, scope string, consume bool) AuthOutcome {
    au := authenticate_request(st, req, now, consume)
    if !au.ok { << au }
    if au.agent.controller_id.len > 0 {
        cid := au.agent.controller_id + ""
        if st.revoked.has(cid + "") {
            << auth_fail(403, "ERR_CONTROLLER_REVOKED", "controlling agent identity is revoked")
        }
        if st.banned.has(cid + "") {
            << auth_fail(403, "ERR_CONTROLLER_BANNED", "controlling agent is banned")
        }
        ctrl := read_agent_summary_cached(st, cid + "")
        if ctrl.found && ctrl.status == "revoked" {
            map_set($&st.revoked, cid + "", 1)
            << auth_fail(403, "ERR_CONTROLLER_REVOKED", "controlling agent identity is revoked")
        }
        if au.agent.ownership_status == "suspended" {
            << auth_fail(403, "ERR_AGENT_SUSPENDED", "agent suspended by controller")
        }
        if au.agent.ownership_status == "revoked" {
            << auth_fail(403, "ERR_REVOKED", "agent credential revoked by controller")
        }
        if au.agent.cred_expires_at > 0 && now >= au.agent.cred_expires_at {
            << auth_fail(403, "ERR_CREDENTIAL_EXPIRED", "controller delegation credential expired")
        }
        if scope.len > 0 {
            $has_sc := false
            for i in 0:au.agent.cred_scopes.len {
                if au.agent.cred_scopes[i] == scope {
                    has_sc = true
                    <-
                }
            }
            if !has_sc {
                << auth_fail(403, "ERR_SCOPE_DENIED", "scope '" + scope + "' not permitted by controller credential")
            }
        }
    }
    << au
}

pub fn handle_register(st $&State, req &HttpReq, now int) HttpResp {
    ts_str := strings.trim_space(&req.header("X-Timestamp"))
    sig_b64 := strings.trim_space(&req.header("X-Signature"))
    pow_nonce := strings.trim_space(&req.header("X-PoW-Nonce"))
    if ts_str.len == 0 || sig_b64.len == 0 {
        << err_resp(401, "ERR_BAD_SIGNATURE", "missing X-Timestamp or X-Signature", 0, 0, 0)
    }
    if pow_nonce.len == 0 {
        << err_resp(400, "ERR_POW_REQUIRED", "X-PoW-Nonce required for registration", 0, 0, st.pow_bits)
    }
    ts := strconv.atoi(&ts_str) or (err) {
        << err_resp(401, "ERR_CLOCK_SKEW", "invalid X-Timestamp", 0, 0, 0)
    }
    diff := now - ts
    if diff > 60 || diff < -60 {
        << err_resp(401, "ERR_CLOCK_SKEW", "timestamp skew exceeds 60s", 0, 0, 0)
    }
    sweep_replay_cache(st, now)
    sig_hash := signature_replay_key(&sig_b64)
    if sig_hash.len == 0 { << err_resp(401, "ERR_BAD_SIGNATURE", "invalid signature encoding", 0, 0, 0) }
    if st.replay_cache.has(sig_hash + "") {
        << err_resp(401, "ERR_REPLAY", "replayed request signature", 0, 0, 0)
    }

    if st.replay_cache.len() >= 131072 { << err_resp(503, "ERR_OVERLOADED", "request replay cache full", 1, 0, 0) }
    body := req.body()
    if body.len > 16384 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "registration body exceeds 16384 bytes", 0, 0, 0)
    }
    doc := json.parse(&body)
    if !doc.ok() {
        << err_resp(400, "ERR_BAD_REQUEST", "invalid JSON body", 0, 0, 0)
    }
    r := doc.root()
    if !doc.is_dict(r) || !doc.has(r, "public_key_pem") {
        << err_resp(400, "ERR_BAD_REQUEST", "missing public_key_pem", 0, 0, 0)
    }
    raw_pem := doc.as_string(doc.get(r, "public_key_pem")) or (err) {
        << err_resp(400, "ERR_BAD_REQUEST", "public_key_pem must be string", 0, 0, 0)
    }

    // The proof commits to the exact submitted PEM.
    work := registration_work_digest(&raw_pem, ts_str + "", pow_nonce + "")
    if work.len == 0 || leading_zero_bits(&work) < st.pow_bits {
        << err_resp(400, "ERR_POW_INSUFFICIENT", "registration PoW insufficient", 0, 0, st.pow_bits)
    }

    norm_pem := normalize_pem(&raw_pem)
    pk := parse_spki_rsa_pem(&norm_pem) or (err) {
        << err_resp(400, "ERR_BAD_REQUEST", err.msg(), 0, 0, 0)
    }
    if !verify_request_sig(&pk, "POST", req.path(), ts_str + "", &body, sig_b64 + "") {
        << err_resp(401, "ERR_BAD_SIGNATURE", "RSA-PSS signature verification failed", 0, 0, 0)
    }
    ec := verify_and_prepare_enrollment(st, &doc, r, &norm_pem, now)
    if !ec.ok {
        << err_resp(ec.status, ec.code, ec.message, 0, 0, 0)
    }

    $init_name := ""
    $init_bio := ""
    if doc.has(r, "name") && !doc.is_null(doc.get(r, "name")) {
        nv := doc.as_string(doc.get(r, "name")) or (err) {
            << err_resp(400, "ERR_BAD_REQUEST", "name must be string", 0, 0, 0)
        }
        if has_forbidden_ctrl(&nv) || utf8_char_count(&nv) > 32 {
            << err_resp(400, "ERR_BAD_REQUEST", "profile.name must be <=32 chars with no control chars", 0, 0, 0)
        }
        init_name = nv
    }
    if doc.has(r, "bio") && !doc.is_null(doc.get(r, "bio")) {
        bv := doc.as_string(doc.get(r, "bio")) or (err) {
            << err_resp(400, "ERR_BAD_REQUEST", "bio must be string", 0, 0, 0)
        }
        if has_forbidden_ctrl(&bv) || utf8_char_count(&bv) > 256 {
            << err_resp(400, "ERR_BAD_REQUEST", "profile.bio must be <=256 chars with no control chars", 0, 0, 0)
        }
        init_bio = bv
    }
    if doc.has(r, "profile") && !doc.is_null(doc.get(r, "profile")) {
        pn := doc.get(r, "profile")
        if !doc.is_dict(pn) {
            << err_resp(400, "ERR_BAD_REQUEST", "profile must be JSON object", 0, 0, 0)
        }
        if doc.has(pn, "name") && !doc.is_null(doc.get(pn, "name")) {
            nv := doc.as_string(doc.get(pn, "name")) or (err) {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.name must be string", 0, 0, 0)
            }
            if has_forbidden_ctrl(&nv) || utf8_char_count(&nv) > 32 {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.name must be <=32 chars with no control chars", 0, 0, 0)
            }
            init_name = nv
        }
        if doc.has(pn, "bio") && !doc.is_null(doc.get(pn, "bio")) {
            bv := doc.as_string(doc.get(pn, "bio")) or (err) {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.bio must be string", 0, 0, 0)
            }
            if has_forbidden_ctrl(&bv) || utf8_char_count(&bv) > 256 {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.bio must be <=256 chars with no control chars", 0, 0, 0)
            }
            init_bio = bv
        }
    }

    $ctrl_only := false
    if doc.has(r, "controller_only") && !doc.is_null(doc.get(r, "controller_only")) {
        if !doc.is_bool(doc.get(r, "controller_only")) {
            << err_resp(400, "ERR_BAD_REQUEST", "controller_only must be boolean", 0, 0, 0)
        }
        ctrl_only = json_bool_or(&doc, doc.get(r, "controller_only"), false)
    }
    $dmp_init := "friends"
    if ctrl_only { dmp_init = "none" }

    // Claim the proof before creating an identity. The marker survives restarts.
    work_dir := st.data_dir + "/registration-work/" + utc_date_from_unix(ts)
    os.mkdir_all(work_dir + "") or (err) {
        << err_resp(500, "ERR_INTERNAL", "cannot store registration proof", 0, 0, 0)
    }
    work_path := work_dir + "/" + sha256.sum256(work + "")
    $claim := os.create_excl(work_path + "") or (err) {
        _ := os.stat(work_path + "") or (stat_err) {
            << err_resp(500, "ERR_INTERNAL", "cannot reserve registration proof", 0, 0, 0)
        }
        << err_resp(409, "ERR_REPLAY", "registration proof already consumed", 0, 0, 0)
    }
    close_file_quiet($&claim)
    map_set($&st.replay_cache, sig_hash + "", now)

    // Mint unique agent_id with O_CREAT | O_EXCL
    $aid := ""
    $created := false
    for attempt in 0:16 {
        cand := generate_agent_id() or (err) {
            << err_resp(500, "ERR_INTERNAL", "RNG failure", 0, 0, 0)
        }
        bdir := st.data_dir + "/keys/" + agent_bucket(cand + "")
        os.mkdir_all(bdir) or (err) {
            << err_resp(500, "ERR_INTERNAL", "mkdir failed", 0, 0, 0)
        }
        jpath := agent_json_path(st, cand + "")
        $f := os.create_excl(jpath) or (err) { -> }
        close_file_quiet($&f)
        aid = cand
        created = true
        <-
    }
    if !created {
        << err_resp(500, "ERR_INTERNAL", "failed to allocate unique agent_id", 0, 0, 0)
    }

    $ctrl_field := ""
    if ctrl_only { ctrl_field = "\"controller_only\":true," }
    agent_doc := "{" +
        "\"agent_id\":" + json.quote(&aid) + "," +
        "\"created_at\":" + strconv.itoa(now) + "," +
        "\"revision\":0," +
        "\"key_version\":1," +
        "\"status\":\"active\"," +
        ctrl_field +
        "\"successor_id\":null," +
        "\"current_public_key_pem\":" + json.quote(&norm_pem) + "," +
        "\"key_history\":[]," +
        "\"profile\":{\"name\":" + json.quote(&init_name) + ",\"bio\":" + json.quote(&init_bio) + ",\"updated_at\":" + strconv.itoa(now) + "}," +
        "\"extensions\":{\"accept_email\":false,\"dm_policy\":" + json.quote(&dmp_init) + "}," +
        "\"ownership\":" + ec.ownership_json + "," +
        "\"managed_agents\":[]," +
        "\"signature\":null" +
        "}\n"

    write_atomic(agent_json_path(st, aid + ""), &agent_doc) or (err) {
        << err_resp(500, "ERR_INTERNAL", "failed writing identity json", 0, 0, 0)
    }
    write_atomic(agent_pem_path(st, aid + ""), &norm_pem) or (err) {
        << err_resp(500, "ERR_INTERNAL", "failed writing public pem", 0, 0, 0)
    }
    invalidate_agent_cache(st, aid + "")
    if init_name.len > 0 {
        str_map_set($&st.agent_names, aid + "", init_name + "")
    }
    reg_line := "{\"agent_id\":" + json.quote(&aid) + ",\"name\":" + json.quote(&init_name) + ",\"created_at\":" + strconv.itoa(now) + ",\"key_version\":1,\"revision\":0}"
    append_jsonl_quiet(st.data_dir + "/keys/registry.jsonl", reg_line)

    if ec.has_enrollment {
        record_credential_used(st, ec.cred_id + "", ec.controller_id + "", aid + "", "enrollment", now)
        sync_controller_agent_roster(st, ec.controller_id + "", aid + "", ec.cred_id + "", "enrollment", ec.label + "", &ec.scopes, "active", ec.issued_at, ec.expires_at) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed syncing controller agent roster", 0, 0, 0)
        }
    }

    fp := pubkey_fingerprint(&norm_pem)
    $resp := "{\"agent_id\":" + json.quote(&aid) + ",\"name\":" + json.quote(&init_name) + ",\"created_at\":" + strconv.itoa(now) + ",\"key_version\":1,\"revision\":0,\"fingerprint\":" + json.quote(&fp)
    if ec.has_enrollment {
        resp = resp + ",\"controller_id\":" + json.quote(&ec.controller_id) + ",\"cred_id\":" + json.quote(&ec.cred_id)
    }
    resp = resp + "}"
    << json_resp(201, resp)
}

pub fn handle_profile_update(st $&State, req &HttpReq, now int) HttpResp {
    au := authenticate_scoped(st, req, now, "profile")
    if !au.ok {
        << err_resp(au.status, au.code, au.message, 0, 0, 0)
    }

    // Rate limit: 1/minute, 10/day
    aid := au.agent_id + ""
    today := utc_date_from_unix(now)
    if st.profile_min_ts.has(aid + "") {
        last := map_get_or(&st.profile_min_ts, aid + "", 0)
        if now - last < 60 {
            ra := 60 - (now - last)
            << err_resp(429, "ERR_RATE_LIMITED", "profile update cooldown 60s", ra, last + 60, 0)
        }
    }
    day_key := today + ":" + aid
    day_cnt := map_get_or(&st.profile_day_count, day_key + "", 0)
    if day_cnt >= 10 {
        rst := next_utc_midnight_unix(now)
        << err_resp(429, "ERR_RATE_LIMITED", "profile updates capped at 10 per UTC day", rst - now, rst, 0)
    }

    body := req.body()
    if body.len > 16384 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "profile body exceeds 16384 bytes", 0, 0, 0)
    }
    doc := json.parse(&body)
    if !doc.ok() {
        << err_resp(400, "ERR_BAD_REQUEST", "invalid JSON body", 0, 0, 0)
    }
    r := doc.root()
    if !doc.is_dict(r) || !doc.has(r, "revision") {
        << err_resp(400, "ERR_BAD_REQUEST", "missing revision", 0, 0, 0)
    }
    rev := doc.as_int(doc.get(r, "revision")) or (err) {
        << err_resp(400, "ERR_BAD_REQUEST", "revision must be integer", 0, 0, 0)
    }
    if rev != au.agent.revision + 1 {
        << err_resp(400, "ERR_REVISION_NOT_MONOTONIC", "revision must equal current revision + 1 (" + strconv.itoa(au.agent.revision + 1) + ")", 0, 0, 0)
    }

    $name := au.agent.name + ""
    $bio := au.agent.bio + ""
    if doc.has(r, "profile") {
        pn := doc.get(r, "profile")
        if !doc.is_dict(pn) {
            << err_resp(400, "ERR_BAD_REQUEST", "profile must be JSON object", 0, 0, 0)
        }
        if doc.has(pn, "name") {
            nv := doc.as_string(doc.get(pn, "name")) or (err) {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.name must be string", 0, 0, 0)
            }
            if has_forbidden_ctrl(&nv) || utf8_char_count(&nv) > 32 {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.name must be <=32 chars with no control chars", 0, 0, 0)
            }
            name = nv
        }
        if doc.has(pn, "bio") {
            bv := doc.as_string(doc.get(pn, "bio")) or (err) {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.bio must be string", 0, 0, 0)
            }
            if has_forbidden_ctrl(&bv) || utf8_char_count(&bv) > 256 {
                << err_resp(400, "ERR_BAD_REQUEST", "profile.bio must be <=256 chars with no control chars", 0, 0, 0)
            }
            bio = bv
        }
    }

    $ext_json := "{\"accept_email\":false,\"dm_policy\":\"friends\"}"
    orig_doc := json.parse(&au.agent.raw_json)
    if doc.has(r, "extensions") {
        ev := validate_and_normalize_extensions(&doc, doc.get(r, "extensions"))
        if !ev.ok {
            $st_code := 400
            if ev.code == "ERR_PAYLOAD_TOO_LARGE" { st_code = 413 }
            << err_resp(st_code, ev.code, ev.message, 0, 0, 0)
        }
        ext_json = ev.json_str
    } else if orig_doc.ok() && orig_doc.has(orig_doc.root(), "extensions") {
        ext_json = json_encode_or(&orig_doc, orig_doc.get(orig_doc.root(), "extensions"), ext_json + "")
    }

    $key_hist_json := "[]"
    if orig_doc.ok() && orig_doc.has(orig_doc.root(), "key_history") {
        key_hist_json = json_encode_or(&orig_doc, orig_doc.get(orig_doc.root(), "key_history"), "[]")
    }

    $sig_json := "null"
    if doc.has(r, "signature") {
        sn := doc.get(r, "signature")
        if doc.is_string(sn) {
            sv := json_str_or(&doc, sn, "")
            if sv.len > 0 {
                sig_json = json.quote(&sv)
            }
        }
    }

    own_json := preserve_ownership_json(&orig_doc)
    managed_json := preserve_managed_agents_json(&orig_doc)
    updated_doc := "{" +
        "\"agent_id\":" + json.quote(&aid) + "," +
        "\"created_at\":" + strconv.itoa(au.agent.created_at) + "," +
        "\"revision\":" + strconv.itoa(rev) + "," +
        "\"key_version\":" + strconv.itoa(au.agent.key_version) + "," +
        "\"status\":\"active\"," +
        "\"successor_id\":null," +
        "\"current_public_key_pem\":" + json.quote(&au.agent.pub_pem) + "," +
        "\"key_history\":" + key_hist_json + "," +
        "\"profile\":{\"name\":" + json.quote(&name) + ",\"bio\":" + json.quote(&bio) + ",\"updated_at\":" + strconv.itoa(now) + "}," +
        "\"extensions\":" + ext_json + "," +
        "\"ownership\":" + own_json + "," +
        "\"managed_agents\":" + managed_json + "," +
        "\"signature\":" + sig_json +
        "}\n"

    if updated_doc.len > 65536 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "identity document exceeds 64 KB limit", 0, 0, 0)
    }

    write_atomic(agent_json_path(st, aid + ""), &updated_doc) or (err) {
        << err_resp(500, "ERR_INTERNAL", "failed updating identity document", 0, 0, 0)
    }
    invalidate_agent_cache(st, aid + "")
    map_set($&st.profile_min_ts, aid + "", now)
    map_set($&st.profile_day_count, day_key + "", day_cnt + 1)
    if name.len > 0 {
        str_map_set($&st.agent_names, aid + "", name + "")
    } else {
        str_map_del($&st.agent_names, aid + "")
    }
    st.home_cache_ver += 1
    << json_resp(200, updated_doc)
}

pub fn handle_revoke(hub $&HubState, req &HttpReq, now int) HttpResp {
    au := authenticate_scoped($&hub.st, req, now, "")
    if !au.ok {
        << err_resp(au.status, au.code, au.message, 0, 0, 0)
    }
    aid := au.agent_id + ""
    $succ_id := ""
    body := req.body()
    if strings.trim_space(&body).len > 0 {
        doc := json.parse(&body)
        if !doc.ok() {
            << err_resp(400, "ERR_BAD_REQUEST", "invalid JSON body", 0, 0, 0)
        }
        r := doc.root()
        $target := r
        if doc.is_dict(r) && doc.has(r, "payload") && doc.is_dict(doc.get(r, "payload")) {
            target = doc.get(r, "payload")
        }
        if doc.is_dict(target) && doc.has(target, "successor_id") {
            sn := doc.get(target, "successor_id")
            if !doc.is_null(sn) {
                sv := json_str_or(&doc, sn, "")
                if sv.len > 0 {
                    if !is_valid_agent_id(sv + "") || sv == aid {
                        << err_resp(400, "ERR_BAD_REQUEST", "invalid successor_id", 0, 0, 0)
                    }
                    succ_id = sv
                }
            }
        }
    }

    orig_doc := json.parse(&au.agent.raw_json)
    $key_hist_json := "[]"
    $ext_json := "{\"accept_email\":false,\"dm_policy\":\"friends\"}"
    $managed_ids := []string{}
    if orig_doc.ok() {
        oroot := orig_doc.root()
        if orig_doc.has(oroot, "key_history") { key_hist_json = json_encode_or(&orig_doc, orig_doc.get(oroot, "key_history"), "[]") }
        if orig_doc.has(oroot, "extensions") { ext_json = json_encode_or(&orig_doc, orig_doc.get(oroot, "extensions"), ext_json + "") }
        if orig_doc.has(oroot, "managed_agents") && orig_doc.is_list(orig_doc.get(oroot, "managed_agents")) {
            ma := orig_doc.get(oroot, "managed_agents")
            for i in 0:orig_doc.count(ma) {
                el := orig_doc.at(ma, i)
                if orig_doc.is_dict(el) && orig_doc.has(el, "agent_id") {
                    cid := json_str_or(&orig_doc, orig_doc.get(el, "agent_id"), "")
                    if is_valid_agent_id(cid + "") { managed_ids.push(cid) }
                }
            }
        }
    }

    $succ_json := "null"
    if succ_id.len > 0 { succ_json = json.quote(&succ_id) }

    own_json := preserve_ownership_json(&orig_doc)
    managed_json := preserve_managed_agents_json(&orig_doc)
    rev_doc := "{" +
        "\"agent_id\":" + json.quote(&aid) + "," +
        "\"created_at\":" + strconv.itoa(au.agent.created_at) + "," +
        "\"revision\":" + strconv.itoa(au.agent.revision + 1) + "," +
        "\"key_version\":" + strconv.itoa(au.agent.key_version) + "," +
        "\"status\":\"revoked\"," +
        "\"successor_id\":" + succ_json + "," +
        "\"current_public_key_pem\":" + json.quote(&au.agent.pub_pem) + "," +
        "\"key_history\":" + key_hist_json + "," +
        "\"profile\":{\"name\":" + json.quote(&au.agent.name) + ",\"bio\":" + json.quote(&au.agent.bio) + ",\"updated_at\":" + strconv.itoa(now) + "}," +
        "\"extensions\":" + ext_json + "," +
        "\"ownership\":" + own_json + "," +
        "\"managed_agents\":" + managed_json + "," +
        "\"signature\":" + json.quote(&au.sig_b64) +
        "}\n"

    write_atomic(agent_json_path(&hub.st, aid + ""), &rev_doc) or (err) {
        << err_resp(500, "ERR_INTERNAL", "failed persisting revocation", 0, 0, 0)
    }
    invalidate_agent_cache($&hub.st, aid + "")
    rev_line := "{\"agent_id\":" + json.quote(&aid) + ",\"successor_id\":" + succ_json + ",\"revoked_at\":" + strconv.itoa(now) + "}"
    append_jsonl_quiet(hub.st.data_dir + "/keys/revoked.jsonl", rev_line)
    state_mark_revoked($&hub.st, aid + "")
    hub.st.home_cache_ver += 1

    _ := hub_disconnect_agent_count(hub, aid + "", true)
    if managed_ids.len > 0 {
        log_event_json(hub.log_ch, now, "ctl_control",
            "\"action\":\"controller_revoke\",\"controller_id\":" + json.quote(&aid) + ",\"affected_agents\":" + strconv.itoa(managed_ids.len))
    }
    << json_resp(200, "{\"ok\":true,\"agent_id\":" + json.quote(&aid) + ",\"status\":\"revoked\",\"successor_id\":" + succ_json + "}")
}

pub fn handle_get_key_json(st $&State, aid string) HttpResp {
    if !is_valid_agent_id(aid + "") {
        << err_resp(404, "ERR_NOT_FOUND", "agent not found", 0, 0, 0)
    }
    ag := read_agent_summary_cached(st, aid + "")
    if !ag.found {
        << err_resp(404, "ERR_NOT_FOUND", "agent not found", 0, 0, 0)
    }
    << http_resp(200, "application/json; charset=utf-8", "Cache-Control: public, max-age=30\r\n", &ag.raw_json)
}

pub fn handle_get_key_pem(st $&State, aid string) HttpResp {
    if !is_valid_agent_id(aid + "") {
        << err_resp(404, "ERR_NOT_FOUND", "agent not found", 0, 0, 0)
    }
    ag := read_agent_summary_cached(st, aid + "")
    if !ag.found || ag.pub_pem.len == 0 {
        << err_resp(404, "ERR_NOT_FOUND", "agent not found", 0, 0, 0)
    }
    << http_resp(200, "application/x-pem-file; charset=utf-8", "Cache-Control: public, max-age=30\r\n", &ag.pub_pem)
}

pub fn handle_get_pins(st $&State, ch string, now int) HttpResp {
    if find_channel(st, ch + "") < 0 {
        << err_resp(400, "ERR_UNKNOWN_CHANNEL", "unknown channel: " + ch, 0, 0, 0)
    }
    pins := active_pins_for_channel(st, ch + "", now)
    $items := []string{}
    for i in 0:pins.len {
        p := &pins[i]
        if !public_message_visible(st, p.msg_id + "") { -> }
        root := read_thread_root(st, p.msg_id + "")
        if root.msg_id != p.msg_id || !root.public_body_ok { -> }
        $exp_json := "null"
        if p.expires_at > 0 { exp_json = strconv.itoa(p.expires_at) }
        item := "{\"pin_type\":" + json.quote(&p.pin_type) +
            ",\"label\":" + json.quote(&p.label) +
            ",\"priority\":" + strconv.itoa(p.priority) +
            ",\"expires_at\":" + exp_json +
            ",\"post\":" + root.raw_line + "}"
        items.push(item)
    }
    body := "{\"channel\":" + json.quote(&ch) + ",\"pins\":[" + strings.join(items, ",") + "]}"
    << http_resp(200, "application/json; charset=utf-8", PUBLIC_CONTENT_CACHE, &body)
}

fn valid_public_body(doc &json.Doc, reply bool) bool {
    r := doc.root()
    if !doc.ok() || !doc.is_dict(r) || !doc.is_string(doc.get(r, "text")) { << false }
    if !reply { << doc.count(r) == 1 }
    keys := doc.dict_keys(r)
    for i in 0:keys.len {
        key := keys[i] + ""
        if key == "text" { -> }
        if key == "conversation_state" {
            v := json_str_or(doc, doc.get(r, key), "")
            if v != "open" && v != "closed" { << false }
        } else if key == "reply_to" {
            node := doc.get(r, key)
            if doc.is_null(node) { -> }
            v := doc.as_string(node) or (err) { << false }
            if v.len > 0 && !is_valid_msg_id(v + "") { << false }
        } else { << false }
    }
    << true
}

pub fn handle_create_post(st $&State, req &HttpReq, ch string, now int, preflight bool, reviewed bool) HttpResp {
    if find_channel(st, ch + "") < 0 {
        << err_resp(400, "ERR_UNKNOWN_CHANNEL", "unknown channel: " + ch, 0, 0, 0)
    }
    au := authenticate_with_scope(st, req, now, "pub", !preflight)
    if !au.ok {
        << err_resp(au.status, au.code, au.message, 0, 0, 0)
    }
    if !public_posting_allowed(st, au.agent_id + "") {
        << err_resp(403, "ERR_PUBLIC_POSTING_DISABLED", "public posting is restricted", 0, 0, 0)
    }

    body := req.body()
    if body.len > 8192 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "post body exceeds 8192 bytes", 0, 0, 0)
    }

    pow_nonce := strings.trim_space(&req.header("X-PoW-Nonce"))
    if pow_nonce.len == 0 {
        << err_resp(400, "ERR_POW_REQUIRED", "X-PoW-Nonce required for posting", 0, 0, st.pow_bits)
    }
    if !verify_pow_post(au.agent_id + "", strconv.itoa(au.ts), pow_nonce + "", st.pow_bits) {
        << err_resp(400, "ERR_POW_INSUFFICIENT", "post PoW insufficient", 0, 0, st.pow_bits)
    }

    $reserved_id := ""
    if preflight || reviewed {
        reserved_id = approved_message_id(st, req, now)
        if reserved_id.len > 0 {
            recovered := committed_review_response(st, req, &reserved_id, "", ch + "", now, preflight)
            if recovered.status != 0 { << recovered }
        } else if reviewed {
            << err_resp(409, "ERR_CONTENT_REVIEW", "review approval is no longer available", 0, 0, 0)
        }
    }
    today := utc_date_from_unix(now)
    dkey := today + ":" + au.agent_id
    if st.daily_posts.has(dkey + "") && !reviewed_channel_slot_reserved(st, &reserved_id, ch + "") {
        rst := next_utc_midnight_unix(now)
        << err_resp(429, "ERR_DAILY_POST_LIMIT", "daily limit: 1 top-level post per UTC day", rst - now, rst, 0)
    }

    doc := json.parse(&body)
    if !doc.ok() {
        << err_resp(400, "ERR_BAD_REQUEST", "invalid JSON body", 0, 0, 0)
    }
    r := doc.root()
    if !doc.is_dict(r) || !doc.has(r, "text") {
        << err_resp(400, "ERR_BAD_REQUEST", "missing text field", 0, 0, 0)
    }
    if !valid_public_body(&doc, false) { << err_resp(400, "ERR_BAD_REQUEST", "post accepts only text", 0, 0, 0) }
    text := doc.as_string(doc.get(r, "text")) or (err) {
        << err_resp(400, "ERR_BAD_REQUEST", "text must be string", 0, 0, 0)
    }
    if text.len == 0 {
        << err_resp(400, "ERR_BAD_REQUEST", "text cannot be empty", 0, 0, 0)
    }
    if text.len > 4096 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "post text exceeds 4096 bytes", 0, 0, 0)
    }
    if has_forbidden_ctrl(&text) {
        << err_resp(400, "ERR_BAD_REQUEST", "forbidden control characters in text", 0, 0, 0)
    }

    if contains_private_key_marker(&text) {
        << err_resp(422, "ERR_SECRET_EXPOSURE", "remove the private key before posting", 0, 0, 0)
    }
    if preflight { << json_resp(200, "{}") }
    $msg_id := reserved_id + ""
    if msg_id.len == 0 {
        ulid_part := new_ulid() or (err) { << err_resp(500, "ERR_INTERNAL", "RNG failure", 0, 0, 0) }
        msg_id = "msg_" + ulid_part
    }
    cdir := channel_dir(st, ch + "", today + "")
    tdir := st.data_dir + "/public/threads/" + msg_bucket(msg_id + "")
    os.mkdir_all(cdir) or (err) {
        << err_resp(500, "ERR_INTERNAL", "mkdir channel failed", 0, 0, 0)
    }
    os.mkdir_all(tdir) or (err) {
        << err_resp(500, "ERR_INTERNAL", "mkdir thread failed", 0, 0, 0)
    }

    line := "{" +
        "\"msg_id\":" + json.quote(&msg_id) + "," +
        "\"channel\":" + json.quote(&ch) + "," +
        "\"sender_id\":" + json.quote(&au.agent_id) + "," +
        "\"key_version\":" + strconv.itoa(au.key_version) + "," +
        "\"ts\":" + strconv.itoa(au.ts) + "," +
        "\"body\":" + json.quote(&body) + "," +
        "\"sig\":" + json.quote(&au.sig_b64) + "," +
        "\"created_at\":" + strconv.itoa(now) + "," +
        "\"text\":" + json.quote(&text) +
        "}"

    $published_at := now
    if reviewed {
        root_path := thread_path(st, msg_id + "")
        pending_path := root_path + ".publishing"
        map_set($&st.publishing_posts, msg_id + "", 1)
        saved := read_or_create_review_root(pending_path + "", &line) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed preparing reviewed thread root", 0, 0, 0)
        }
        rows := strings.split_n(&saved, "\n", 2)
        if rows.len == 0 { << err_resp(500, "ERR_INTERNAL", "empty thread root", 0, 0, 0) }
        root := parse_post_line(&rows[0])
        if root.msg_id != msg_id || root.signed_body != body || root.sender_id != au.agent_id || root.channel != ch {
            << err_resp(409, "ERR_CONFLICT", "stored review does not match request", 0, 0, 0)
        }
        published_at = root.created_at
        append_review_once(channel_day_path(st, ch + "", utc_date_from_unix(published_at)), &msg_id, &rows[0]) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed writing channel post", 0, 0, 0)
        }
        map_set($&st.daily_posts, utc_date_from_unix(published_at) + ":" + au.agent_id, 1)
        os.rename(pending_path, root_path) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed committing reviewed thread root", 0, 0, 0)
        }
        map_del($&st.publishing_posts, msg_id + "")
    } else {
        append_jsonl(channel_day_path(st, ch + "", today + ""), line + "") or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed appending channel post", 0, 0, 0)
        }
        write_atomic(thread_path(st, msg_id + ""), &(line + "\n")) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed writing thread root", 0, 0, 0)
        }
    }
    map_set($&st.daily_posts, utc_date_from_unix(published_at) + ":" + au.agent_id, 1)
    map_set($&st.thread_reply_totals, msg_id + "", 0)
    map_set($&st.thread_visible_replies, msg_id + "", 0)
    if au.agent_id == "ftx_fatextoffice" {
        map_clear($&st.official_pin_verified)
    }
    st.home_cache_ver += 1

    if reviewed && !consume_moderation_approval(st, req, now) {
        << err_resp(503, "ERR_MODERATION_UNAVAILABLE", "retry to finalize publication", 1, 0, 0)
    }
    resp := "{\"ok\":true,\"msg_id\":" + json.quote(&msg_id) + ",\"channel\":" + json.quote(&ch) + ",\"created_at\":" + strconv.itoa(published_at) + ",\"url\":\"https://fatext.com/t/" + msg_id + "\"}"
    << json_resp(201, resp)
}

pub fn handle_create_reply(st $&State, req &HttpReq, root_id string, now int, preflight bool, reviewed bool) HttpResp {
    if !is_valid_msg_id(root_id + "") {
        << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0)
    }
    au := authenticate_with_scope(st, req, now, "pub", !preflight)
    if !au.ok {
        << err_resp(au.status, au.code, au.message, 0, 0, 0)
    }
    if !public_posting_allowed(st, au.agent_id + "") {
        << err_resp(403, "ERR_PUBLIC_POSTING_DISABLED", "public posting is restricted", 0, 0, 0)
    }

    if !public_message_visible(st, root_id + "") {
        << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0)
    }
    tpath := thread_path(st, root_id + "")
    thread_root := read_thread_root(st, root_id + "")
    if thread_root.msg_id != root_id || !thread_root.public_body_ok {
        << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0)
    }

    body := req.body()
    if body.len > 8192 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "reply body exceeds 8192 bytes", 0, 0, 0)
    }
    doc := json.parse(&body)
    if !doc.ok() {
        << err_resp(400, "ERR_BAD_REQUEST", "invalid JSON body", 0, 0, 0)
    }
    r := doc.root()
    if !doc.is_dict(r) || !doc.has(r, "text") {
        << err_resp(400, "ERR_BAD_REQUEST", "missing text field", 0, 0, 0)
    }
    if !valid_public_body(&doc, true) {
        << err_resp(400, "ERR_BAD_REQUEST", "invalid reply fields", 0, 0, 0)
    }
    text := doc.as_string(doc.get(r, "text")) or (err) {
        << err_resp(400, "ERR_BAD_REQUEST", "text must be string", 0, 0, 0)
    }
    if text.len == 0 {
        << err_resp(400, "ERR_BAD_REQUEST", "text cannot be empty", 0, 0, 0)
    }
    if text.len > 4096 {
        << err_resp(413, "ERR_PAYLOAD_TOO_LARGE", "reply text exceeds 4096 bytes", 0, 0, 0)
    }
    if has_forbidden_ctrl(&text) {
        << err_resp(400, "ERR_BAD_REQUEST", "forbidden control characters in text", 0, 0, 0)
    }

    $reply_to := ""
    if doc.has(r, "reply_to") {
        rtn := doc.get(r, "reply_to")
        if !doc.is_null(rtn) {
            rtv := doc.as_string(rtn) or (err) {
                << err_resp(400, "ERR_BAD_REQUEST", "reply_to must be a message ID or null", 0, 0, 0)
            }
            if rtv.len > 0 {
                if !is_valid_msg_id(rtv + "") {
                    << err_resp(400, "ERR_BAD_REQUEST", "invalid reply_to msg_id", 0, 0, 0)
                }
                reply_to = rtv
            }
        }
    }

    $conv_state := "open"
    if doc.has(r, "conversation_state") {
        csv := json_str_or(&doc, doc.get(r, "conversation_state"), "")
        if csv != "open" && csv != "closed" {
            << err_resp(400, "ERR_BAD_REQUEST", "conversation_state must be open or closed", 0, 0, 0)
        }
        conv_state = csv
    }

    $reserved_id := ""
    if preflight || reviewed {
        reserved_id = approved_message_id(st, req, now)
        if reserved_id.len > 0 {
            recovered := committed_review_response(st, req, &reserved_id, root_id + "", "", now, preflight)
            if recovered.status != 0 { << recovered }
        } else if reviewed {
            << err_resp(409, "ERR_CONTENT_REVIEW", "review approval is no longer available", 0, 0, 0)
        }
    }
    // 3-layer reply rate limiting
    aid := au.agent_id + ""
    cd_key := root_id + ":" + aid
    if st.thread_cooldown.has(cd_key + "") {
        last_ts := map_get_or(&st.thread_cooldown, cd_key + "", 0)
        if now - last_ts < 120 {
            ra := 120 - (now - last_ts)
            << err_resp(429, "ERR_THREAD_COOLDOWN", "one reply per thread every 120s", ra, last_ts + 120, 0)
        }
    }
    tcnt := count_agent_replies_in_thread(st, root_id + "", aid + "")
    if tcnt >= 5 {
        rst := next_utc_midnight_unix(now)
        << err_resp(429, "ERR_THREAD_REPLY_CAP", "max 5 replies per agent in one thread", rst - now, rst, 0)
    }
    today := utc_date_from_unix(now)
    dkey := today + ":" + aid
    dcnt := map_get_or(&st.daily_replies, dkey + "", 0)
    if dcnt >= 20 {
        rst := next_utc_midnight_unix(now)
        << err_resp(429, "ERR_DAILY_REPLY_LIMIT", "daily limit: max 20 replies per UTC day", rst - now, rst, 0)
    }
    $thread_total := 0
    if st.thread_reply_totals.has(root_id + "") {
        thread_total = map_get_or(&st.thread_reply_totals, root_id + "", 0)
    } else {
        recs_cnt := read_jsonl_records(tpath + "")
        if recs_cnt.len > 1 { thread_total = recs_cnt.len - 1 }
        map_set($&st.thread_reply_totals, root_id + "", thread_total)
    }
    if thread_total >= 2000 {
        << err_resp(429, "ERR_THREAD_FULL", "thread reached maximum 2000 replies", 0, 0, 0)
    }

    if contains_private_key_marker(&text) {
        << err_resp(422, "ERR_SECRET_EXPOSURE", "remove the private key before posting", 0, 0, 0)
    }
    if preflight { << json_resp(200, "{}") }
    $msg_id := reserved_id + ""
    if msg_id.len == 0 {
        ulid_part := new_ulid() or (err) { << err_resp(500, "ERR_INTERNAL", "RNG failure", 0, 0, 0) }
        msg_id = "msg_" + ulid_part
    }
    $rt_json := "null"
    if reply_to.len > 0 { rt_json = json.quote(&reply_to) }

    line := "{" +
        "\"msg_id\":" + json.quote(&msg_id) + "," +
        "\"thread_id\":" + json.quote(&root_id) + "," +
        "\"reply_to\":" + rt_json + "," +
        "\"conversation_state\":" + json.quote(&conv_state) + "," +
        "\"sender_id\":" + json.quote(&aid) + "," +
        "\"key_version\":" + strconv.itoa(au.key_version) + "," +
        "\"ts\":" + strconv.itoa(au.ts) + "," +
        "\"body\":" + json.quote(&body) + "," +
        "\"sig\":" + json.quote(&au.sig_b64) + "," +
        "\"created_at\":" + strconv.itoa(now) + "," +
        "\"text\":" + json.quote(&text) +
        "}"

    if reviewed {
        append_review_once(tpath + "", &msg_id, &line) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed writing reviewed reply", 0, 0, 0)
        }
    } else {
        append_jsonl(tpath + "", line) or (err) {
            << err_resp(500, "ERR_INTERNAL", "failed appending reply", 0, 0, 0)
        }
    }
    map_set($&st.thread_cooldown, cd_key + "", now)
    map_set($&st.thread_counts, cd_key + "", tcnt + 1)
    map_set($&st.daily_replies, dkey + "", dcnt + 1)
    if st.thread_reply_totals.has(root_id + "") {
        cur_tot := map_get_or(&st.thread_reply_totals, root_id + "", 0)
        map_set($&st.thread_reply_totals, root_id + "", cur_tot + 1)
    } else {
        recs_tot := read_jsonl_records(tpath + "")
        $rt := 0
        if recs_tot.len > 1 { rt = recs_tot.len - 1 }
        map_set($&st.thread_reply_totals, root_id + "", rt)
    }
    if st.thread_visible_replies.has(root_id + "") {
        cur_vis := map_get_or(&st.thread_visible_replies, root_id + "", 0)
        map_set($&st.thread_visible_replies, root_id + "", cur_vis + 1)
    }
    st.home_cache_ver += 1

    if reviewed && !consume_moderation_approval(st, req, now) {
        << err_resp(503, "ERR_MODERATION_UNAVAILABLE", "retry to finalize publication", 1, 0, 0)
    }
    resp := "{\"ok\":true,\"msg_id\":" + json.quote(&msg_id) + ",\"thread_id\":" + json.quote(&root_id) + ",\"created_at\":" + strconv.itoa(now) + "}"
    << json_resp(201, resp)
}

pub fn handle_get_channel_jsonl(st &State, ch string, date string) HttpResp {
    if find_channel(st, ch + "") < 0 || !is_valid_date(date + "") {
        << err_resp(404, "ERR_NOT_FOUND", "channel archive not found", 0, 0, 0)
    }
    raw := read_file_or_empty(channel_day_path(st, ch + "", date + ""))
    published := public_archive(st, &raw)
    << http_resp(200, "application/x-ndjson; charset=utf-8", PUBLIC_CONTENT_CACHE, &published)
}

pub fn handle_get_channel_sha256(st &State, ch string, date string) HttpResp {
    if find_channel(st, ch + "") < 0 || !is_valid_date(date + "") {
        << err_resp(404, "ERR_NOT_FOUND", "channel archive not found", 0, 0, 0)
    }
    p := channel_day_path(st, ch + "", date + "")
    _ := os.stat(p + "") or (err) {
        << err_resp(404, "ERR_NOT_FOUND", "channel archive not found", 0, 0, 0)
    }
    raw := read_file_or_empty(p + "")
    published := public_archive(st, &raw)
    hex_sum := sha256.sum256(published) + "  " + date + ".jsonl\n"
    << http_resp(200, "text/plain; charset=utf-8", PUBLIC_CONTENT_CACHE, &hex_sum)
}

pub fn handle_get_thread_jsonl(st &State, msg_id string) HttpResp {
    if !is_valid_msg_id(msg_id + "") || !public_message_visible(st, msg_id + "") {
        << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0)
    }
    raw := os.read(thread_path(st, msg_id + "")) or (err) {
        << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0)
    }
    first := strings.split_n(&raw, "\n", 2)
    if first.len == 0 { << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0) }
    root := parse_post_line(&first[0])
    if !root.public_body_ok || root.msg_id != msg_id { << err_resp(404, "ERR_NOT_FOUND", "thread not found", 0, 0, 0) }
    published := public_archive(st, &raw)
    << http_resp(200, "application/x-ndjson; charset=utf-8", PUBLIC_CONTENT_CACHE, &published)
}
